<ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
precision highp int;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
in vec4 x3d_Vertex;
out vec3 vP;
out float depth;
void main() {
  vec4 p = x3d_ModelViewMatrix * x3d_Vertex;
  vP = p.xyz;
  gl_Position = x3d_ProjectionMatrix * p;
  depth = 1.0 + gl_Position.w;
}
]]></ShaderPart>
<ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
precision highp int;
uniform mat4 x3d_ModelViewMatrix;
uniform float x3d_LogarithmicFarFactor1_2;
uniform vec3 sunDir;
uniform float logDepth;
in vec3 vP;
in float depth;
out vec4 x3d_FragColor;
const float TOP = 1.07;
const float MARGIN = 1.02;
const float K = 4.5;
const float DECAY = 6.0;
const float GAIN = 1.0;
const float MIE = 0.05;
void main() {
  vec3 d = normalize(vP);
  float rs = length(x3d_ModelViewMatrix[0].xyz) / MARGIN;
  float rp = rs / TOP;
  vec3 C = x3d_ModelViewMatrix[3].xyz;
  vec3 S = normalize(mat3(x3d_ModelViewMatrix) * sunDir);
  float cc = dot(C, C), b = dot(d, C);
  bool inside = cc < rs * rs;
  if (gl_FrontFacing == inside) discard;
  float disc = b * b - (cc - rs * rs);
  if (disc <= 0.0) discard;
  float sq = sqrt(disc);
  float t0 = max(b - sq, 0.0), t1 = b + sq;
  float dp = b * b - (cc - rp * rp);
  if (dp > 0.0) { float tp = b - sqrt(dp); if (tp > 0.0) t1 = min(t1, tp); }
  if (t1 <= t0) discard;
  float dt = (t1 - t0) / 10.0;
  float cs = dot(d, S);
  float phase = 0.45 * (1.0 + cs * cs) + MIE * 0.64 / pow(1.36 - 1.2 * cs, 1.5);
  vec3 acc = vec3(0.0);
  float od = 0.0;
  for (int i = 0; i < 10; i++) {
    vec3 p = d * (t0 + (float(i) + 0.5) * dt) - C;
    float r = length(p);
    float rho = exp(-DECAY * clamp((r - rp) / (rs - rp), 0.0, 1.0));
    float up = dot(p / r, S);
    vec3 src = mix(vec3(1.0, 0.40, 0.12), vec3(0.40, 0.66, 1.0), smoothstep(-0.05, 0.55, up));
    float w = rho * dt / rp;
    acc += src * (smoothstep(-0.18, 0.22, up) * w * phase);
    od += w;
  }
  float alpha = 1.0 - exp(-K * od);
  x3d_FragColor = vec4(min(acc * (K * GAIN) / max(alpha, 0.02), vec3(1.5)), alpha);
  gl_FragDepth = logDepth > 0.5 ? log2(depth) * x3d_LogarithmicFarFactor1_2 : gl_FragCoord.z;
}
]]></ShaderPart></ComposedShader></Appearance><Sphere solid='false' radius='1'/></Shape></Transform><TimeSensor DEF='CloudClock' cycleInterval='420' loop='true'/><OrientationInterpolator DEF='CloudPath' key='0 0.25 0.5 0.75 1' keyValue='0 1 0 0, 0 1 0 1.570796, 0 1 0 3.141593, 0 1 0 4.712389, 0 1 0 6.283185'/><ROUTE fromNode='CloudClock' fromField='fraction_changed' toNode='CloudPath' toField='set_fraction'/><ROUTE fromNode='CloudPath' fromField='value_changed' toNode='CloudTurn' toField='set_rotation'/><Shape><Appearance alphaMode='BLEND'><Material emissiveColor='1 0.84 0.46' diffuseColor='0 0 0' transparency='0.12'/></Appearance><IndexedLineSet coordIndex='0 1 -1'><Coordinate point='6.85695 -3.313899 2.636885 6.5 -2.6 0.4'/></IndexedLineSet></Shape><Transform translation='6.85695 -3.313899 2.636885' rotation='-0.9875061 0 0.1575808 1.265489'><Billboard axisOfRotation='0 1 0'><Shape><Appearance alphaMode='BLEND'/><IndexedFaceSet solid='false' coordIndex='0 1 2 3 -1'><ColorRGBA color='1 0.86 0.5 0.85 1 0.86 0.5 0.85 1 0.92 0.66 0.10 1 0.92 0.66 0.10'/><Coordinate point='-0.00045 0 0 0.00045 0 0 0.006 2.37502 0 -0.006 2.37502 0'/></IndexedFaceSet></Shape></Billboard></Transform><Transform DEF='Climber0' translation='6.85695 -3.313899 2.636885'><Shape><Appearance alphaMode='BLEND'><Material diffuseColor='0 0 0' emissiveColor='1 0.8 0.42'/><ComposedShader USE='PointShader'/></Appearance><PointSet><ColorRGBA color='1 0.9 0.62 0.9000'/><Coordinate point='0 0 0'/></PointSet></Shape></Transform><TimeSensor DEF='ClimbClock0' cycleInterval='46' loop='true'/><PositionInterpolator DEF='ClimbPath0' key='0 1' keyValue='6.85695 -3.313899 2.636885, 6.5 -2.6 0.4'/><ROUTE fromNode='ClimbClock0' fromField='fraction_changed' toNode='ClimbPath0' toField='set_fraction'/><ROUTE fromNode='ClimbPath0' fromField='value_changed' toNode='Climber0' toField='set_translation'/><Transform DEF='Climber1' translation='6.746295 -3.092591 1.943451'><Shape><Appearance alphaMode='BLEND'><Material diffu