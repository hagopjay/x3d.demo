/><field name='S' type='SFVec3f' accessType='initializeOnly' value='16 1 0.65'/><field name='X' type='MFFloat' accessType='initializeOnly' value='0.15006 0.18180 0.20670 0.22889 0.27111 0.29330 0.31820 0.34994 0.65006 0.68180 0.70670 0.72889 0.77111 0.79330 0.81820 0.84994'/><field name='H' type='MFFloat' accessType='initializeOnly' value='0.01428 0.01074 0.00998 0.00998 0.00998 0.00792 0.00318 0.00485 0.01428 0.01074 0.00998 0.00998 0.00998 0.00792 0.00318 0.00485'/><field name='col' type='SFColor' accessType='initializeOnly' value='1 0.8 0.4'/><ShaderPart DEF='WeaveVS' type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
uniform vec3 w;
uniform vec4 P;
uniform vec4 Q;
uniform vec3 S;
uniform float X[32];
uniform float H[32];
in vec4 x3d_Vertex;
out float vu;
out float vs;
out float vl;
out vec3 vP;
vec2 crv(float t) {
  float th = 6.2831853 * t, r = P.x + P.y * cos(Q.x * th);
  float ph = th + P.z * sin(Q.x * th) + P.w * (r - P.x) / P.y + Q.y * 6.2831853 / (4.0 * Q.x);
  return r * vec2(cos(ph), sin(ph));
}
float tp(float u) { return u - S.z * sin(6.2831853 * Q.x * u) / (6.2831853 * Q.x); }
float lift(float t) {
  int n = int(S.x);
  float t0 = X[n - 1] - 1.0, h0 = H[n - 1], t1 = X[0], h1 = H[0], s = S.y * (n % 2 == 0 ? -1.0 : 1.0);
  for (int j = 0; j < 32; j++) {
    if (j >= n || X[j] > t) break;
    t0 = X[j]; h0 = H[j]; t1 = j + 1 < n ? X[j + 1] : X[0] + 1.0; h1 = j + 1 < n ? H[j + 1] : H[0]; s = S.y * (j % 2 == 0 ? 1.0 : -1.0);
  }
  return s * (1.0 - 2.0 * smoothstep(t0 + h0, t1 - h1, t));
}
void main() {
  float u = x3d_Vertex.x / 600.0, t = tp(u);
  vu = u; vs = x3d_Vertex.y; vl = lift(t) * Q.z;
  vec2 c = crv(t), d = normalize(crv(t + 0.0004) - crv(t - 0.0004));
  vec4 p = x3d_ModelViewMatrix * vec4(c + vec2(-d.y, d.x) * 0.06 * vs, 0.0, 1.0);
  vP = p.xyz;
  p.xyz += normalize(-p.xyz) * vl * 0.05;
  gl_Position = abs(w.x - Q.w) < 0.5 ? x3d_ProjectionMatrix * p : vec4(2.0, 2.0, 2.0, 1.0);
}
]]></ShaderPart><ShaderPart DEF='WeaveFS' type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
uniform vec3 w;
uniform vec3 col;
in float vu;
in float vs;
in float vl;
in vec3 vP;
out vec4 x3d_FragColor;
void main() {
  if (vu > w.y) discard;
  if (fract(sin(dot(floor(gl_FragCoord.xy), vec2(12.9898, 78.233))) * 43758.5453) > w.z) discard;
  vec3 n = normalize(cross(dFdx(vP), dFdy(vP)));
  float k = 0.62 + 0.5 * max(0.0, dot(n, normalize(vec3(-0.4, 0.7, 0.6))));
  k *= vs < 0.0 ? 1.08 : 0.74;
  k *= 0.82 + 0.22 * vl;
  vec3 c = mix(col * k, vec3(0.06, 0.03, 0.01), smoothstep(0.62, 0.92, abs(vs)));
  float hot = exp(-(w.y - vu) * 55.0) * step(w.y, 0.9999);
  c = mix(c, vec3(1.0, 0.86, 0.62) * 1.25, 0.85 * hot);
  x3d_FragColor = vec4(min(c, vec3(1.0)), 1.0);
}
]]></ShaderPart></ComposedShader></Appearance><TriangleStripSet DEF='WeaveStrip' solid='false' stripCount='1202'><Coordinate point='0 -1 0 0 1 0 1 -1 0 1 1 0 2 -1 0 2 1 0 3 -1 0 3 1 0 4 -1 0 4 1 0 5 -1 0 5 1 0 6 -1 0 6 1 0 7 -1 0 7 1 0 8 -1 0 8 1 0 9 -1 0 9 1 0 10 -1 0 10 1 0 11 -1 0 11 1 0 12 -1 0 12 1 0 13 -1 0 13 1 0 14 -1 0 14 1 0 15 -1 0 15 1 0 16 -1 0 16 1 0 17 -1 0 17 1 0 18 -1 0 18 1 0 19 -1 0 19 1 0 20 -1 0 20 1 0 21 -1 0 21 1 0 22 -1 0 22 1 0 23 -1 0 23 1 0 24 -1 0 24 1 0 25 -1 0 25 1 0 26 -1 0 26 1 0 27 -1 0 27 1 0 28 -1 0 28 1 0 29 -1 0 29 1 0 30 -1 0 30 1 0 31 -1 0 31 1 0 32 -1 0 32 1 0 33 -1 0 33 1 0 34 -1 0 34 1 0 35 -1 0 35 1 0 36 -1 0 36 1 0 37 -1 0 37 1 0 38 -1 0 38 1 0 39 -1 0 39 1 0 40 -1 0 40 1 0 41 -1 0 41 1 0 42 -1 0 42 1 0 43 -1 0 43 1 0 44 -1 0 44 1 0 45 -1 0 45 1 0 46 -1 0 46 1 0 47 -1 0 47 1 0 48 -1 0 48 1 0 49 -1 0 49 1 0 50 -1 0 50 1 0 51 -1 0 51 1 0 52 -1 0 52 1 0 53 -1 0 53 1 0 54 -1 0 54 1 0 55 -1 0 55 1 0 56 -1 0 56 1 0 57 -1 0 57 1 0 58 -1 0 58 1 0 59 -1 0 59 1 0 60 -1 0 60 1 0 61 -1 0 61 1 0 62 -1 0 62 1 0 63 -1 0 63 1 0 64 -1 0 64 1 0 65 -1 0 65 1 0 66 -1 0 66 1 0 67 -1 0 67 1 0 68 -1 0 68 1 0 69 -1 0 69 1 0 70 -1 0 70 1 0 71 -1 0 71 1 0 72 -1 0 72 1 0 73 -1 0 73 1 0 74 -1 0 74 1 0 75 -1 0 75 1 0 76 -1 0 76 1 0 77 -1 0 77 1 0 78 -1 0 78 1 0 79 -1 0 79 1 0 80 -1 0 80 1 0 81 -1 0 81 1 0 82 -1 0 82 1 0 83 -1 0 83 1 0 84 -1 0 84 1 0 85 -1 0 85 1 0 86 -1 0 86 1 0 87 -1 0 87 1 0 88 -1 0 88 1 0 89 -1 0 89 1 0 90 -1 0 90 1 0 91 -1 0 91 1 0 92 -1 0 92 1 0 93 -1 0 93 1 0 94 -1 0 94 1 0 95 -1 0 95 1 0 96 -1 0 96 1 0 97 -1 0 97 1 0 98 -1 0 98 1 0 99 -1 0 99 1 0 100 -1 0 100 1 0 101 -1 0 101 1 0 102 -1 0 102 1 0 103 -1 0 103 1 0 104 -1 0 104 1 0 105 -1 0 105 1 0 106 -1 0 106 1 0 107 -1 0 107 1 0 108 -1 0 108 1 0 109 -1 0 109 1 0 110 -1 0 110 1 0 111 -1 0 111 1 0 112 -1 0 112 1 0 113 -1 0 113 1 0 114 -1 0 114 1 0 115 -1 0 115 1 0 116 -1 0 116 1 0 117 -1 0 117 1 0 118 -1 0 118 1 0 119 -1 0 119 1 0 120 -1 0 120 1 0 121 -1 0 121 1 0 122 -1 0 122 1