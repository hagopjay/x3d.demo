    <!-- Gobbler demiurge layers (tools/layers.py, seed 4): Sun in the chest, Dyson ribcage, flywheel, tenders, wing, tail fan with the Blender root. Added; nothing above is edited. -->
    <Transform DEF='Loom' center='0.72 -0.76 0'><Transform DEF='Heart' translation='6.5 -2.6 0.4'><Transform DEF='HeartPulse'><Shape><Appearance><Material diffuseColor='0 0 0' emissiveColor='1 0.9 0.6'/><ComposedShader DEF='SunShader' language='GLSL'><field name='time' type='SFTime' accessType='inputOutput' value='0'/>
<ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
precision highp int;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
uniform mat3 x3d_NormalMatrix;
in vec4 x3d_Vertex;
in vec3 x3d_Normal;
out vec3 vN;
out vec3 vP;
void main() {
  vN = normalize(x3d_NormalMatrix * x3d_Normal);
  vP = x3d_Vertex.xyz;
  gl_Position = x3d_ProjectionMatrix * x3d_ModelViewMatrix * x3d_Vertex;
}
]]></ShaderPart>
<ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
precision highp int;
uniform float time;
in vec3 vN;
in vec3 vP;
out vec4 x3d_FragColor;
float h1(vec3 p) { p = fract(p * 0.3183099 + 0.1); p *= 17.0; return fract(p.x * p.y * p.z * (p.x + p.y + p.z)); }
float vnoise(vec3 x) {
  vec3 i = floor(x), f = fract(x); f = f * f * (3.0 - 2.0 * f);
  return mix(mix(mix(h1(i), h1(i + vec3(1, 0, 0)), f.x), mix(h1(i + vec3(0, 1, 0)), h1(i + vec3(1, 1, 0)), f.x), f.y),
             mix(mix(h1(i + vec3(0, 0, 1)), h1(i + vec3(1, 0, 1)), f.x), mix(h1(i + vec3(0, 1, 1)), h1(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}
void main() {
  float mu = clamp(normalize(vN).z, 0.0, 1.0);
  float g = vnoise(vP * 26.0 + vec3(0.0, time * 0.10, 0.0)) * 0.6 + vnoise(vP * 64.0 - vec3(time * 0.17, 0.0, 0.0)) * 0.4;
  vec3 c = mix(vec3(1.0, 0.55, 0.12), vec3(1.0, 0.97, 0.82), pow(mu, 0.5)) * (0.8 + 0.5 * g);
  c += vec3(1.0, 0.45, 0.08) * pow(1.0 - mu, 3.0) * 0.6;
  x3d_FragColor = vec4(c, 1.0);
}
]]></ShaderPart></ComposedShader></Appearance><Sphere radius='0.36'/></Shape><Transform translation='0 0 0' scale='2.1 2.1 2.1'><Billboard axisOfRotation='0 0 0'><Shape><Appearance alphaMode='BLEND'><ComposedShader DEF='GlowShader' language='GLSL'>
<ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
precision highp int;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
in vec4 x3d_Vertex;
in vec4 x3d_Color;
out vec2 vUV;
out vec3 vCol;
void main() {
  vUV = x3d_Vertex.xy;
  vCol = x3d_Color.rgb;
  gl_Position = x3d_ProjectionMatrix * x3d_ModelViewMatrix * x3d_Vertex;
}
]]></ShaderPart>
<ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
precision highp int;
in vec2 vUV;
in vec3 vCol;
out vec4 x3d_FragColor;
void main() {
  float r = length(vUV);
  if (r >= 1.0) discard;
  float a = pow(1.0 - r, 2.6) * 0.85 + exp(-r * r * 22.0) * 0.5;
  x3d_FragColor = vec4(vCol * (0.9 + 0.8 * exp(-r * r * 14.0)), clamp(a, 0.0, 1.0));
}
