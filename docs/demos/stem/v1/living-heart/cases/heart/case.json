{
  "schema": "loom.scientific-case/1",
  "id": "tissue/heart",
  "kind": "tissue",
  "name": "heart",
  "title": "Scroll wave in a ventricle",
  "line": "The same spiral wrapped onto a ventricle's wall, where it becomes a scroll wave: the electrical engine of ventricular tachycardia.",
  "equation": "u_t = D lap(u) - k u (u - a)(u - 1) - u v;  v_t = (eps0 + mu1 v / (u + mu2)) (-v - k u (u - a - 1))",
  "domain": {
    "shape": [
      58,
      58,
      67
    ],
    "units": "dimensionless (about 1 mm and 12.9 ms per unit)",
    "boundary": "no flux"
  },
