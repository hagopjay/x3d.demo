{
  "schema": "loom.scientific-case/1",
  "id": "tissue/paced",
  "kind": "tissue",
  "name": "paced",
  "title": "Paced tissue",
  "line": "A strip of heart muscle paced from the left edge: each beat a wave of voltage that sweeps across and recovers behind.",
  "equation": "u_t = D lap(u) - k u (u - a)(u - 1) - u v;  v_t = (eps0 + mu1 v / (u + mu2)) (-v - k u (u - a - 1))",
  "domain": {
    "shape": [
      100,
      60
    ],
    "units": "dimensionless (about 1 mm and 12.9 ms per unit)",
    "boundary": "no flux"
  },
  "parameters": {
    "k": 8.0,
    "a": 0.15,
    "eps0": 0.002,
    "mu1": 0.2,
    "mu2": 0.3,
    "D": 1.0,
    "h": 0.5,
    "dt": 0.01,
    "display_h": 1.0,
    "frames": 36,
    "ms_per_unit": 12.9,
    "conduction_speed": 1.3091754224929166,
    "first_beat_speed": 1.365037268153252,
    "cable_speed": 1.3650601423158781,
    "pacing_period": 60.0,
    "beats": 10,
    "domain_units": [
      100,
      60
    ]
  },
  "method": "Aliev-Panfilov, forward Euler, 5-point (2D) or masked 7-point (3D) Laplacian with no-flux walls; states published every 1/36 of a period on every other cell.",
  "limits": [
    "A two-variable phenomenological model: no ion channels, calcium or drugs; times and lengths in physical units are nominal (12.9 ms and about 1 mm per unit).",
    "Isotropic, homogeneous tissue: real ventricles have rotating fibre directions, which make conduction anisotropic and shape scroll waves.",
    "The ventricle is two truncated ellipsoids, not an anatomical heart; it is not coupled to mechanics or blood flow.",
    "Frames are shown on every other cell (1 unit) of the computed grid (0.5 units)."
  ],
