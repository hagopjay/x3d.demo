<Transform translation="-6.6 -3.37 0.01"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0.580 0.639 0.722"/></Appearance><Text string="&quot;Once a claim is approved, a replacement&quot; &quot;battery ships within 7 to 10 business&quot; &quot;days. Customers in remote postcodes&quot; &quot;should allow 3 additional business days.&quot;"><FontStyle family='"SANS"' style="PLAIN" size="0.100" spacing="1.25" justify='"BEGIN" "FIRST"'/></Text></Shape></Transform>
