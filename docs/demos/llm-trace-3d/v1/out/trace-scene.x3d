<Transform translation="-9.15 -3.37 0.01"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0.580 0.639 0.722"/></Appearance><Text string="&quot;Halden e-bike batteries are covered for&quot; &quot;24 months from the date of delivery. A&quot; &quot;battery that holds less than 70 percent&quot; &quot;of its rated capacity within the&quot; &quot;warranty period is replaced free of&quot;"><FontStyle family='"SANS"' style="PLAIN" size="0.100" spacing="1.25" justify='"BEGIN" "FIRST"'/></Text></Shape></Transform>
