      <Transform translation='2.4 0 0'><Shape><Appearance><Material diffuseColor='0.8645 0.02134 0.6142' specularColor='0.5 0.5 0.5' shininess='0.4'/></Appearance><Sphere USE='Ball'/></Shape></Transform>
      <Transform translation='2.4 0 1.2'><Shape><Appearance><Material diffuseColor='0.9382 0.07232 0.4895' specularColor='0.5 0.5 0.5' shininess='0.4'/></Appearance><Sphere USE='Ball'/></Shape></Transform>
      <Transform translation='2.4 0 2.4'><Shape><Appearance><Material diffuseColor='0.9843 0.1502 0.3655' specularColor='0.5 0.5 0.5' shininess='0.4'/></Appearance><Sphere USE='Ball'/></Shape></Transform>
    </Group>
    <!-- whichChoice='2' shows only the cone; try 0, 1 or -1 and save (the viewer hot-reloads) -->
    <Transform translation='0 1.4 0'>
      <Switch whichChoice='2'>
        <Shape><Appearance><Material diffuseColor='1 0 0'/></Appearance><Box size='0.6 0.6 0.6'/></Shape>
        <Shape><Appearance><Material diffuseColor='0 1 0'/></Appearance><Sphere radius='0.4'/></Shape>
        <Shape><Appearance><Material diffuseColor='1 1 1' specularColor='1 1 1' shininess='0.8'/></Appearance><Cone bottomRadius='0.4' height='0.8'/></Shape>
      </Switch>
    </Transform>
    <!-- Transparent things are drawn last, sorted back to front -->
    <Transform translation='0 0.3 2.6'>
      <Shape>
        <Appearance><Material diffuseColor='0.6 0.85 1' transparency='0.6' specularColor='1 1 1' shininess='0.9'/></Appearance>
        <Box size='6 1.4 0.1'/>
      </Shape>
    </Transform>
