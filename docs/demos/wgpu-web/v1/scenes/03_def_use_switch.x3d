      <Transform translation='1.2 0 -2.4'><Shape><Appearance><Material diffuseColor='0.09549 0.4477 0.9568' specularColor='0.5 0.5 0.5' shininess='0.4'/></Appearance><Sphere USE='Ball'/></Shape></Transform>
      <Transform translation='1.2 0 -1.2'><Shape><Appearance><Material diffuseColor='0.1813 0.3257 0.993' specularColor='0.5 0.5 0.5' shininess='0.4'/></Appearance><Sphere USE='Ball'/></Shape></Transform>
      <Transform translation='1.2 0 0'><Shape><Appearance><Material diffuseColor='0.2871 0.2146 0.9982' specularColor='0.5 0.5 0.5' shininess='0.4'/></Appearance><Sphere USE='Ball'/></Shape></Transform>
      <Transform translation='1.2 0 1.2'><Shape><Appearance><Material diffuseColor='0.4063 0.1215 0.9722' specularColor='0.5 0.5 0.5' shininess='0.4'/></Appearance><Sphere USE='Ball'/></Shape></Transform>
      <Transform translation='1.2 0 2.4'><Shape><Appearance><Material diffuseColor='0.5314 0.05214 0.9165' specularColor='0.5 0.5 0.5' shininess='0.4'/></Appearance><Sphere USE='Ball'/></Shape></Transform>
