<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 4.0//EN" "https://www.web3d.org/specifications/x3d-4.0.dtd">
<X3D profile='Interchange' version='4.0'>
  <head>
    <component name='Grouping' level='2'/>
    <meta name='title' content='DEF/USE, Switch, transparency'/>
    <meta name='description' content='25 spheres share one mesh; a Switch picks one child; a glass slab is transparent.'/>
    <meta name='generator' content='x3d.wgpu sample scenes'/>
  </head>
  <Scene>

    <Viewpoint description='Grid' position='0 5 8' orientation='1 0 0 -0.55'/>
    <Background skyColor='0.08 0.08 0.1'/>
    <DirectionalLight direction='-0.3 -1 -0.4' intensity='0.8' ambientIntensity='0.3'/>
    <!-- One Sphere is DEF'd; the other 24 USE it. The renderer uploads one mesh. -->
    <Group DEF='Grid'>
      <Transform translation='-2.4 0 -2.4'><Shape><Appearance><Material diffuseColor='1 0.25 0.25' specularColor='0.5 0.5 0.5' shininess='0.4'/></Appearance><Sphere DEF='Ball' radius='0.4'/></Shape></Transform>
