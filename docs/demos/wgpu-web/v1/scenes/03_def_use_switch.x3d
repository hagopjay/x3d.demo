      <Transform translation='-1.2 0 0'><Shape><Appearance><Material diffuseColor='0.4063 0.9722 0.1215' specularColor='0.5 0.5 0.5' shininess='0.4'/></Appearance><Sphere USE='Ball'/></Shape></Transform>
      <Transform translation='-1.2 0 1.2'><Shape><Appearance><Material diffuseColor='0.2871 0.9982 0.2146' specularColor='0.5 0.5 0.5' shininess='0.4'/></Appearance><Sphere USE='Ball'/></Shape></Transform>
      <Transform translation='-1.2 0 2.4'><Shape><Appearance><Material diffuseColor='0.1813 0.993 0.3257' specularColor='0.5 0.5 0.5' shininess='0.4'/></Appearance><Sphere USE='Ball'/></Shape></Transform>
      <Transform translation='0 0 -2.4'><Shape><Appearance><Material diffuseColor='0.09549 0.9568 0.4477' specularColor='0.5 0.5 0.5' shininess='0.4'/></Appearance><Sphere USE='Ball'/></Shape></Transform>
      <Transform translation='0 0 -1.2'><Shape><Appearance><Material diffuseColor='0.03511 0.8918 0.573' specularColor='0.5 0.5 0.5' shininess='0.4'/></Appearance><Sphere USE='Ball'/></Shape></Transform>
      <Transform translation='0 0 0'><Shape><Appearance><Material diffuseColor='0.003943 0.8023 0.6938' specularColor='0.5 0.5 0.5' shininess='0.4'/></Appearance><Sphere USE='Ball'/></Shape></Transform>
      <Transform translation='0 0 1.2'><Shape><Appearance><Material diffuseColor='0.003943 0.6938 0.8023' specularColor='0.5 0.5 0.5' shininess='0.4'/></Appearance><Sphere USE='Ball'/></Shape></Transform>
