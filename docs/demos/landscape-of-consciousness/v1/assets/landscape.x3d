<Script DEF='Tesseract' directOutput='false' mustEvaluate='false'><field accessType='inputOnly' name='set_fraction' type='SFFloat'/><field accessType='outputOnly' name='points' type='MFVec3f'/><![CDATA[ecmascript:
var V = [];
function initialize () { for (var i = 0; i < 16; i++) V.push([i & 1 ? 1 : -1, i & 2 ? 1 : -1, i & 4 ? 1 : -1, i & 8 ? 1 : -1]); }
function set_fraction (f, t) {
  var a = f * 2 * Math.PI, b = f * 4 * Math.PI, c = f * 2 * Math.PI, out = new MFVec3f();
  for (var i = 0; i < 16; i++) {
    var x = V[i][0], y = V[i][1], z = V[i][2], w = V[i][3];
    var x1 = x * Math.cos(a) - w * Math.sin(a), w1 = x * Math.sin(a) + w * Math.cos(a);
    var y1 = y * Math.cos(b) - z * Math.sin(b), z1 = y * Math.sin(b) + z * Math.cos(b);
    var z2 = z1 * Math.cos(c) - w1 * Math.sin(c), w2 = z1 * Math.sin(c) + w1 * Math.cos(c);
    var q = 3.0 / (3.0 - w2) * 1.9;
    out [i] = new SFVec3f(x1 * q, y1 * q, z2 * q);
  }
  points = out;
}
]]></Script>
