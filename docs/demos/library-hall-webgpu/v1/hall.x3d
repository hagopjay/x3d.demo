 <meta name="title" content="The Library of PolyXandria · the Hall"/>
 <meta name="description" content="Every X3D scene the project holds is a pane of glass in an octagonal hall; a pane is lit only by proof (valid on both validators), and the real suns of Blacksburg and Doha on 16 October 2026 cross it."/>
 <meta name="creator" content="x3d.io"/>
 <meta name="generator" content="polyxandria/library/src/build_hall_v1.py"/>
 <meta name="created" content="16 October 2026"/>
 <meta name="reference" content="Sun: astropy 8.0.2 (ERFA builtin ephemeris) at the Earth twin's sites. Verdicts: fork 688174f, upstream 74da0ec. Pane renders: X_ITE 16.5.0."/>
 <meta name="license" content="Panes show licence-clean scenes only; the rest are frosted."/>
