+        body = '<Transform DEF="SourceBody" translation="0 3 0">' + core
+        for i, rot in enumerate(('1 0 0 .6', '0 0 1 .9', '1 0 1 1.4')):
+            body += '<Transform rotation="' + rot + '">' + _torus_xml(1.6 + i * .25, .045) + '</Transform>'
+        body += '</Transform>'
+        body += ('<Transform DEF="LeftParent" translation="-3.7 1.4 0"><Transform DEF="SharedModule">' + module +
+                 '</Transform></Transform><Transform DEF="RightParent" translation="3.7 1.4 0" rotation="0 1 0 .7">'
+                 '<Transform USE="SharedModule"/></Transform>')
+        for i in range(16):
+            a = TAU * i / 16
+            body += (f'<Transform translation="{5.3 * math.cos(a):.5f} .6 {5.3 * math.sin(a):.5f}">'
+                     '<Shape><Appearance><PhysicalMaterial baseColor=".25 .35 .43" metallic=".8" roughness=".3"/>'
+                     '</Appearance><Cylinder radius=".09" height="1.2"/></Shape></Transform>')
+        body += ('<TimeSensor DEF="Clock" cycleInterval="3" loop="true"/>'
+                 '<OrientationInterpolator DEF="Spin" key="0 .25 .5 .75 1" '
+                 'keyValue="0 1 0 0 0 1 0 1.5707963 0 1 0 3.1415927 0 1 0 4.712389 0 1 0 6.2831853"/>'
+                 '<PositionInterpolator DEF="Lift" key="0 .5 1" keyValue="0 0 0 0 1 0 0 0 0"/>'
+                 '<ROUTE fromNode="Clock" fromField="fraction_changed" toNode="Spin" toField="set_fraction"/>'
+                 '<ROUTE fromNode="Spin" fromField="value_changed" toNode="SourceBody" toField="set_rotation"/>'
+                 '<ROUTE fromNode="Clock" fromField="fraction_changed" toNode="Lift" toField="set_fraction"/>'
+                 '<ROUTE fromNode="Lift" fromField="value_changed" toNode="SharedModule" toField="set_translation"/>')
