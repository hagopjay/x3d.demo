+++ b/demo/hub_observatory/make_reel.py
@@ -0,0 +1,159 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Encode captured X_ITE frames with an original deterministic synthetic score."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+import os
+import shutil
+import wave
+
+import numpy as np
+
+
+# Optical flow must not deform the static, small header lettering.
+HEADER_FILTER = ("drawbox=x=0:y=0:w=iw:h=67:color=0x050c10:t=fill,"
+                 "drawtext=font=Arial:text='N E X U S':x=40:y=34:fontsize=12:fontcolor=0xF2EEE5,"
+                 "drawtext=font=Arial:text='X3D RENDER CAPTURE / SOFTWARE PREVIEW':"
+                 "x=w-tw-40:y=36:fontsize=8:fontcolor=0xADBCC3")
+
+
+def score(path: Path, duration: float, chapters: int, rate: int = 48000) -> None:
+    """Quiet original D-minor ambient bed; no recordings or licensed music."""
+    count = int(duration * rate)
+    t = np.arange(count, dtype=np.float64) / rate
+    left = np.zeros(count)
+    right = np.zeros(count)
+    frequencies = (73.41619198, 110.0, 146.83238396, 174.61411572, 220.0)
+    for i, frequency in enumerate(frequencies):
+        amplitude = 0.032 / (1 + i * 0.35)
+        envelope = 0.72 + 0.28 * np.sin(2 * np.pi * (0.037 + i * 0.009) * t + i)
+        tone = amplitude * envelope * (np.sin(2 * np.pi * frequency * t + 0.05 * np.sin(2 * np.pi * 0.12 * t))
+                                      + 0.18 * np.sin(2 * np.pi * frequency * 2 * t))
+        pan = 0.35 * np.sin(2 * np.pi * 0.04 * t + i)
+        left += tone * (1 - pan)
+        right += tone * (1 + pan)
+    for i in range(chapters):
+        start = duration * i / chapters
+        age = t - start
+        active = age >= 0
+        age = np.maximum(age, 0)
+        envelope = active * (1 - np.exp(-age * 35)) * np.exp(-age * 1.5)
+        frequency = (293.6647679, 349.2282314, 440.0, 523.2511306)[i % 4]
+        bell = 0.045 * envelope * (np.sin(2 * np.pi * frequency * age)
+                                  + 0.20 * np.sin(2 * np.pi * frequency * 2.002 * age))
+        left += bell * (0.8 if i % 2 else 1)
+        right += bell * (1 if i % 2 else 0.8)
+    fade = np.minimum(1, t / 1.8) * np.minimum(1, np.maximum(duration - t, 0) / 2.4)
+    audio = np.column_stack((left * fade, right * fade))
+    peak = float(np.max(np.abs(audio))) if count else 0
+    if peak > 0.32:
+        audio *= 0.32 / peak
+    pcm = np.round(np.clip(audio, -1, 1) * 32767).astype('<i2')
+    with wave.open(str(path), 'wb') as output:
+        output.setnchannels(2)
+        output.setsampwidth(2)
+        output.setframerate(rate)
+        output.writeframes(pcm.tobytes())
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--frames', type=Path, default=Path(__file__).parent / 'capture_frames')
+    parser.add_argument('--out', type=Path, default=Path(__file__).parent / 'web' / 'assets' / 'nexus-reel.mp4')
+    parser.add_argument('--fps', type=float, default=8)
+    parser.add_argument('--ffmpeg', default='ffmpeg')
+    parser.add_argument('--interpolate', action='store_true', help='Motion-interpolate each chapter separately to 24 fps')
+    options = parser.parse_args()
+    receipt = json.loads((options.frames / 'capture_receipt.json').read_text())
+    if not receipt.get('complete') or not receipt.get('total_frames'):
+        raise SystemExit('Capture receipt is incomplete; refusing to encode a partial proof')
+    expected = int(receipt['total_frames'])
+    for index in range(expected):
+        if not (options.frames / f'frame{index:06d}.png').is_file():
+            raise SystemExit(f'Missing frame {index}')
+    # Older capture receipts did not hash at load time. Recover an honest hash
+    # only when the final source's mtime proves it predates that chapter's first
+    # frame. Never present a changed source as the bytes that were captured.
+    manifest_path = Path(receipt['manifest'])
+    web_root = Path(receipt.get('web_root', manifest_path.parent.parent))
+    for chapter in receipt['chapters']:
+        source = web_root / chapter['source']
+        with source.open('rb') as stream:
+            digest = hashlib.file_digest(stream, 'sha256').hexdigest()
+        if chapter.get('source_sha256'):
+            if chapter['source_sha256'] != digest:
+                raise SystemExit(f"Source changed after capture: {chapter['id']}")
+        else:
+            first_frame = options.frames / f"frame{chapter['first_frame']:06d}.png"
+            if source.stat().st_mtime_ns > first_frame.stat().st_mtime_ns:
+                raise SystemExit(f"Cannot verify unchanged captured source: {chapter['id']}")
+            chapter['source_sha256'] = digest
+            chapter['source_hash_provenance'] = 'post-capture hash; unchanged source mtime predates first frame'
+    (options.frames / 'capture_receipt.json').write_text(json.dumps(receipt, indent=2) + '\n')
+    if options.fps <= 0:
+        raise SystemExit('--fps must be positive')
+    options.out.parent.mkdir(parents=True, exist_ok=True)
+    duration = expected / options.fps
+    soundtrack = options.out.with_suffix('.soundtrack.wav')
+    score(soundtrack, duration, len(receipt['chapters']))
+    fade_at = max(0, duration - 0.8)
+    command = [options.ffmpeg, '-hide_banner', '-loglevel', 'warning', '-y',
+               '-framerate', str(options.fps), '-i', str(options.frames / 'frame%06d.png'),
+               '-i', str(soundtrack), '-vf',
+               f'fade=t=in:st=0:d=0.5,fade=t=out:st={fade_at:.3f}:d=0.8',
+               '-c:v', 'libx264', '-preset', 'medium', '-crf', '19', '-r', '24',
+               '-t', f'{duration:.6f}',
+               '-pix_fmt', 'yuv420p', '-c:a', 'aac', '-b:a', '160k', '-shortest',
+               '-movflags', '+faststart', '-metadata', 'title=NEXUS — X3D Hub Observatory',
+               '-metadata', 'comment=Offline X_ITE frames; deterministic camera/interpolator sampling; original synthesized score',
+               str(options.out)]
+    if options.interpolate:
+        with tempfile.TemporaryDirectory(prefix='nexus-encode-') as temporary:
+            temporary = Path(temporary)
+            parts = []
+            for number, chapter in enumerate(receipt['chapters']):
+                sequence = temporary / f'sequence{number:03d}'
+                sequence.mkdir()
+                for offset in range(chapter['frames']):
+                    source = options.frames / f"frame{chapter['first_frame'] + offset:06d}.png"
+                    target = sequence / f'frame{offset:06d}.png'
+                    try:
+                        os.link(source, target)
+                    except OSError:
+                        shutil.copy2(source, target)
+                part = temporary / f'part{number:03d}.mp4'
+                part_duration = chapter['frames'] / options.fps
+                filters = ('tpad=stop_mode=clone:stop_duration=1,'
+                           'minterpolate=fps=24:mi_mode=mci:mc_mode=aobmc:me_mode=bidir:vsbmc=1')
+                subprocess.run([options.ffmpeg, '-hide_banner', '-loglevel', 'warning', '-y',
+                                '-framerate', str(options.fps), '-i', str(sequence / 'frame%06d.png'),
+                                '-vf', filters, '-t', f'{part_duration:.6f}', '-c:v', 'libx264',
+                                '-preset', 'medium', '-crf', '19', '-pix_fmt', 'yuv420p', str(part)], check=True)
+                parts.append(part)
+            playlist = temporary / 'parts.txt'
+            playlist.write_text(''.join(f"file '{part.as_posix()}'\n" for part in parts))
+            subprocess.run([options.ffmpeg, '-hide_banner', '-loglevel', 'warning', '-y', '-f', 'concat',
+                            '-safe', '0', '-i', str(playlist), '-i', str(soundtrack), '-t', f'{duration:.6f}',
+                            '-vf', HEADER_FILTER, '-c:v', 'libx264', '-preset', 'medium', '-crf', '19',
+                            '-pix_fmt', 'yuv420p', '-c:a', 'aac', '-b:a', '160k', '-movflags', '+faststart',
+                            '-metadata', 'title=NEXUS — X3D Hub Observatory', str(options.out)], check=True)
+    else:
+        subprocess.run(command, check=True)
+    report = {'schema': 'nexus.reel.v1', 'video': options.out.name, 'duration_seconds': duration,
+              'source_frames': expected, 'sample_fps': options.fps, 'encoded_fps': 24,
+              'source': 'real X_ITE rendering, offline sampled camera and authored interpolators',
+              'audio': 'original deterministic synthesized stereo score',
+              'interpolation': 'motion compensated per chapter; no interpolation across cuts' if options.interpolate else 'frame repetition',
+              'header_redrawn_after_interpolation': options.interpolate,
+              'bytes': options.out.stat().st_size, 'capture': receipt}
+    options.out.with_suffix('.receipt.json').write_text(json.dumps(report, indent=2) + '\n')
+    print(json.dumps({key: value for key, value in report.items() if key != 'capture'}, indent=2))
+
+
+if __name__ == '__main__':
+    main()
