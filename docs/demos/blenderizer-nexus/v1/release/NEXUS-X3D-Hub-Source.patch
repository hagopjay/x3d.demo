+      errors = [];
+      try {
+        if (!chapter.x3d) throw Error('Chapter has no X3D path');
+        const file = path.resolve(web, chapter.x3d);
+        if (!file.startsWith(web + path.sep)) throw Error('Chapter path lies outside web root');
+        const sourceBytes = fs.readFileSync(file);
+        const xml = sourceBytes.toString('utf8');
+        record.source_sha256=crypto.createHash('sha256').update(sourceBytes).digest('hex');
+        record.source_hash_provenance='captured source bytes';
+        const viewTag = xml.match(/<Viewpoint\b[^>]*>/)?.[0];
+        const viewpoint = viewTag?.match(/\bDEF\s*=\s*["']([^"']+)["']/)?.[1];
