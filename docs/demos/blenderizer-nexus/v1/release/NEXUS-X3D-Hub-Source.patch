+    """Independent X3D source: no exporter is involved in constructing this file."""
+    target = (0, 2.2, 0)
+    cameras_xml = ''.join(f'<Viewpoint DEF="Camera{i}" description="{name}" position="{pos[0]} {pos[1]} {pos[2]}" '
