+          let moving=vp,positionField='position',rotationField='orientation';
+          const documentXml=new DOMParser().parseFromString(xml,'application/xml');
+          const viewElement=[...documentXml.getElementsByTagName('Viewpoint')].find(n=>n.getAttribute('DEF')===viewpoint);
+          const parent=viewElement?.parentElement;
+          if(Math.hypot(vp.position.x,vp.position.y,vp.position.z)<1e-7&&parent?.tagName==='Transform'&&parent.getAttribute('DEF')) {
