+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Copy the pinned X_ITE browser runtime, components and license notices for offline viewing."""
+from __future__ import annotations
+import argparse
+import json
+from pathlib import Path
+import shutil
+import subprocess
+
+ROOT = Path(__file__).resolve().parent
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--node-modules', type=Path, default=ROOT / 'node_modules')
+    p.add_argument('--install', action='store_true', help='Run npm ci using this folder\'s pinned lockfile')
+    args = p.parse_args()
+    if args.install:
+        subprocess.run(['npm', 'ci', '--ignore-scripts', '--no-audit', '--no-fund'], cwd=ROOT, check=True)
+    source = args.node_modules / 'x_ite'
+    version = json.loads((source / 'package.json').read_text())['version']
+    required = json.loads((ROOT / 'package.json').read_text())['dependencies']['x_ite']
+    if version != required:
+        raise SystemExit(f'Expected X_ITE {required}, got {version}')
+    target = ROOT / 'web/vendor/x_ite'
+    target.mkdir(parents=True, exist_ok=True)
+    for name in ('x_ite.min.js', 'x_ite.css'):
+        shutil.copy2(source / 'dist' / name, target / name)
+    for name in ('assets',):
+        shutil.copytree(source / 'dist' / name, target / name, dirs_exist_ok=True)
+    shutil.copy2(source / 'LICENSE.md', target / 'LICENSE.md')
+    shutil.copytree(source / 'LICENSES', target / 'LICENSES', dirs_exist_ok=True)
+    (target / 'VERSION.json').write_text(json.dumps({'name': 'X_ITE', 'version': version,
+                                                   'license': 'MIT', 'source': 'https://github.com/create3000/x_ite'}, indent=2))
+    print(f'Copied X_ITE {version} and its third-party notices to {target}')
+
+
+if __name__ == '__main__':
+    main()
