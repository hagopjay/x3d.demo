+// SPDX-License-Identifier: GPL-3.0-or-later
+// Official Khronos validator adapter. No network or diagnostics are suppressed.
+// node validate_glb.cjs FILE [VALIDATOR_MODULE_PATH] [PACKAGE_ROOT]
+const fs = require('node:fs');
+const path = require('node:path');
+const {fileURLToPath} = require('node:url');
+
+(async () => {
+  const file = path.resolve(process.argv[2] || '');
+  if (!process.argv[2]) throw new Error('A GLB filepath is required');
+  const validator = require(process.argv[3] || 'gltf-validator');
+  const root = path.resolve(process.argv[4] || path.dirname(file));
+  const externalResourceFunction = async uri => {
+    if (/^[a-z][a-z0-9+.-]*:/i.test(uri)) throw new Error(`External URI scheme is forbidden by the offline audit: ${uri}`);
+    const decoded = decodeURIComponent(uri.split('#')[0].split('?')[0]);
+    const resolved = path.resolve(path.dirname(file), decoded);
+    if (resolved !== root && !resolved.startsWith(root + path.sep)) throw new Error('External resource escapes the package');
+    return new Uint8Array(await fs.promises.readFile(resolved));
+  };
+  const result = await validator.validateBytes(new Uint8Array(await fs.promises.readFile(file)), {
+    uri: path.basename(file),
+    externalResourceFunction,
+    maxIssues: 1000,
+  });
+  process.stdout.write(JSON.stringify({validatorVersion: validator.version(), ...result}) + '\n');
+  process.exitCode = result.issues.numErrors ? 1 : 0;
+})().catch(error => {
+  process.stdout.write(JSON.stringify({error: String(error), stack: error.stack}) + '\n');
+  process.exitCode = 2;
+});
