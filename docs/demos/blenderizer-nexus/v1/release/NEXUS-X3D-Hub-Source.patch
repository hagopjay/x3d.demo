index 0000000..3e4b5df
--- /dev/null
+++ b/demo/hub_observatory/adapters/unreal_import.py
@@ -0,0 +1,95 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Unreal Editor handoff for NEXUS GLB/USD assets.
+
+Run inside Unreal's Python environment, not ordinary Python. Example from the
+Editor Python console after adding this adapters directory to sys.path:
+
+    import unreal_import
+    unreal_import.import_asset(r"C:\\NEXUS\\web\\assets\\bim\\scene.glb")
+
+The showcase generation does not run Unreal; only a real successful Editor
+invocation may produce a report with status='pass'.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+
+def import_asset(asset, destination="/Game/NEXUS", *, replace=False, report=None):
+    """Import content assets and write observed paths; does not create a level.
+
+    Enable Python Editor Script Plugin and the matching glTF/Interchange or USD
+    importer in the project. Existing assets are not replaced unless requested.
+    """
+    import unreal
+
+    source = Path(asset).expanduser().resolve()
+    if not source.is_file():
+        raise FileNotFoundError(source)
+    extension = source.suffix.lower()
+    if extension not in {".glb", ".gltf", ".usd", ".usda", ".usdc", ".usdz"}:
+        raise ValueError("Choose a GLB/glTF or USD asset from the showcase")
+    if not destination.startswith("/Game/") or ".." in destination.split("/"):
+        raise ValueError("destination must be a project path beneath /Game/")
+
+    evidence = {
+        "schema": "x3d-hub/unreal-import/1", "status": "fail",
+        "source": str(source), "source_sha256": hashlib.sha256(source.read_bytes()).hexdigest(),
+        "engine_version": unreal.SystemLibrary.get_engine_version(), "destination": destination,
+        "replace_existing": replace, "scope": "content assets; scene/level reconstruction is not asserted",
+        "imported_object_paths": [],
+    }
+    report_path = Path(report).expanduser().resolve() if report else source.parent / "unreal_import_report.json"
+    try:
+        task = unreal.AssetImportTask()
+        for key, value in {"filename": str(source), "destination_path": destination,
+                           "automated": True, "async_": False, "save": True,
+                           "replace_existing": replace, "replace_existing_settings": replace}.items():
+            task.set_editor_property(key, value)
+        if extension in {".usd", ".usda", ".usdc", ".usdz"}:
+            if not hasattr(unreal, "UsdStageAssetImportFactory"):
+                raise RuntimeError("Enable the USD Importer plugin and restart the Editor")
+            task.set_editor_property("factory", unreal.UsdStageAssetImportFactory())
+            if hasattr(unreal, "UsdStageImportOptions"):
+                options = unreal.UsdStageImportOptions()
+                options.set_editor_property("import_actors", False)
+                task.set_editor_property("options", options)
+        unreal.AssetToolsHelpers.get_asset_tools().import_asset_tasks([task])
+        paths = [str(p) for p in task.get_editor_property("imported_object_paths")]
+        if not paths:
+            raise RuntimeError("The importer returned no assets; inspect the Editor log and importer plugins")
+        evidence["imported_object_paths"] = paths
+        evidence["status"] = "pass"
+        unreal.log(f"NEXUS imported {len(paths)} content assets from {source.name}")
+    except Exception as error:
+        evidence["error"] = f"{type(error).__name__}: {error}"
+        unreal.log_error(evidence["error"])
+        raise
+    finally:
+        report_path.parent.mkdir(parents=True, exist_ok=True)
+        report_path.write_text(json.dumps(evidence, indent=2) + "\n", encoding="utf-8")
+    return evidence
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--asset", type=Path, required=True,
+                        help="Absolute asset path, or a path relative to --assets-root")
+    parser.add_argument("--assets-root", type=Path)
+    parser.add_argument("--destination", default="/Game/NEXUS")
+    parser.add_argument("--replace", action="store_true")
+    parser.add_argument("--report", type=Path)
+    args = parser.parse_args(argv)
+    asset = args.asset
+    if args.assets_root and not asset.is_absolute():
+        asset = args.assets_root / asset
+    import_asset(asset, args.destination, replace=args.replace, report=args.report)
+
+
+if __name__ == "__main__":
+    arguments = sys.argv[sys.argv.index("--") + 1:] if "--" in sys.argv else sys.argv[1:]
+    main(arguments)
diff --git a/demo/hub_observatory/audit_dataset.py b/demo/hub_observatory/audit_dataset.py
