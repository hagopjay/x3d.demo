+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Render the actual editable Blender source scenes to polished, offline preview stills.
+
+blender -b --python render_posters.py -- --assets web/assets [--chapters foundry,bim]
+"""
+import argparse
+import json
+from pathlib import Path
+import sys
+import time
+import bpy
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--assets', type=Path, required=True)
+    parser.add_argument('--chapters', default='')
+    parser.add_argument('--samples', type=int, default=32)
+    args = parser.parse_args(sys.argv[sys.argv.index('--') + 1:])
+    root = args.assets.resolve()
+    report = json.loads((root / 'builder_report.json').read_text())
+    selected = set(args.chapters.split(',')) if args.chapters else set()
+    results = []
+    for chapter in report['chapters']:
+        if selected and chapter['id'] not in selected:
+            continue
+        folder = root / chapter['id']
+        started = time.monotonic()
+        bpy.ops.wm.open_mainfile(filepath=str(folder / 'scene.blend'))
+        scene = bpy.context.scene
+        scene.frame_set(scene.frame_start)
+        scene.render.engine = 'CYCLES'
+        scene.render.threads_mode = 'FIXED'
+        scene.render.threads = 6
+        scene.cycles.device = 'CPU'
+        scene.cycles.samples = args.samples
+        scene.cycles.use_denoising = True
+        scene.render.resolution_x, scene.render.resolution_y = 1280, 800
+        scene.render.resolution_percentage = 100
+        scene.render.image_settings.file_format = 'PNG'
+        scene.render.film_transparent = False
+        if scene.camera is None:
+            scene.camera = next(o for o in scene.objects if o.type == 'CAMERA')
+        scene.render.filepath = str(folder / 'poster.png')
+        bpy.ops.render.render(write_still=True)
+        entry = {'id': chapter['id'], 'renderer': 'Blender Cycles CPU', 'blender': bpy.app.version_string,
+                 'samples': args.samples, 'resolution': [1280, 800], 'frame': scene.frame_current,
+                 'source': 'scene.blend', 'seconds': round(time.monotonic() - started, 3)}
+        (folder / 'poster-receipt.json').write_text(json.dumps(entry, indent=2))
+        results.append(entry)
+        print('NEXUS_POSTER_OK', chapter['id'], entry['seconds'], flush=True)
+    print(json.dumps(results, indent=2))
+
+
+if __name__ == '__main__':
+    main()
