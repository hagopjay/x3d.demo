+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Measure actual DEF/USE savings against identical single-user mesh copies.
+
+blender -b --python measure_instancing.py -- --repo REPO --assets WEB/assets
+"""
+import argparse
+import gzip
+import importlib
+import json
+from pathlib import Path
+import shutil
+import sys
+import tempfile
+import xml.etree.ElementTree as ET
+import bpy
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--repo', type=Path, required=True)
+    p.add_argument('--assets', type=Path, required=True)
+    args = p.parse_args(sys.argv[sys.argv.index('--') + 1:])
+    repo, folder = args.repo.resolve(), args.assets.resolve() / 'instances'
+    with tempfile.TemporaryDirectory() as tmp:
+        package = Path(tmp) / 'io_scene_x3d'
+        try:
+            package.symlink_to(repo / 'source', target_is_directory=True)
+        except OSError:
+            shutil.copytree(repo / 'source', package)
+        sys.path.insert(0, tmp)
+        importlib.import_module('io_scene_x3d').register()
+        bpy.ops.wm.open_mainfile(filepath=str(folder / 'scene.blend'))
+        meshes = [o for o in bpy.context.scene.objects if o.type == 'MESH']
+        shared_before = sum(o.data.users > 1 for o in meshes)
+        def export(path):
+            r = bpy.ops.export_scene.x3d(filepath=str(path), x3d_version='X3D40', use_selection=False,
+                                         use_hierarchy=True, use_animation=False, use_normals=True, path_mode='COPY')
+            if r != {'FINISHED'}:
+                raise RuntimeError(r)
+            data = path.read_bytes()
+            xml = ET.fromstring(data)
+            return {'bytes': len(data), 'gzip_bytes': len(gzip.compress(data, compresslevel=9, mtime=0)),
+                    'coordinate_definitions': sum(el.tag == 'Coordinate' and 'USE' not in el.attrib for el in xml.iter()),
+                    'geometry_uses': sum(el.tag == 'IndexedFaceSet' and 'USE' in el.attrib for el in xml.iter())}
+        shared = export(folder / 'shared-reference.x3d')
+        for ob in meshes:
+            ob.data = ob.data.copy()
+        copies = export(folder / 'single-user-reference.x3d')
+        assert shared_before >= 100, 'The expected instanced synthetic city did not load.'
+        assert copies['bytes'] > shared['bytes'], 'Measured reuse did not reduce this dataset.'
+        receipt = {'schema': 'nexus-instancing-measurement/1', 'blender': bpy.app.version_string,
+                   'mesh_objects': len(meshes), 'shared_mesh_users_before': shared_before,
+                   'shared': shared, 'single_user_copies': copies,
+                   'byte_reduction_percent': round(100 * (1 - shared['bytes'] / copies['bytes']), 3),
+                   'size_ratio': round(copies['bytes'] / shared['bytes'], 3),
+                   'scope': 'Same scene, export options and materials; only mesh data sharing is changed. File size is not a render-speed benchmark.'}
+        (folder / 'instancing-evidence.json').write_text(json.dumps(receipt, indent=2) + '\n')
+        print(json.dumps(receipt, indent=2))
+
+
+if __name__ == '__main__':
+    main()
