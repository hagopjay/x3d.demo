+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Create an IFC4 pavilion, then tessellate the written IFC for Blender ingestion.
+
+    python adapters/bim.py --out web/assets/bim
+
+Requires IfcOpenShell and NumPy in ordinary Python, not in Blender. Geometry in
+the JSON is read back from the IFC file, never substituted by a parallel mesh.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import json
+import math
+from pathlib import Path
+import uuid
+import tempfile
+
+import numpy as np
+import ifcopenshell
+import ifcopenshell.api.aggregate
+import ifcopenshell.api.context
+import ifcopenshell.api.geometry
+import ifcopenshell.api.material
+import ifcopenshell.api.pset
+import ifcopenshell.api.root
+import ifcopenshell.api.spatial
+import ifcopenshell.api.style
+import ifcopenshell.api.unit
+import ifcopenshell.geom
+import ifcopenshell.guid
+import ifcopenshell.util.element
+import ifcopenshell.util.unit
+import ifcopenshell.validate
+
+
+NAMESPACE = uuid.UUID("a287c464-9123-4b14-a0c5-7f3f32e6782d")
+SCHEMA = "x3d-hub/bim-geometry/1"
+
+
+def guid(key: str) -> str:
+    return ifcopenshell.guid.compress(uuid.uuid5(NAMESPACE, key).hex)
+
+
+def specs() -> list[dict]:
+    """Every dimension is in metres; positions are lower local corners."""
+    items = []
+
+    def box(name, cls, location, size, material, color, carbon, u_value=0.0):
+        items.append(dict(name=name, ifc_type=cls, location=location, size=size,
+                          material=material, color=color, carbon=carbon, u_value=u_value))
+
+    box("Foundation / low-carbon raft", "IfcFooting", (-6, -4, -0.32), (12, 8, .32),
+        "Low-carbon concrete", (.19, .24, .28), 82)
+    box("Ground / polished concrete", "IfcSlab", (-6, -4, 0), (12, 8, .15),
+        "Low-carbon concrete", (.39, .44, .46), 82)
+    for row, y in enumerate((-3.4, 3.4)):
+        for col, x in enumerate((-5.4, -1.8, 1.8, 5.4)):
+            box(f"Column {row + 1}.{col + 1} / recycled aluminium", "IfcColumn",
+                (x - .11, y - .11, .15), (.22, .22, 3.85),
+                "Recycled aluminium", (.12, .68, .73), 425)
+    for i, y in enumerate((-3.51, 3.29)):
+        box(f"Edge beam {i + 1} / glulam", "IfcBeam", (-5.7, y, 3.72), (11.4, .22, .34),
+            "Engineered timber", (.64, .35, .12), 47)
+    box("Roof / insulated canopy", "IfcRoof", (-6.3, -4.3, 4.05), (12.6, 8.6, .22),
+        "Insulated roof panel", (.16, .21, .27), 28, .16)
+    for i in range(19):
+        x = -5.85 + i * .65
+        box(f"Solar fin {i + 1:02d} / anodised aluminium", "IfcMember",
+            (x, -4.3, 4.27), (.105, 8.6, .42),
+            "Recycled aluminium", (.89, .51, .12), 425)
+    for i, x in enumerate((-4.5, -.9, 2.7)):
+        box(f"Information plinth {i + 1}", "IfcBuildingElementProxy", (x, -.6, .15), (1.8, 1.2, .5),
+            "Engineered timber", (.54, .30, .13), 47)
+    box("Rear screen / translucent glass", "IfcPlate", (-4.6, 3.34, .6), (9.2, .06, 2.5),
+        "Recycled glass", (.07, .32, .42), 310, 1.1)
+    return items
+
+
+def build_ifc(path: Path) -> tuple[list[str], dict]:
+    model = ifcopenshell.file(schema="IFC4")
+    project = ifcopenshell.api.root.create_entity(model, ifc_class="IfcProject", name="Asterion Exchange Pavilion")
+    project.GlobalId = guid("project")
+    project.Description = "Synthetic 12 × 8 metre exchange pavilion. Demonstration data, not engineering design."
+    units = [ifcopenshell.api.unit.add_si_unit(model, unit_type=t)
+             for t in ("LENGTHUNIT", "AREAUNIT", "VOLUMEUNIT")]
+    ifcopenshell.api.unit.assign_unit(model, units=units)
+    context = ifcopenshell.api.context.add_context(model, context_type="Model")
+    body = ifcopenshell.api.context.add_context(model, context_type="Model", context_identifier="Body",
+                                              target_view="MODEL_VIEW", parent=context)
+    site = ifcopenshell.api.root.create_entity(model, ifc_class="IfcSite", name="Synthetic harbour campus")
+    building = ifcopenshell.api.root.create_entity(model, ifc_class="IfcBuilding", name="Asterion Pavilion")
+    storey = ifcopenshell.api.root.create_entity(model, ifc_class="IfcBuildingStorey", name="Ground exchange")
+    for key, entity in (("site", site), ("building", building), ("storey", storey)):
+        entity.GlobalId = guid(key)
+    storey.Elevation = 0.0
+    for parent, child in ((project, site), (site, building), (building, storey)):
+        ifcopenshell.api.aggregate.assign_object(model, products=[child], relating_object=parent)
+
+    materials, styles, expected_bounds = {}, {}, {}
+    for spec in specs():
+        name = spec["name"]
+        product = ifcopenshell.api.root.create_entity(model, ifc_class=spec["ifc_type"], name=name)
+        product.GlobalId = guid("element/" + name)
+        product.Description = "Synthetic demonstrator element; performance values are illustrative."
+        product.Tag = "ASTERION-" + product.GlobalId
+        x, y, z = spec["size"]
+        representation = ifcopenshell.api.geometry.add_wall_representation(
+            model, context=body, length=x, thickness=y, height=z)
+        ifcopenshell.api.geometry.assign_representation(model, product=product, representation=representation)
+        placement = np.eye(4)
+        placement[:3, 3] = spec["location"]
+        ifcopenshell.api.geometry.edit_object_placement(model, product=product, matrix=placement)
+        ifcopenshell.api.spatial.assign_container(model, products=[product], relating_structure=storey)
+
+        material_name = spec["material"]
+        if material_name not in materials:
+            materials[material_name] = ifcopenshell.api.material.add_material(model, name=material_name)
+        ifcopenshell.api.material.assign_material(model, products=[product], material=materials[material_name])
+        color = tuple(spec["color"])
+        if color not in styles:
+            style = ifcopenshell.api.style.add_style(model, name="Pavilion " + material_name)
+            ifcopenshell.api.style.add_surface_style(model, style=style, attributes={
+                "SurfaceColour": dict(zip(("Red", "Green", "Blue"), color)), "Transparency": 0.0})
+            styles[color] = style
+        ifcopenshell.api.style.assign_representation_styles(model, shape_representation=representation,
+                                                             styles=[styles[color]])
+        volume = math.prod(spec["size"])
+        pset = ifcopenshell.api.pset.add_pset(model, product=product, name="Pset_AsterionSynthetic")
+        ifcopenshell.api.pset.edit_pset(model, pset=pset, properties={
+            "Synthetic": True, "Scenario": "Asterion Exchange Pavilion", "Material": material_name,
+            "ColorRGB": " ".join(str(v) for v in color), "DesignLifeYears": 60,
+            "EmbodiedCarbon_kgCO2e_per_m3": float(spec["carbon"]),
+            "IllustrativeEmbodiedCarbon_kgCO2e": round(volume * spec["carbon"], 3),
+            "ThermalTransmittance_W_m2K": float(spec["u_value"]),
+            "ReferenceVolume_m3": round(volume, 6),
+            "EvidenceScope": "Synthetic scenario, not an engineering or lifecycle assessment"})
+        expected_bounds[product.GlobalId] = {
+            "min": list(spec["location"]),
+            "max": [a + b for a, b in zip(spec["location"], spec["size"])]}
+
+    # Stabilise relation/property-set GUIDs as well as product GUIDs. This fixture
+    # has deterministic creation order; references themselves remain ordinary IFC.
+    preserved = {project, site, building, storey, *model.by_type("IfcElement")}
+    for entity in model.by_type("IfcRoot"):
+        if entity not in preserved:
+            entity.GlobalId = guid(f"support/{entity.is_a()}/{entity.id()}")
+    # API helpers legitimately use Python sets for EXPRESS SET attributes. Their
+    # serialization order is not semantic, but must be canonical for this fixture.
+    for cls, attribute in (("IfcRelContainedInSpatialStructure", "RelatedElements"),
+                           ("IfcRelAssociatesMaterial", "RelatedObjects"),
+                           ("IfcRelAggregates", "RelatedObjects"),
+                           ("IfcRelDefinesByProperties", "RelatedObjects"),
+                           ("IfcPropertySet", "HasProperties"), ("IfcUnitAssignment", "Units")):
+        for entity in model.by_type(cls):
+            setattr(entity, attribute, tuple(sorted(getattr(entity, attribute), key=lambda item: item.id())))
+    model.header.file_name.name = path.name
+    model.header.file_name.time_stamp = "2026-11-19T00:00:00"
+    model.header.file_name.author = ("Asterion synthetic dataset",)
+    model.header.file_name.organization = ("X3D Hub Observatory",)
+    model.header.file_name.preprocessor_version = f"IfcOpenShell {ifcopenshell.version}"
+    model.header.file_name.originating_system = "NEXUS deterministic IFC4 fixture"
+    model.write(str(path))
+    return [guid("element/" + s["name"]) for s in specs()], expected_bounds
+
+
+def extract_ifc(path: Path) -> dict:
+    model = ifcopenshell.open(str(path))
+    settings = ifcopenshell.geom.settings()
+    settings.set(settings.USE_WORLD_COORDS, True)
+    result = []
+    for product in sorted(model.by_type("IfcElement"), key=lambda p: p.GlobalId):
+        if not product.Representation:
+            continue
+        shape = ifcopenshell.geom.create_shape(settings, product)
+        raw_vertices = shape.geometry.verts
+        raw_faces = shape.geometry.faces
+        props = ifcopenshell.util.element.get_psets(product)["Pset_AsterionSynthetic"]
+        props.pop("id", None)  # STEP instance numbers are implementation detail.
+        color = [float(v) for v in props.pop("ColorRGB").split()]
+        vertices = [[round(float(v), 9) for v in raw_vertices[i:i + 3]]
+                    for i in range(0, len(raw_vertices), 3)]
+        faces = [list(raw_faces[i:i + 3]) for i in range(0, len(raw_faces), 3)]
+        result.append({"id": product.GlobalId, "name": product.Name, "ifc_type": product.is_a(),
+                       "vertices": vertices, "faces": faces, "color": color, "properties": props})
+    return {"schema": SCHEMA, "source": path.name, "units": "metre", "up_axis": "Z",
+            "coordinate_space": "world", "synthetic": True, "elements": result}
+
+
+def verify(path: Path, geometry: dict, expected_ids: list[str], expected_bounds: dict) -> dict:
+    model = ifcopenshell.open(str(path))
+    elements = geometry["elements"]
+    ids = [e["id"] for e in elements]
+    errors = []
+    if len(ids) != len(set(ids)) or set(ids) != set(expected_ids):
+        errors.append("Element identities differ after IFC reopen/tessellation")
+    maximum_error = 0.0
+    for element in elements:
+        values = np.asarray(element["vertices"])
+        if not len(values) or not element["faces"] or not np.isfinite(values).all():
+            errors.append(f"Invalid geometry: {element['name']}")
+            continue
+        expected = expected_bounds[element["id"]]
+        error = max(np.abs(values.min(axis=0) - expected["min"]).max(),
+                    np.abs(values.max(axis=0) - expected["max"]).max())
+        maximum_error = max(maximum_error, float(error))
+        if error > 1e-7:
+            errors.append(f"World bounds differ for {element['name']}: {error}")
+        if any(not 0 <= index < len(values) for face in element["faces"] for index in face):
+            errors.append(f"Triangle index out of range: {element['name']}")
+    unit_scale = ifcopenshell.util.unit.calculate_unit_scale(model)
+    if unit_scale != 1.0:
+        errors.append(f"Expected metre unit scale 1, got {unit_scale}")
+    if len(model.by_type("IfcColumn")) != 8:
+        errors.append("Expected eight structural columns")
+    roots = model.by_type("IfcRoot")
+    if len({r.GlobalId for r in roots}) != len(roots):
+        errors.append("Duplicate IFC GlobalId")
+    validation = ifcopenshell.validate.json_logger()
+    ifcopenshell.validate.validate(model, validation)
+    if validation.statements:
+        errors.append(f"IFC schema validation reported {len(validation.statements)} messages")
+    evidence = {
+        "schema": "x3d-hub/bim-evidence/1", "status": "pass" if not errors else "fail",
+        "ifc_schema": model.schema, "ifcopenshell_version": ifcopenshell.version,
+        "source_sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
+        "source_bytes": path.stat().st_size, "synthetic": True,
+        "geometry_source": "IfcOpenShell create_shape on reopened pavilion.ifc",
+        "units": "metre", "unit_scale": unit_scale, "up_axis": "Z",
+        "elements": len(elements), "ifc_roots": len(roots),
+        "schema_validation_messages": len(validation.statements),
+        "types": dict(sorted(Counter(e["ifc_type"] for e in elements).items())),
+        "vertices": sum(len(e["vertices"]) for e in elements),
+        "triangles": sum(len(e["faces"]) for e in elements),
+        "maximum_world_bounds_error_metres": maximum_error,
+        "deterministic_element_ids": ids, "errors": errors,
+        "checks": [
+            {"label": "IFC4 reopened and tessellated", "status": "pass" if not errors else "fail",
+             "detail": f"{len(elements)} typed elements, {sum(len(e['faces']) for e in elements)} triangles"},
+            {"label": "Metres and world placement", "status": "pass" if not errors else "fail",
+             "detail": f"Unit scale {unit_scale}; maximum bounds error {maximum_error:g} m"},
+            {"label": "Bonsai interactive import", "status": "not_run",
+             "detail": "IFC4 asset prepared and verified by IfcOpenShell; Bonsai UI not run here"},
+            {"label": "Unreal Editor import", "status": "not_run",
+             "detail": "GLB/USD handoff script provided; Unreal Editor not available here"}]}
+    if errors:
+        raise RuntimeError(json.dumps(evidence, indent=2))
+    return evidence
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    args.out.mkdir(parents=True, exist_ok=True)
+    path = args.out / "pavilion.ifc"
+    ids, bounds = build_ifc(path)
+    geometry = extract_ifc(path)
+    evidence = verify(path, geometry, ids, bounds)
+    with tempfile.TemporaryDirectory(prefix="asterion-ifc-repeat-") as temporary:
+        repeated = Path(temporary) / path.name
+        build_ifc(repeated)
+        if path.read_bytes() != repeated.read_bytes():
+            raise RuntimeError("Repeated IFC generation was not byte deterministic")
+    evidence["repeat_build_byte_identical"] = True
+    (args.out / "bim_geometry.json").write_text(json.dumps(geometry, indent=2) + "\n", encoding="utf-8")
+    (args.out / "bim_evidence.json").write_text(json.dumps(evidence, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({k: evidence[k] for k in ("status", "elements", "vertices", "triangles",
+                                              "maximum_world_bounds_error_metres")}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/demo/hub_observatory/adapters/unreal_import.py b/demo/hub_observatory/adapters/unreal_import.py
