+            '<WorldInfo title="NEXUS independent input"/><NavigationInfo type=\'"EXAMINE" "ANY"\' headlight="false"/>'
+            '<Background skyColor=".018 .033 .065"/>' + cameras_xml +
+            '<DirectionalLight direction="-.4 -1 -.5" color="1 .88 .72" intensity="1"/>'
+            '<DirectionalLight direction=".5 -.3 .8" color=".4 .68 1" intensity=".7"/>' + base + body + '</Scene></X3D>')
