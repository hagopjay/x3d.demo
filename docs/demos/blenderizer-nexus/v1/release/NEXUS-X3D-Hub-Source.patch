index 0000000..43259f3
--- /dev/null
+++ b/demo/hub_observatory/audit_dataset.py
@@ -0,0 +1,524 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Independently audit the NEXUS exchange artifacts without Blender or network.
+
+The audit proves file validity, local dependencies and reopenability. It does not
+claim semantic preservation or equal renders merely because a file opens.
+
+    python audit_dataset.py --validator-path /path/to/gltf-validator
+    python audit_dataset.py --self-test
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import importlib
+import json
+import math
+import os
+from pathlib import Path
+import re
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+from urllib.parse import unquote, urlsplit
+from xml.etree import ElementTree as ET
+
+HERE = Path(__file__).resolve().parent
+EXPECTED_FILES = ("scene.blend", "imported.blend", "scene.x3d", "roundtrip.x3d", "scene.glb", "scene.usda",
+                  "hub.glb", "hub.usda")
+GEOMETRY_NODES = {"IndexedFaceSet", "IndexedTriangleSet", "TriangleSet", "PointSet", "IndexedLineSet",
+                  "Box", "Cone", "Cylinder", "Sphere", "ElevationGrid", "Extrusion", "Text", "Inline",
+                  "Circle2D", "Rectangle2D", "TriangleSet2D", "Disk2D", "Polyline2D"}
+RESOURCE_NODES = {"Inline", "ImageTexture", "MovieTexture", "AudioClip", "ImageCubeMapTexture",
+                  "ImageTexture3D", "ImageTextureAtlas", "FontStyle"}
+URL_SCHEME = re.compile(r"^[A-Za-z][A-Za-z0-9+.-]*:")
+
+
+def record(checks, label, status, detail, **kwargs):
+    checks.append({"label": label, "status": status, "detail": detail, **kwargs})
+
+
+def relative_inside(path: Path, root: Path) -> bool:
+    try:
+        path.resolve().relative_to(root.resolve())
+        return True
+    except ValueError:
+        return False
+
+
+def local_asset(base: Path, uri: str, package_root: Path) -> tuple[str, str]:
+    """Return a packaging status. Never retrieve a URL or allow path escape."""
+    if not uri or uri.startswith('#'):
+        return "embedded", uri
+    if uri.startswith('data:'):
+        return "embedded", "data URI"
+    parts = urlsplit(uri)
+    if parts.scheme or parts.netloc or URL_SCHEME.match(uri) or uri.startswith('\\\\'):
+        return "external", uri
+    path_text = unquote(parts.path)
+    if Path(path_text).is_absolute() or re.match(r"^[A-Za-z]:[\\/]", path_text):
+        return "absolute", uri
+    # Backslashes are not portable URL separators. Fail instead of passing on Linux then breaking Windows.
+    if '\\' in path_text:
+        return "nonportable", uri
+    candidate = base / path_text
+    if not relative_inside(candidate, package_root):
+        return "escape", uri
+    if not candidate.is_file():
+        return "missing", uri
+    return "local", candidate.resolve().relative_to(package_root.resolve()).as_posix()
+
+
+def mfstrings(raw: str) -> list[str]:
+    """Decode X3D double-quoted MFString values, preserving spaces in names."""
+    raw = raw.strip()
+    if not raw:
+        return []
+    if not raw.startswith('"'):
+        return [raw]
+    result, pos = [], 0
+    while pos < len(raw):
+        while pos < len(raw) and (raw[pos].isspace() or raw[pos] == ','):
+            pos += 1
+        if pos == len(raw):
+            break
+        if raw[pos] != '"':
+            raise ValueError("Unexpected text outside MFString quotes")
+        pos += 1
+        value = []
+        while pos < len(raw) and raw[pos] != '"':
+            if raw[pos] == '\\':
+                pos += 1
+                if pos == len(raw):
+                    raise ValueError("Unterminated MFString escape")
+            value.append(raw[pos])
+            pos += 1
+        if pos == len(raw):
+            raise ValueError("Unterminated MFString")
+        result.append(''.join(value))
+        pos += 1
+    return result
+
+
+def metadata_guids(value) -> set[str]:
+    """Read explicit IFC GUID metadata, never infer identity from display names."""
+    found = set()
+    if isinstance(value, dict):
+        if isinstance(value.get('ifc_guid'), str):
+            found.add(value['ifc_guid'])
+        if value.get('name') == 'GlobalId' and isinstance(value.get('value'), str):
+            found.update(mfstrings(value['value']))
+        for child in value.values():
+            found.update(metadata_guids(child))
+    elif isinstance(value, list):
+        for child in value:
+            found.update(metadata_guids(child))
+    return found
+
+
+def inspect_x3d(path: Path, package_root: Path, checks: list, validator=None):
+    label = path.name
+    try:
+        root = ET.parse(path).getroot()
+    except (ET.ParseError, OSError) as exc:
+        record(checks, f"{label} XML", "fail", str(exc))
+        return {}
+    valid_root = root.tag == 'X3D' and root.get('version') == '4.0'
+    record(checks, f"{label} X3D 4.0", "pass" if valid_root else "fail",
+           f"Root={root.tag}; version={root.get('version')}")
+    tags = Counter(node.tag for node in root.iter())
+    nonempty = root.find('Scene') is not None and any(tags[tag] for tag in GEOMETRY_NODES)
+    record(checks, f"{label} scene content", "pass" if nonempty else "fail",
+           "Contains geometry or an Inline reference" if nonempty else "No geometry/Inline found")
+    if validator is None:
+        record(checks, f"{label} add-on validator", "not_run", "Repository validator could not be imported")
+    else:
+        result = validator.validate_xml_file(str(path))
+        record(checks, f"{label} add-on validator", "fail" if not result.valid else "warn" if result.warnings else "pass",
+               "; ".join(result.errors + result.warnings) or "No structural/field errors", errors=result.errors,
+               warnings=result.warnings)
+    dependencies = []
+    for node in root.iter():
+        if node.tag not in RESOURCE_NODES or not node.get('url'):
+            continue
+        try:
+            alternatives = mfstrings(node.get('url'))
+        except ValueError as exc:
+            record(checks, f"{label} resource URL", "fail", str(exc))
+            continue
+        statuses = [local_asset(path.parent, uri, package_root) for uri in alternatives]
+        success = next((i for i, (s, _p) in enumerate(statuses) if s in {'local', 'embedded'}), None)
+        dependencies.append({"node": node.tag, "alternatives": alternatives,
+                             "resolutions": [{"status": s, "path": p} for s, p in statuses]})
+        if success is None:
+            record(checks, f"{label} {node.tag} resource", "fail", f"No offline alternative resolves: {alternatives}")
+        else:
+            # Earlier absent alternatives are legal fallbacks. Preserve this observation without reporting them as missing files.
+            detail = f"Alternative {success + 1}/{len(statuses)} resolves: {statuses[success][1]}"
+            remaining_external = any(s in {'external', 'absolute', 'escape', 'nonportable'} for s, _p in statuses)
+            record(checks, f"{label} {node.tag} resource", "warn" if remaining_external else "pass", detail,
+                   alternatives=statuses)
+    guids = set()
+    for node in root.iter('MetadataString'):
+        if node.get('name') == 'GlobalId':
+            guids.update(mfstrings(node.get('value', '')))
+    return {"node_counts": dict(sorted(tags.items())), "dependencies": dependencies, "ifc_global_ids": sorted(guids),
+            "scope": "Syntax, known fields and packaged dependencies; not a render or preservation oracle"}
+
+
+def read_glb_json(path: Path):
+    """Read the JSON chunk and enforce the GLB container boundary independently."""
+    data = path.read_bytes()
+    if len(data) < 20:
+        raise ValueError("GLB is shorter than its header and JSON chunk")
+    magic, version, length = struct.unpack_from('<4sII', data)
+    if magic != b'glTF' or version != 2 or length != len(data):
+        raise ValueError("Invalid GLB magic, version or declared total length")
+    chunk_size, kind = struct.unpack_from('<I4s', data, 12)
+    if kind != b'JSON' or chunk_size % 4 or 20 + chunk_size > len(data):
+        raise ValueError("Invalid GLB JSON chunk")
+    document = json.loads(data[20:20 + chunk_size])
+    if document.get('asset', {}).get('version') != '2.0':
+        raise ValueError("GLB asset version is not 2.0")
+    return document
+
+
+def inspect_glb(path: Path, package_root: Path, checks: list, validator_path: str | None):
+    try:
+        doc = read_glb_json(path)
+    except (OSError, ValueError, struct.error) as exc:
+        record(checks, "GLB container", "fail", str(exc))
+        return {}
+    nonempty = bool(doc.get('meshes')) and bool(doc.get('nodes'))
+    record(checks, "GLB scene content", "pass" if nonempty else "fail",
+           f"{len(doc.get('meshes', []))} meshes; {len(doc.get('nodes', []))} nodes")
+    for kind in ('buffers', 'images'):
+        for item in doc.get(kind, []):
+            if not item.get('uri'):
+                continue
+            status, resolved = local_asset(path.parent, item['uri'], package_root)
+            record(checks, f"GLB {kind} resource", "pass" if status in {'local', 'embedded'} else "fail",
+                   f"{status}: {resolved}")
+    if not shutil.which('node'):
+        record(checks, "Khronos GLB validator", "not_run", "Node.js is unavailable")
+        return {"meshes": len(doc.get('meshes', []))}
+    command = ['node', str(HERE / 'validate_glb.cjs'), str(path), validator_path or 'gltf-validator', str(package_root)]
+    try:
+        proc = subprocess.run(command, text=True, capture_output=True, timeout=90)
+        result = json.loads(proc.stdout)
+        if 'error' in result and "Cannot find module" in result['error']:
+            record(checks, "Khronos GLB validator", "not_run", result['error'])
+        elif proc.returncode not in (0, 1) or 'issues' not in result:
+            record(checks, "Khronos GLB validator", "fail", result.get('error', proc.stderr or proc.stdout))
+        else:
+            issues = result['issues']
+            status = 'fail' if issues['numErrors'] else 'warn' if issues['numWarnings'] else 'pass'
+            record(checks, "Khronos GLB validator", status,
+                   f"{issues['numErrors']} errors; {issues['numWarnings']} warnings; validator {result.get('validatorVersion')}",
+                   errors=issues['numErrors'], warnings=issues['numWarnings'])
+        return {"meshes": len(doc.get('meshes', [])), "nodes": len(doc.get('nodes', [])),
+                "extensions_used": doc.get('extensionsUsed', []), "khronos_validation": result,
+                "ifc_global_ids": sorted(metadata_guids(doc)),
+                "skins": [{"name": skin.get('name'), "joint_count": len(skin.get('joints', []))}
+                          for skin in doc.get('skins', [])],
+                "skinned_primitives": sum('JOINTS_0' in p.get('attributes', {}) and 'WEIGHTS_0' in p.get('attributes', {})
+                                          for mesh in doc.get('meshes', []) for p in mesh.get('primitives', []))}
+    except (subprocess.TimeoutExpired, json.JSONDecodeError, OSError) as exc:
+        record(checks, "Khronos GLB validator", "fail", str(exc))
+        return {}
+
+
+def inspect_usd(path: Path, package_root: Path, checks: list):
+    try:
+        from pxr import Sdf, Usd, UsdGeom
+    except ImportError:
+        record(checks, "OpenUSD reopen", "not_run", "Official pxr bindings are unavailable")
+        return {}
+    try:
+        stage = Usd.Stage.Open(str(path))
+        if stage is None:
+            raise ValueError("Usd.Stage.Open returned no stage")
+        prims = list(stage.Traverse())
+        meshes = [prim for prim in prims if prim.IsA(UsdGeom.Mesh)]
+        record(checks, "OpenUSD reopen", "pass" if meshes else "fail",
+               f"Official pxr reopened {len(prims)} prims including {len(meshes)} meshes")
+        units, up = UsdGeom.GetStageMetersPerUnit(stage), str(UsdGeom.GetStageUpAxis(stage))
+        good_units = math.isfinite(units) and units > 0 and up in {'Y', 'Z'}
+        record(checks, "OpenUSD units and axis", "pass" if good_units else "fail", f"metres/unit={units}; up={up}")
+        asset_refs = set()
+        for layer in stage.GetLayerStack():
+            for uri in (*layer.GetExternalReferences(), *layer.GetExternalAssetDependencies()):
+                asset_refs.add((Path(layer.realPath).parent, str(uri)))
+        for prim in prims:
+            for attr in prim.GetAttributes():
+                if attr.GetTypeName() in (Sdf.ValueTypeNames.Asset, Sdf.ValueTypeNames.AssetArray):
+                    value = attr.Get()
+                    if value is None:
+                        continue
+                    for asset in value if isinstance(value, (list, tuple)) or attr.GetTypeName() == Sdf.ValueTypeNames.AssetArray else [value]:
+                        asset_refs.add((path.parent, asset.path))
+        dependencies = []
+        for base, uri in sorted(asset_refs, key=lambda item: (str(item[0]), item[1])):
+            status, resolved = local_asset(base, uri, package_root)
+            dependencies.append({"uri": uri, "status": status, "resolved": resolved})
+            record(checks, "OpenUSD asset resource", "pass" if status in {'local', 'embedded'} else "fail",
+                   f"{status}: {resolved}")
+        guids = {str(attr.Get()) for prim in prims for attr in prim.GetAttributes()
+                 if attr.GetName().endswith(':ifc_guid') and attr.Get()}
+        return {"version": list(Usd.GetVersion()), "prims": len(prims), "meshes": len(meshes),
+                "meters_per_unit": units, "up_axis": up, "dependencies": dependencies,
+                "ifc_global_ids": sorted(guids),
+                "scope": "Official USD parse and dependency checks, not Unreal execution or material equivalence"}
+    except Exception as exc:
+        record(checks, "OpenUSD reopen", "fail", str(exc))
+        return {}
+
+
+def inspect_ifc(path: Path, checks: list):
+    try:
+        import ifcopenshell
+        import ifcopenshell.geom
+    except ImportError:
+        record(checks, "IFC reopen", "not_run", "IfcOpenShell is unavailable")
+        return {}
+    try:
+        model = ifcopenshell.open(str(path))
+        elements = model.by_type('IfcElement')
+        ids = [entity.GlobalId for entity in elements]
+        record(checks, "IFC identity", "pass" if elements and len(ids) == len(set(ids)) else "fail",
+               f"{model.schema}; {len(elements)} elements; {len(set(ids))} unique GlobalIds")
+        geometry_count = 0
+        settings = ifcopenshell.geom.settings()
+        for entity in elements:
+            if not entity.Representation:
+                continue
+            shape = ifcopenshell.geom.create_shape(settings, entity)
+            if not shape.geometry.verts or not shape.geometry.faces:
+                raise ValueError(f"Empty IFC shape for {entity.GlobalId}")
+            geometry_count += 1
+        record(checks, "IFC geometry", "pass" if geometry_count else "fail",
+               f"IfcOpenShell created {geometry_count} nonempty element shapes; Bonsai UI was not run")
+        return {"schema": model.schema, "elements": len(elements), "shapes": geometry_count,
+                "types": dict(sorted(Counter(e.is_a() for e in elements).items())), "global_ids": sorted(ids)}
+    except Exception as exc:
+        record(checks, "IFC reopen", "fail", str(exc))
+        return {}
+
+
+def hanim_signature(path: Path):
+    """Inspect this demonstrator's skinned partial rig without implying LOA conformance."""
+    root = ET.parse(path).getroot()
+    humanoids = list(root.iter('HAnimHumanoid'))
+    joints = [node for node in root.iter('HAnimJoint') if node.get('DEF')]
+    points = [node.get('point', '').split() for h in humanoids for node in h.iter('Coordinate') if node.get('point')]
+    vertex_count = sum(len(values) // 3 for values in points)
+    weights, valid = {}, bool(humanoids and joints and vertex_count)
+    for joint in joints:
+        indices = list(map(int, joint.get('skinCoordIndex', '').split()))
+        values = list(map(float, joint.get('skinCoordWeight', '').split()))
+        valid = valid and len(indices) == len(values) and all(0 <= i < vertex_count for i in indices)
+        valid = valid and all(math.isfinite(w) and 0 <= w <= 1 for w in values)
+        name = joint.get('name') or joint.get('DEF')
+        if name in weights:
+            valid = False
+        # Omitting exact-zero influences is equivalent; do not turn that representation change into lost weighting.
+        weights[name] = {index: weight for index, weight in zip(indices, values) if weight != 0}
+    nonzero = sum(len(w) for w in weights.values())
+    return {"humanoids": len(humanoids), "joint_count": len(joints), "skin_vertices": vertex_count,
+            "nonzero_influences": nonzero, "valid": bool(valid and nonzero), "weights": weights}
+
+
+def inspect_hanim_pair(folder: Path, chapter: dict, checks: list):
+    try:
+        before = hanim_signature(folder / 'scene.x3d')
+        after = hanim_signature(folder / 'roundtrip.x3d')
+        for label, signature in (("source", before), ("reimport", after)):
+            record(checks, f"HAnim {label} partial rig", "pass" if signature['valid'] else "fail",
+                   f"{signature['humanoids']} humanoid; {signature['joint_count']} joints; "
+                   f"{signature['skin_vertices']} skin vertices; partial rig, no LOA assertion")
+        same = before['weights'].keys() == after['weights'].keys()
+        maximum_error = 0.0
+        for name, weights in before['weights'].items():
+            other = after['weights'].get(name, {})
+            same = same and weights.keys() == other.keys()
+            for index, weight in weights.items():
+                maximum_error = max(maximum_error, abs(weight - other.get(index, 0)))
+        same = same and maximum_error <= 1e-6
+        record(checks, "HAnim nonzero skin-weight preservation", "pass" if same else "fail",
+               f"{before['nonzero_influences']} nonzero influences compared; max weight error {maximum_error:g}; "
+               "exact-zero entries may be omitted")
+        for name in ('scene.glb', 'hub.glb'):
+            data = chapter['formats'].get(name, {})
+            good = (any(skin['joint_count'] == before['joint_count'] for skin in data.get('skins', []))
+                    and data.get('skinned_primitives', 0) > 0)
+            record(checks, f"{name}: HAnim bridge skin", "pass" if good else "fail",
+                   f"{len(data.get('skins', []))} skins; {data.get('skinned_primitives', 0)} weighted primitives; "
+                   "HAnim semantics beyond this partial rig are not implied")
+        chapter['hanim'] = {"source": {k: v for k, v in before.items() if k != 'weights'},
+                            "reimport": {k: v for k, v in after.items() if k != 'weights'},
+                            "max_nonzero_weight_error": maximum_error}
+    except (OSError, ValueError, ET.ParseError) as exc:
+        record(checks, "HAnim partial-rig inspection", "fail", str(exc))
+
+
+def audit(assets: Path, repo: Path, validator_path: str | None, allow_partial=False):
+    assets = assets.resolve()
+    runtime = {"python": sys.version.split()[0], "platform": sys.platform,
+               "node": shutil.which('node'), "network": "No network retrieval performed"}
+    result = {"schema": "nexus.exchange-audit/v1", "runtime": runtime, "inputs": {}, "chapters": {}, "summary": {}}
+    sys.path.insert(0, str(repo / 'source'))
+    try:
+        validator = importlib.import_module('validate')
+    except ImportError:
+        validator = None
+    directories = sorted(p for p in assets.iterdir() if p.is_dir() and
+                         any((p / name).exists() for name in EXPECTED_FILES)) if assets.is_dir() else []
+    input_guids = set()
+    if assets.is_dir():
+        for path in sorted(assets.rglob('*.ifc')):
+            # Input IFC files remain inputs, rather than becoming artificial empty "chapters".
+            checks = []
+            data = inspect_ifc(path, checks)
+            input_guids.update(data.get('global_ids', []))
+            with path.open('rb') as src:
+                digest = hashlib.file_digest(src, 'sha256').hexdigest()
+            result['inputs'][path.relative_to(assets).as_posix()] = {
+                "checks": checks, "ifc": data, "bytes": path.stat().st_size, "sha256": digest}
+    for folder in directories:
+        checks, files = [], {}
+        chapter = {"checks": checks, "files": files}
+        for name in EXPECTED_FILES:
+            path = folder / name
+            if not path.is_file() or path.stat().st_size == 0:
+                record(checks, f"Required {name}", "not_run" if allow_partial else "fail", "Missing or empty artifact")
+        for path in sorted(folder.rglob('*')):
+            if path.is_file():
+                with path.open('rb') as src:
+                    digest = hashlib.file_digest(src, 'sha256').hexdigest()
+                files[path.relative_to(folder).as_posix()] = {"bytes": path.stat().st_size, "sha256": digest}
+        for path in sorted(folder.rglob('*.x3d')):
+            chapter[path.relative_to(folder).as_posix()] = inspect_x3d(path, assets, checks, validator)
+        for blend in sorted(folder.glob('*.blend')):
+            with blend.open('rb') as src:
+                header = src.read(7)
+            # Blender may use zstd compression on saved .blend files; that container is valid but not reopened by this script.
+            valid_header = header == b'BLENDER' or header[:4] == b'\x28\xb5\x2f\xfd' or header[:2] == b'\x1f\x8b'
+            record(checks, f"{blend.name} container signature", "pass" if valid_header else "fail",
+                   "Container signature only; Blender reopen checks belong to the builder evidence")
+        chapter['formats'] = {}
+        for suffix, inspect, alias in (('*.glb', inspect_glb, 'glb'), ('*.usda', inspect_usd, 'usd')):
+            for path in sorted(folder.rglob(suffix)):
+                before = len(checks)
+                value = (inspect(path, assets, checks, validator_path) if alias == 'glb'
+                         else inspect(path, assets, checks))
+                key = path.relative_to(folder).as_posix()
+                chapter['formats'][key] = value
+                if path.name == 'scene.' + alias.replace('usd', 'usda'):
+                    chapter[alias] = value  # Backwards-compatible convenience for the baseline export.
+                for check in checks[before:]:
+                    check['label'] = f"{key}: {check['label']}"
+        for ifc in sorted(folder.glob('*.ifc')):
+            chapter[ifc.name] = inspect_ifc(ifc, checks)
+        poster = folder / 'poster.png'
+        if poster.exists():
+            try:
+                from PIL import Image
+                with Image.open(poster) as image:
+                    image.verify()
+                record(checks, "Poster PNG decode", "pass", "Image decoding succeeds; not a render-comparison metric")
+            except Exception as exc:
+                record(checks, "Poster PNG decode", "fail", str(exc))
+        source_guids = set(chapter.get('scene.x3d', {}).get('ifc_global_ids', []))
+        if source_guids:
+            record(checks, "IFC → X3D GUID identity", "pass" if source_guids == input_guids else "fail",
+                   f"{len(source_guids)} X3D GUIDs compared directly with {len(input_guids)} IFC input GUIDs")
+            roundtrip_guids = set(chapter.get('roundtrip.x3d', {}).get('ifc_global_ids', []))
+            record(checks, "X3D round-trip GUID identity", "pass" if roundtrip_guids == source_guids else "fail",
+                   f"{len(roundtrip_guids)}/{len(source_guids)} GUID values retained")
+            for name in ('hub.glb', 'hub.usda'):
+                target_guids = set(chapter['formats'].get(name, {}).get('ifc_global_ids', []))
+                record(checks, f"{name}: IFC GUID identity", "pass" if target_guids == source_guids else "warn",
+                       f"{len(target_guids)}/{len(source_guids)} GUID values retained; geometry validity is audited separately")
+        if folder.name == 'hanim':
+            inspect_hanim_pair(folder, chapter, checks)
+        result['chapters'][folder.name] = chapter
+    counts = Counter(c['status'] for ch in (*result['chapters'].values(), *result['inputs'].values()) for c in ch['checks'])
+    if not directories:
+        counts['fail'] += 1
+    result['summary'] = {"chapter_count": len(directories), "input_count": len(result['inputs']),
+                         **{key: counts[key] for key in ('pass', 'warn', 'fail', 'not_run')},
+                         "all_required_checks_passed": bool(directories) and not counts['fail'] and not counts['not_run'],
+                         "scope": "Format validity, offline dependencies and reopenability only; semantic and visual preservation are separate checks"}
+    return result
+
+
+class AuditSelfTests(unittest.TestCase):
+    def test_truncated_and_false_length_glb_do_not_pass(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'bad.glb'
+            for data in (b'glTF', struct.pack('<4sIIII', b'glTF', 2, 1000, 0, 0)):
+                path.write_bytes(data)
+                with self.assertRaises(ValueError):
+                    read_glb_json(path)
+
+    def test_wrong_version_and_empty_x3d_do_not_pass(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'bad.x3d'
+            path.write_text('<X3D version="3.3"><Scene/></X3D>')
+            checks = []
+            inspect_x3d(path, Path(directory), checks)
+            self.assertEqual([c['status'] for c in checks[:2]], ['fail', 'fail'])
+
+    def test_resource_fallback_and_package_boundary(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            (root / 'valid.glb').write_bytes(b'fixture')
+            self.assertEqual(local_asset(root, 'missing.glb', root)[0], 'missing')
+            self.assertEqual(local_asset(root, 'valid.glb', root)[0], 'local')
+            self.assertEqual(local_asset(root, '../outside.glb', root)[0], 'escape')
+            self.assertEqual(local_asset(root, 'https://invalid.example/a.glb', root)[0], 'external')
+            path = root / 'fallback.x3d'
+            path.write_text('''<X3D version="4.0"><Scene><Inline url='"missing.glb" "valid.glb"'/></Scene></X3D>''')
+            checks = []
+            inspect_x3d(path, root, checks)
+            resource = next(c for c in checks if c['label'].endswith('Inline resource'))
+            self.assertEqual(resource['status'], 'pass')
+            self.assertIn('2/2', resource['detail'])
+
+    def test_out_of_range_and_nonfinite_hanim_weights_do_not_pass(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'rig.x3d'
+            for index, weight in (('3', '1'), ('0', 'nan')):
+                path.write_text('<X3D version="4.0"><Scene><HAnimHumanoid>'
+                                f'<HAnimJoint DEF="J" name="humanoid_root" skinCoordIndex="{index}" '
+                                f'skinCoordWeight="{weight}"/>'
+                                '<Coordinate point="0 0 0"/>'
+                                '</HAnimHumanoid></Scene></X3D>')
+                self.assertFalse(hanim_signature(path)['valid'])
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--assets', type=Path, default=HERE / 'web' / 'assets')
+    parser.add_argument('--repo', type=Path, default=HERE.parents[1])
+    parser.add_argument('--out', type=Path, default=HERE / 'web' / 'data' / 'audit.json')
+    parser.add_argument('--validator-path', default=os.environ.get('GLTF_VALIDATOR_PATH'))
+    parser.add_argument('--self-test', action='store_true')
+    parser.add_argument('--allow-partial', action='store_true', help='Record missing build artifacts as not_run for development only')
+    args = parser.parse_args()
+    if args.self_test:
+        suite = unittest.defaultTestLoader.loadTestsFromTestCase(AuditSelfTests)
+        return 0 if unittest.TextTestRunner(verbosity=2).run(suite).wasSuccessful() else 1
+    result = audit(args.assets, args.repo, args.validator_path, args.allow_partial)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(result, indent=2) + '\n', encoding='utf-8')
+    print(json.dumps(result['summary'], indent=2))
+    return 1 if result['summary']['fail'] else 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
