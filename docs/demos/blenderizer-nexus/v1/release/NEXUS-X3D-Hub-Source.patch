+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Rebuild original synthetic inputs, Blender exchanges and independent evidence."""
+from __future__ import annotations
+import argparse
+from pathlib import Path
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parent
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--blender', required=True, help='Supported Blender executable; release verified on 5.1.2')
+    p.add_argument('--repo', type=Path, default=ROOT.parents[1])
+    p.add_argument('--skip-render', action='store_true')
+    p.add_argument('--video', action='store_true')
+    p.add_argument('--chromium', default='/usr/bin/chromium', help='Chrome/Chromium executable for optional capture')
+    args = p.parse_args()
+    if not (ROOT / 'node_modules/gltf-validator/package.json').is_file():
+        p.error('Run npm ci in this directory first; the independent Khronos validator is required for a rebuild.')
+    assets = ROOT / 'web/assets'
+    assets.mkdir(parents=True, exist_ok=True)
+    def run(argv):
+        print('+', ' '.join(map(str, argv)), flush=True)
+        subprocess.run(list(map(str, argv)), cwd=ROOT, check=True)
+    if not (ROOT / 'web/vendor/x_ite/x_ite.min.js').is_file():
+        run([sys.executable, ROOT / 'vendor_runtime.py', '--install'])
+    run([sys.executable, ROOT / 'adapters/bim.py', '--out', assets / 'bim_input'])
+    blender = [args.blender, '-b', '--factory-startup', '--python-exit-code', '1', '--python']
+    run(blender + [ROOT / 'build_showcase.py', '--', '--repo', args.repo,
+                   '--out', assets, '--bim', assets / 'bim_input/bim_geometry.json'])
+    run(blender + [ROOT / 'build_showcase.py', '--', '--repo', args.repo,
+                   '--out', assets, '--audit-saved'])
+    run(blender + [ROOT / 'measure_instancing.py', '--', '--repo', args.repo, '--assets', assets])
+    if not args.skip_render:
+        run(blender + [ROOT / 'render_posters.py', '--', '--assets', assets])
+    run([sys.executable, ROOT / 'audit_dataset.py', '--assets', assets, '--repo', args.repo,
+         '--validator-path', ROOT / 'node_modules/gltf-validator'])
+    run([sys.executable, ROOT / 'validate_semantic.py', '--repo', args.repo])
+    run([sys.executable, ROOT / 'compose_manifest.py', '--repo', args.repo])
+    if args.video:
+        run(['node', ROOT / 'capture_reel.cjs', '--web', ROOT / 'web', '--out', ROOT / 'capture_frames',
+             '--chromium', args.chromium, '--frames', '12', '--width', '768', '--height', '480', '--disable-shadows'])
+        run([sys.executable, ROOT / 'make_reel.py', '--frames', ROOT / 'capture_frames',
+             '--out', assets / 'nexus-reel.mp4', '--fps', '3.2', '--interpolate'])
+        run([sys.executable, ROOT / 'compose_manifest.py', '--repo', args.repo])
+    print('\nBuild complete. Start the local viewer with: python serve.py')
+
+
+if __name__ == '__main__':
+    main()
