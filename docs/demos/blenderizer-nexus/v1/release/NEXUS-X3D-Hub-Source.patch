+    complete = present == set(ORDER) and not report.get('errors')
+    def route(source, target, status, detail):
+        return {'from': source, 'to': target, 'status': status, 'detail': detail}
+    built = 'pass' if complete else 'info'
+    independent = (bool(audit) and set(audit.get('chapters', {})) == present
+                   and audit.get('summary', {}).get('all_required_checks_passed', False))
+    audit_status = 'pass' if independent else 'not_run'
+    film_receipt = read(web / 'assets/nexus-reel.receipt.json', {})
+    film_capture = film_receipt.get('capture', {})
+    film_ready = ((web / 'assets/nexus-reel.mp4').is_file() and film_capture.get('complete')
+                  and {r.get('id') for r in film_capture.get('chapters', [])} == present)
+    routes = [
+        route('Blender', 'X3D 4.0', built, 'Native geometry, PBR, cameras, hierarchy and animation were exported by the pinned add-on.'),
+        route('X3D 4.0', 'Blender', built, 'Each scene was imported into a fresh Blender scene; imported.blend is supplied.'),
+        route('X3D → Blender', 'glTF / GLB', audit_status,
+              'hub.glb is exported after X3D import; official Khronos validation is recorded per file.'),
+        route('X3D → Blender', 'OpenUSD', audit_status,
+              'hub.usda is exported after X3D import and reopened with OpenUSD; this is Blender’s USD bridge.'),
+        route('IFC4', 'Blender → X3D', 'pass' if 'bim' in present else 'not_run',
+              'Actual IfcOpenShell tessellation plus element GUID/class metadata; IFC authoring semantics are not inferred from meshes.'),
+        route('IFC4', 'Bonsai', 'not_run', 'Valid IFC4 fixture supplied. Bonsai’s interactive application was not executed.'),
+        route('GLB / USD', 'Unreal Engine', 'not_run', 'Editor Python import adapter supplied. An Unreal Editor import has not been executed.'),
+        route('X3D frames', 'Video + sound', 'pass' if film_ready else 'not_run',
+              'Offline X_ITE camera/animation samples with an original deterministic synthesized score; not a real-time FPS claim.'),
+    ]
+    manifest = {
+        'schema': 'nexus-x3d-hub/playlist/1', 'title': 'NEXUS — X3D Hub Observatory', 'version': '1.0.0',
+        'synthetic': True, 'seed': 19775, 'complete': complete,
+        'repo': {'url': 'https://github.com/hagopjay/x3d-blender-io', 'commit': commit},
+        'runtime': {**report.get('runtime', {}), 'x_ite': '16.7.1'},
+        'addon': ('assets/addon/x3d_blender_io-2.6.4-cc4864c.zip'
+                  if (web / 'assets/addon/x3d_blender_io-2.6.4-cc4864c.zip').is_file() else None),
+        'chapters': chapters, 'routes': routes,
+        'video': 'assets/nexus-reel.mp4' if film_ready else None,
+        'evidence': 'data/audit.json' if audit else None,
+        'provenance': 'Original deterministic synthetic data; no LLM API or downloaded 3D assets.',
+        'limits': 'Measured routes and documented losses; successful examples are not a universal error-free claim.',
+    }
+    (web / 'data').mkdir(exist_ok=True)
+    (web / 'data/manifest.json').write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + '\n')
+    print(json.dumps({'chapters': len(chapters), 'complete': complete, 'independent_audit': bool(audit)}))
+
+
+if __name__ == '__main__':
+    main()
