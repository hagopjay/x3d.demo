+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Run the repository's Web3D x3d.py field-validation adapter on every X3D fixture."""
+import argparse
+from importlib.metadata import version
+import json
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parent
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--repo', type=Path, default=ROOT.parents[1])
+    p.add_argument('--web', type=Path, default=ROOT / 'web')
+    args = p.parse_args()
+    sys.path.insert(0, str(args.repo.resolve() / 'source'))
+    from validate import validate_with_x3d_py
+    files = {}
+    for path in sorted((args.web / 'assets').glob('*/*.x3d')):
+        result = validate_with_x3d_py(str(path))
+        if result is None:
+            raise SystemExit('The Web3D x3d package is unavailable; no semantic pass is claimed.')
+        files[path.relative_to(args.web).as_posix()] = {
+            'valid': result.valid, 'errors': result.errors, 'warnings': result.warnings}
+    report = {'schema': 'nexus-x3d-semantic/1', 'validator': 'Web3D x3d.py through repository field adapter',
+              'version': version('x3d'), 'files': files,
+              'scope': 'Node/field types and ranges in the adapter; not an appearance or runtime equivalence proof.'}
+    (args.web / 'data').mkdir(exist_ok=True)
+    (args.web / 'data/x3d-semantic-validation.json').write_text(json.dumps(report, indent=2) + '\n')
+    errors = sum(len(r['errors']) for r in files.values())
+    warnings = sum(len(r['warnings']) for r in files.values())
+    print(json.dumps({'x3d_files': len(files), 'errors': errors, 'warnings': warnings}))
+    return 1 if not files or errors else 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
