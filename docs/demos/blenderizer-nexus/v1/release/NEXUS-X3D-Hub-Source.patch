+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Launch the prebuilt NEXUS showcase locally; viewing needs only Python and a browser."""
+from __future__ import annotations
+
+import argparse
+import functools
+from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+import threading
+import webbrowser
+
+ROOT = Path(__file__).resolve().parent
+
+
+class Handler(SimpleHTTPRequestHandler):
+    extensions_map = {**SimpleHTTPRequestHandler.extensions_map,
+                      '.x3d': 'model/x3d+xml', '.glb': 'model/gltf-binary',
+                      '.gltf': 'model/gltf+json', '.wasm': 'application/wasm',
+                      '.usda': 'text/plain; charset=utf-8', '.ifc': 'application/x-step',
+                      '.json': 'application/json', '.mjs': 'text/javascript'}
+
+    def end_headers(self):
+        self.send_header('Cache-Control', 'no-cache')
+        super().end_headers()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--port', type=int, default=8765)
+    parser.add_argument('--no-browser', action='store_true')
+    args = parser.parse_args()
+    if not (ROOT / 'web/data/manifest.json').exists():
+        parser.error('The dataset is missing. Use the complete release package or run build_all.py first.')
+    server = ThreadingHTTPServer(('127.0.0.1', args.port),
+                                 functools.partial(Handler, directory=str(ROOT / 'web')))
+    url = f'http://127.0.0.1:{server.server_port}/'
+    print(f'\nNEXUS — X3D Hub Observatory\n{url}\nKeep this window open. Ctrl+C stops the server.\n', flush=True)
+    if not args.no_browser:
+        threading.Timer(0.5, lambda: webbrowser.open(url)).start()
+    try:
+        server.serve_forever()
+    except KeyboardInterrupt:
+        pass
+    finally:
+        server.server_close()
+
+
+if __name__ == '__main__':
+    main()
