+    manifest:manifestPath, web_root:web, chromium:browser.version(), width,height, frames_per_chapter:frameCount,
+    render_profile:{shadow_map_size:shadowMapSize, shadows_disabled:disableShadows, source_files_modified:false},
+    x_ite:null, user_agent:null, chapters:[], complete:false};
+  let globalFrame = 0;
