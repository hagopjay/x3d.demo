@@ -0,0 +1,480 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Deterministic, original scene designs for the NEXUS X3D hub proof of concept.
+
+Executed inside Blender. All visible scene geometry is authored here or in the
+independent X3D fixture below: no downloaded models and no inference API.
+"""
+from __future__ import annotations
+
+import json
+import math
+from pathlib import Path
+
+import bpy
+from mathutils import Vector
+
+TAU = math.tau
+NAVY = (0.018, 0.033, 0.065)
+CYAN = (0.015, 0.68, 0.76)
+GOLD = (0.93, 0.43, 0.075)
+IVORY = (0.76, 0.79, 0.75)
+
+
+def fresh(title):
+    bpy.ops.wm.read_factory_settings(use_empty=True)
+    scene = bpy.context.scene
+    scene.name = title
+    scene.frame_start, scene.frame_end = 1, 72
+    scene.render.fps = 24
+    scene.render.resolution_x, scene.render.resolution_y = 1100, 700
+    scene.render.resolution_percentage = 100
+    scene.render.image_settings.file_format = 'PNG'
+    scene.render.engine = 'CYCLES'
+    scene.cycles.device = 'CPU'
+    scene.cycles.samples = 12
+    scene.cycles.use_denoising = True
+    scene.world = bpy.data.worlds.new('NEXUS deep field')
+    scene.world.use_nodes = True
+    scene.world.node_tree.nodes['Background'].inputs['Color'].default_value = (0.045, 0.065, 0.10, 1)
+    scene.world.node_tree.nodes['Background'].inputs['Strength'].default_value = 0.35
+    scene.view_settings.view_transform = 'AgX'
+    scene['nexus_synthetic'] = True
+    scene['nexus_seed'] = 19775
+    scene['nexus_units'] = 'metres'
+    return scene
+
+
+def material(name, color, metallic=0, roughness=.4, emission=0, alpha=1):
+    mat = bpy.data.materials.new(name)
+    mat.use_nodes = True
+    mat.diffuse_color = (*color, alpha)
+    bsdf = mat.node_tree.nodes.get('Principled BSDF')
+    bsdf.inputs['Base Color'].default_value = (*color, alpha)
+    bsdf.inputs['Metallic'].default_value = metallic
+    bsdf.inputs['Roughness'].default_value = roughness
+    bsdf.inputs['Alpha'].default_value = alpha
+    if emission:
+        bsdf.inputs['Emission Color'].default_value = (*color, 1)
+        bsdf.inputs['Emission Strength'].default_value = emission
+    if alpha < 1:
+        mat.surface_render_method = 'BLENDED'
+    return mat
+
+
+def palette():
+    return {
+        'dark': material('Obsidian ceramic', NAVY, .35, .31),
+        'metal': material('Titanium / brushed', (.32, .41, .48), .88, .25),
+        'ivory': material('Porcelain / warm', IVORY, .13, .3),
+        'gold': material('Amber alloy', GOLD, .75, .22),
+        'cyan': material('Cyan signal', CYAN, .25, .25, .75),
+        'amber': material('Amber signal', GOLD, .25, .25, .65),
+    }
+
+
+def add(kind, name, mat, location=(0, 0, 0), scale=(1, 1, 1), parent=None, **kwargs):
+    getattr(bpy.ops.mesh, 'primitive_' + kind + '_add')(location=location, **kwargs)
+    obj = bpy.context.object
+    obj.name = name
+    obj.data.name = name + ' mesh'
+    obj.scale = scale
+    if mat:
+        obj.data.materials.append(mat)
+    if parent:
+        obj.parent = parent
+    if kind in {'uv_sphere', 'ico_sphere', 'torus', 'cylinder'}:
+        for face in obj.data.polygons:
+            face.use_smooth = True
+    return obj
+
+
+def box(name, mat, location, dimensions, bevel=0, parent=None):
+    obj = add('cube', name, mat, location=location, scale=tuple(v / 2 for v in dimensions), parent=parent)
+    if bevel:
+        bpy.context.view_layer.objects.active = obj
+        bpy.ops.object.transform_apply(location=False, rotation=False, scale=True)
+        modifier = obj.modifiers.new('Precision edge highlights', 'BEVEL')
+        modifier.width, modifier.segments = bevel, 2
+        bpy.ops.object.modifier_apply(modifier=modifier.name)
+        for face in obj.data.polygons:
+            face.use_smooth = False
+    return obj
+
+
+def ring(name, mat, radius, z, tube=.035, rotation=None, parent=None):
+    obj = add('torus', name, mat, location=(0, 0, z), major_radius=radius, minor_radius=tube,
+              major_segments=80, minor_segments=8, parent=parent)
+    if rotation:
+        obj.rotation_euler = rotation
+    return obj
+
+
+def empty(name, location=(0, 0, 0), parent=None):
+    obj = bpy.data.objects.new(name, None)
+    bpy.context.scene.collection.objects.link(obj)
+    obj.location = location
+    obj.parent = parent
+    return obj
+
+
+def camera(name, location, target, lens=44):
+    obj = bpy.data.objects.new(name, bpy.data.cameras.new(name))
+    bpy.context.scene.collection.objects.link(obj)
+    obj.location = location
+    obj.rotation_euler = (Vector(target) - obj.location).to_track_quat('-Z', 'Y').to_euler()
+    obj.data.lens = lens
+    obj.data.clip_end = 1000
+    obj['x3d_viewpoint_description'] = name
+    if bpy.context.scene.camera is None:
+        bpy.context.scene.camera = obj
+    return obj
+
+
+def cameras(extent=10, target=(0, 0, 2.2)):
+    return [
+        camera('01 — Hero', (extent * 1.1, -extent * 1.45, extent * .9), target),
+        camera('02 — Detail', (extent * .32, -extent * .68, extent * .45), target, 48),
+        camera('03 — Plan', (0, -.01, extent * 2.15), (0, 0, 0), 46),
+    ]
+
+
+def lighting():
+    for name, rotation, energy, color in (
+        ('Key / daylight', (.42, -.4, -.35), 2.5, (1, .88, .72)),
+        ('Rim / cool', (-.6, .5, 2.6), 1.3, (.40, .68, 1)),
+    ):
+        obj = bpy.data.objects.new(name, bpy.data.lights.new(name, 'SUN'))
+        bpy.context.scene.collection.objects.link(obj)
+        obj.rotation_euler = rotation
+        obj.data.energy, obj.data.color = energy, color
+        obj.data.angle = .15
+
+
+def stage(p, radius=7):
+    add('cylinder', 'Floating plinth / lower', p['dark'], location=(0, 0, -.38), radius=radius,
+        depth=.5, vertices=96)
+    add('cylinder', 'Floating plinth / crown', p['metal'], location=(0, 0, -.08), radius=radius * .985,
+        depth=.12, vertices=96)
+    for r in (radius * .985, radius * .86):
+        ring('Concentric wayfinding', p['cyan'], r, .015, .018)
+    for i in range(48):
+        angle = TAU * i / 48
+        obj = box(f'Instrument tick {i:02}', p['ivory'] if i % 4 == 0 else p['gold'],
+                  (radius * .93 * math.cos(angle), radius * .93 * math.sin(angle), .023),
+                  (.22 if i % 4 == 0 else .09, .025, .018))
+        obj.rotation_euler.z = angle
+
+
+def animate_rotation(obj, axis=2, revolutions=1):
+    original = obj.rotation_euler.copy()
+    for f, factor in ((1, 0), (24, 1 / 3), (48, 2 / 3), (72, 1)):
+        obj.rotation_euler = original
+        obj.rotation_euler[axis] += TAU * revolutions * factor
+        obj.keyframe_insert('rotation_euler', frame=f)
+    obj.rotation_euler = original
+
+
+def hero(folder):
+    fresh('NEXUS / The Asterion engine')
+    cameras(10)
+    p = palette()
+    stage(p)
+    add('cylinder', 'Reactor pedestal', p['dark'], location=(0, 0, .4), radius=1.65, depth=.8, vertices=64)
+    for z, r in ((.09, 1.9), (.78, 1.7), (.86, 1.48)):
+        ring('Pedestal signal band', p['amber'], r, z, .035)
+    rotor = empty('Gyroscope / root', (0, 0, 3.05))
+    core = add('ico_sphere', 'Faceted heart', p['gold'], location=(0, 0, 0), subdivisions=2,
+               radius=.95, parent=rotor)
+    for face in core.data.polygons:
+        face.use_smooth = False
+    for i, rot in enumerate(((.5, .35, 0), (1.08, -.6, 0), (.1, 1.35, .4))):
+        pivot = empty(f'Orbital assembly {i}', parent=rotor)
+        ring(f'Orbital titanium {i}', p['metal'], 1.65 + i * .28, 0, .055, rot, pivot)
+        ring(f'Orbital signal {i}', p['cyan'] if i % 2 else p['amber'], 1.74 + i * .28, 0, .018, rot, pivot)
+        animate_rotation(pivot, i % 3, (-1 if i % 2 else 1) * .5)
+    animate_rotation(rotor, 2, .5)
+    # Architectural petals and radial data posts frame the moving heart.
+    for i in range(24):
+        angle = TAU * i / 24
+        r = 4.4
+        height = 1.65 + .6 * (.5 + .5 * math.sin(angle * 3))
+        obj = box(f'Titanium petal {i:02}', p['ivory'] if i % 3 == 0 else p['dark'],
+                  (r * math.cos(angle), r * math.sin(angle), height / 2), (.24, .7, height), .055)
+        obj.rotation_euler.z = angle
+        signal = box(f'Petal telemetry {i:02}', p['cyan'],
+                     (r * math.cos(angle), r * math.sin(angle), height + .03), (.26, .74, .035))
+        signal.rotation_euler.z = angle
+    # Interaction properties are emitted as native sensors and ROUTEs, not a
+    # JavaScript imitation of the model's behavior.
+    detail = add('cylinder', 'Click / bind detail viewpoint', p['cyan'], location=(-.8, -5.8, .13),
+                 radius=.43, depth=.22, vertices=40)
+    detail['x3d_trigger'], detail['x3d_action'], detail['x3d_target'] = 'click', 'viewpoint', '02 — Detail'
+    tour = add('cylinder', 'Click / camera tour', p['amber'], location=(.8, -5.8, .13),
+               radius=.43, depth=.22, vertices=40)
+    tour['x3d_trigger'], tour['x3d_action'] = 'click', 'tour'
+    for i, cam in enumerate(o for o in bpy.context.scene.objects if o.type == 'CAMERA'):
+        cam['x3d_tour_order'], cam['x3d_tour_dwell'] = i + 1, 1.8
+    bpy.context.scene['x3d_tour_travel'] = 2.7
+    bpy.context.scene['x3d_tour_loop'] = True
+    lighting()
+    bpy.context.scene.frame_set(1)
+    return {'features': ['PhysicalMaterial PBR', 'Nested Transform hierarchy', 'Sampled animation + ROUTEs',
+                         'Emission', 'Click sensors + camera tour', 'Multiple Viewpoints', 'Mesh normals'], 'duration_seconds': 14}
+
+
+def materials(folder):
+    fresh('NEXUS / Material spectrum')
+    cameras(12, (0, 0, 1))
+    p = palette()
+    stage(p, 8.7)
+    for row in range(5):
+        for column in range(6):
+            x, y = (column - 2.5) * 2.05, (row - 2) * 2.0
+            roughness, metal = .08 + .86 * column / 5, row / 4
+            rgb = (.025 + .12 * row, .22 + .07 * row, .29 + .09 * row)
+            m = material(f'PBR / metallic {metal:.2f} / roughness {roughness:.2f}', rgb, metal, roughness)
+            add('uv_sphere', f'Swatch R{row} C{column}', m, location=(x, y, 1.0), radius=.72,
+                segments=28, ring_count=16)
+            add('cylinder', f'Swatch foot R{row} C{column}', p['dark'], location=(x, y, .13),
+                radius=.8, depth=.24, vertices=28)
+    # A real generated bitmap exercises image+UV I/O, rather than an unsupported procedural texture.
+    image = bpy.data.images.new('NEXUS woven calibration', width=64, height=64)
+    pixels = []
+    for y in range(64):
+        for x in range(64):
+            c = CYAN if ((x // 8 + y // 8) % 2) else IVORY
+            pixels.extend((*c, 1))
+    image.pixels[:] = pixels
+    image.file_format = 'PNG'
+    image.filepath_raw = str(folder / 'woven-calibration.png')
+    image.save()
+    m = material('ImageTexture / UV calibration', (1, 1, 1), .1, .55)
+    texture = m.node_tree.nodes.new('ShaderNodeTexImage')
+    texture.image = image
+    m.node_tree.links.new(texture.outputs['Color'], m.node_tree.nodes['Principled BSDF'].inputs['Base Color'])
+    box('UV calibration block', m, (0, -6.2, .6), (4.0, 1.1, 1.1), .08)
+    lighting()
+    return {'features': ['30 PBR combinations', 'Metallic / roughness sweep', 'PhysicalMaterial',
+                         'Generated ImageTexture', 'TextureCoordinate UVs', 'Material identity'], 'duration_seconds': 14}
+
+
+def instances(folder):
+    fresh('NEXUS / Instance metropolis')
+    cameras(17, (0, 0, 1))
+    p = palette()
+    stage(p, 11)
+    prototype = box('Shared module 000', p['metal'], (0, 0, .5), (.77, .77, 1), .07)
+    data = prototype.data
+    for row in range(12):
+        for col in range(12):
+            index = row * 12 + col
+            obj = prototype if index == 0 else bpy.data.objects.new(f'Shared module {index:03}', data)
+            if index:
+                bpy.context.scene.collection.objects.link(obj)
+            x, y = (col - 5.5) * 1.22, (row - 5.5) * 1.22
+            height = .45 + 3.3 * (.5 + .5 * math.cos(math.hypot(x, y) * .7))
+            obj.location, obj.scale = (x, y, height / 2), (1, 1, height)
+            obj.rotation_euler.z = .12 * math.sin(col + row)
+    for row in range(12):
+        stripe = box(f'Data boulevard {row}', p['cyan'] if row % 2 else p['amber'],
+                     (0, (row - 5.5) * 1.22 - .51, .02), (14.6, .025, .028))
+    lighting()
+    return {'features': ['144 linked mesh users', 'Geometry DEF / USE', 'Per-instance transforms',
+                         'Deterministic synthetic city', 'Shared materials', 'USD / GLB exchange'], 'duration_seconds': 13}
+
+
+def hanim(folder):
+    """A deliberately partial H-Anim rig: a weighted three-joint mechanical limb."""
+    fresh('NEXUS / Articulated motion study')
+    cameras(8, (0, 0, 2.5))
+    p = palette()
+    stage(p, 5.5)
+    for z, r in ((.1, 1.7), (.32, 1.45), (.5, 1.18)):
+        add('cylinder', 'Motion pedestal', p['dark'], location=(0, 0, z), radius=r, depth=.23, vertices=64)
+        ring('Motion pedestal signal', p['cyan'], r, z + .12, .025)
+    bpy.ops.object.armature_add(enter_editmode=True, location=(0, 0, .6))
+    rig = bpy.context.object
+    rig.name, rig.data.name = 'Articulation study', 'Three-joint partial skeleton'
+    names = ('humanoid_root', 'l_acromioclavicular', 'l_elbow')
+    bones = rig.data.edit_bones
+    for index, name in enumerate(names):
+        bone = bones[0] if index == 0 else bones.new(name)
+        bone.name = name
+        bone.head, bone.tail = (0, 0, index * 1.6), (0, 0, (index + 1) * 1.6)
+        if index:
+            bone.parent, bone.use_connect = bones[names[index - 1]], True
+    bpy.ops.object.mode_set(mode='OBJECT')
+    rig['x3d_hanim_names'] = 'standard'
+    rig['nexus_rig_scope'] = 'Partial three-joint motion study; no humanoid LOA conformance claim'
+    vertices, faces = [], []
+    n, sides = 25, 12
+    for row in range(n):
+        z = row * 4.8 / (n - 1)
+        joint_distance = min(abs(z - 1.6), abs(z - 3.2))
+        radius = .25 if joint_distance < .25 else .4
+        for side in range(sides):
+            angle = TAU * side / sides
+            vertices.append((radius * math.cos(angle), radius * math.sin(angle), z))
+    for row in range(n - 1):
+        for side in range(sides):
+            faces.append((row * sides + side, row * sides + (side + 1) % sides,
+                          (row + 1) * sides + (side + 1) % sides, (row + 1) * sides + side))
+    faces += [tuple(reversed(range(sides))), tuple((n - 1) * sides + s for s in range(sides))]
+    mesh = bpy.data.meshes.new('Weighted segmented shell')
+    mesh.from_pydata(vertices, [], faces)
+    mesh.update()
+    shell = bpy.data.objects.new('Articulated shell', mesh)
+    bpy.context.scene.collection.objects.link(shell)
+    shell.parent = rig
+    for m in (p['ivory'], p['gold'], p['cyan']):
+        mesh.materials.append(m)
+    for polygon in mesh.polygons:
+        polygon.material_index = 2 if polygon.index % sides in {0, 1} else (polygon.index // (sides * 8)) % 2
+        polygon.use_smooth = True
+    groups = [shell.vertex_groups.new(name=name) for name in names]
+    for vertex in mesh.vertices:
+        z = vertex.co.z
+        position = max(0, min(2, (z - .8) / 1.6))
+        lower = int(position)
+        upper = min(2, lower + 1)
+        weight = position - lower
+        groups[lower].add([vertex.index], 1 - weight, 'REPLACE')
+        if upper != lower and weight > 0:
+            groups[upper].add([vertex.index], weight, 'REPLACE')
+    modifier = shell.modifiers.new('Three-joint skin deformation', 'ARMATURE')
+    modifier.object = rig
+    for name, angle in (('l_acromioclavicular', -.8), ('l_elbow', 1.05)):
+        bone = rig.pose.bones[name]
+        bone.rotation_mode = 'XYZ'
+        for frame, scale in ((1, 0), (24, .7), (48, 1), (72, 0)):
+            bone.rotation_euler = (angle * scale, .25 * scale, 0)
+            bone.keyframe_insert('rotation_euler', frame=frame)
+    for i in range(3):
+        angle = TAU * i / 3
+        ring_obj = ring('Rig diagnostic arc', p['metal'], 2.8 + i * .28, 2.2,
+                        .025, (math.pi / 2, 0, angle))
+    lighting()
+    bpy.context.scene.frame_set(1)
+    return {'features': ['H-Anim 2.0 partial rig', 'Three weighted joints', 'Skin weights',
+                         'Joint animation ROUTEs', 'Editable reconstructed armature', 'No LOA conformance claim'],
+            'duration_seconds': 14}
+
+
+def turbine(folder):
+    fresh('NEXUS / Referenced turbine asset')
+    p = palette()
+    core = add('cylinder', 'Turbine spindle', p['metal'], location=(0, 0, .65), radius=.4, depth=1.3, vertices=32)
+    add('ico_sphere', 'Turbine cap', p['gold'], location=(0, 0, 1.4), radius=.5, subdivisions=2)
+    for i in range(9):
+        angle = TAU * i / 9
+        obj = box(f'Turbine blade {i}', p['cyan'] if i % 3 == 0 else p['ivory'],
+                  (.85 * math.cos(angle), .85 * math.sin(angle), .9), (1.5, .2, .16), .045)
+        obj.rotation_euler = (.25, .12, angle + .3)
+    return core
+
+
+def bim_geometry(path, folder):
+    fresh('NEXUS / Open design pavilion')
+    cameras(15, (0, 0, 1.6))
+    p = palette()
+    stage(p, 10)
+    payload = json.loads(Path(path).read_text())
+    elements = payload['elements'] if isinstance(payload, dict) else payload
+    origin = payload.get('display_origin', (0, 0, 0)) if isinstance(payload, dict) else (0, 0, 0)
+    for e in elements:
+        mesh = bpy.data.meshes.new(e['name'] + ' / IFC mesh')
+        mesh.from_pydata(e['vertices'], [], e['faces'])
+        mesh.update()
+        obj = bpy.data.objects.new(e['name'], mesh)
+        bpy.context.scene.collection.objects.link(obj)
+        obj.location = tuple(-float(v) for v in origin)
+        cls = e.get('ifc_type', 'IfcBuildingElement')
+        color = e.get('color', IVORY)
+        mesh.materials.append(material(cls + '/' + e['id'][:8], color[:3], .45 if 'Beam' in cls else .12, .34))
+        obj['ifc_guid'], obj['ifc_class'] = e['id'], cls
+        metadata = [
+            {'node': 'MetadataString', 'name': 'GlobalId', 'value': '"' + e['id'] + '"'},
+            {'node': 'MetadataString', 'name': 'IfcClass', 'value': '"' + cls + '"'},
+        ]
+        for key, value in e.get('properties', {}).items():
+            obj['ifc_' + key] = value if isinstance(value, (int, float, str, bool)) else json.dumps(value)
+            if isinstance(value, (int, float)) and not isinstance(value, bool):
+                metadata.append({'node': 'MetadataDouble', 'name': key, 'value': str(value)})
+            else:
+                metadata.append({'node': 'MetadataString', 'name': key,
+                                 'value': json.dumps(str(value))})
+        obj['x3d_metadata'] = {'node': 'MetadataSet', 'name': 'IFC identity', 'value': metadata}
+    lighting()
+    return {'features': ['Real IFC4 geometry ingestion', 'Persistent GlobalId', 'Building element classes',
+                         'X3D MetadataSet', 'Blender editability', 'Bonsai-ready IFC'], 'duration_seconds': 15}
+
+
+def _axis_angle_look(position, target):
+    q = (Vector(target) - Vector(position)).to_track_quat('-Z', 'Y')
+    axis, angle = q.to_axis_angle()
+    return ' '.join(f'{v:.8g}' for v in (*axis, angle))
+
+
+def _torus_xml(radius, tube=.035, color='0.01 0.65 0.72'):
+    vertices, faces = [], []
+    n, m = 64, 6
+    for i in range(n):
+        a = TAU * i / n
+        for j in range(m):
+            b = TAU * j / m
+            vertices.extend(((radius + tube * math.cos(b)) * math.cos(a), tube * math.sin(b),
+                             (radius + tube * math.cos(b)) * math.sin(a)))
+            faces.extend((i * m + j, ((i + 1) % n) * m + j,
+                          ((i + 1) % n) * m + (j + 1) % m, i * m + (j + 1) % m, -1))
