+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Compose the public playlist only from generated scenes and recorded evidence."""
+from __future__ import annotations
+import argparse
+import copy
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+
+ROOT = Path(__file__).resolve().parent
+ORDER = ['foundry', 'materials', 'instances', 'x3d_ingress', 'federation', 'bim', 'usd', 'hanim']
+
+
+def read(path, default=None):
+    return json.loads(path.read_text()) if path.is_file() else default
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--web', type=Path, default=ROOT / 'web')
+    p.add_argument('--repo', type=Path, default=ROOT.parents[1])
+    p.add_argument('--allow-partial', action='store_true', help='Development preview only')
+    args = p.parse_args()
+    web = args.web.resolve()
+    report = read(web / 'assets/builder_report.json')
+    if not report:
+        p.error('Run build_showcase.py first; no generated dataset exists.')
+    chapters = copy.deepcopy(report.get('chapters', []))
+    chapters.sort(key=lambda c: ORDER.index(c['id']))
+    present = {c['id'] for c in chapters}
+    if (set(ORDER) != present or report.get('errors')) and not args.allow_partial:
+        p.error(f'Dataset is incomplete: missing {set(ORDER) - present}; errors {report.get("errors")}')
+    audit = read(web / 'data/audit.json', {})
+    semantic = read(web / 'data/x3d-semantic-validation.json', {})
+    sensors = read(web / 'data/browser-sensors.json', {})
+    sensor_source = sensors.get('source', {})
+    sensor_hash = sensors.get('source_sha256') or (sensor_source.get('sha256') if isinstance(sensor_source, dict) else None)
+    for chapter in chapters:
+        cid = chapter['id']
+        folder = web / 'assets' / cid
+        chapter['checks'] = [c for c in chapter['checks'] if c['label'] != 'Unreal / Bonsai editor']
+        ach = audit.get('chapters', {}).get(cid, {})
+        chapter['checks'].extend(ach.get('checks', []))
+        validated = [r for key, r in semantic.get('files', {}).items() if key.startswith(f'assets/{cid}/')]
+        if validated:
+            nerrors = sum(len(r['errors']) for r in validated)
+            nwarnings = sum(len(r['warnings']) for r in validated)
+            chapter['checks'].append({'label': 'Web3D field validation',
+                                      'status': 'fail' if nerrors else 'warn' if nwarnings else 'pass',
+                                      'detail': f'{len(validated)} X3D files; {nerrors} field errors; {nwarnings} warnings. '
+                                                'Official x3d.py through the repository adapter.'})
+        if not ach:
+            chapter['checks'].append({'label': 'Independent format audit', 'status': 'not_run',
+                                      'detail': 'Audit evidence has not been generated for this build.'})
+        downloads = chapter.setdefault('downloads', {})
+        if (cid == 'foundry' and sensors.get('status') == 'pass'
+                and hashlib.sha256((web / chapter['x3d']).read_bytes()).hexdigest() == sensor_hash):
+            chapter['checks'].append({'label': 'Native X3D click controls', 'status': 'pass',
+                                      'detail': 'Real mouse clicks bound the Detail viewpoint and activated the Tour timer. '
+                                                'No Sensor fields were assigned by the test.'})
+            downloads['sensor_evidence'] = 'data/browser-sensors.json'
+        motion = read(folder / 'motion-evidence.json', {})
+        if motion and chapter.get('metrics', {}).get('animated_objects', 0):
+            source_clock, imported_clock = motion['source'], motion['imported']
+            source_duration = (source_clock['frame_end'] - source_clock['frame_start']) / source_clock['fps']
+            imported_duration = (imported_clock['frame_end'] - imported_clock['frame_start']) / imported_clock['fps']
+            if abs(source_duration - imported_duration) > 1 / source_clock['fps']:
+                chapter['checks'].append({'label': 'Multiple clock scope', 'status': 'warn',
+                                          'detail': f'Source range {source_duration:.3f}s; imported range {imported_duration:.3f}s '
+                                                    'includes the camera tour. Motion was compared at equal seconds over '
+                                                    'the source interval; long-running loop parity is not established.'})
+        for key, name in [('x3d', 'scene.x3d'), ('roundtrip_x3d', 'roundtrip.x3d'),
+                          ('imported_blend', 'imported.blend'), ('evidence', 'evidence.json'),
+                          ('motion_evidence', 'motion-evidence.json'), ('skin_evidence', 'skin-motion-evidence.json')]:
+            if (folder / name).is_file():
