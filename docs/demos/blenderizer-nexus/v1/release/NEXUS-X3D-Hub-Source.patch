+        const timerNames = [...xml.matchAll(/<TimeSensor\b[^>]*\bDEF\s*=\s*["']([^"']+)["'][^>]*>/g)].map(m=>m[1]);
+        const interpolators = [...xml.matchAll(/<(?:Position|Orientation|Scale|Scalar|Coordinate|Color)Interpolator\b[^>]*\bDEF\s*=\s*["']([^"']+)["'][^>]*>/g)].map(m=>m[1]);
+        const lightNames = [...xml.matchAll(/<(?:Directional|Point|Spot)Light\b[^>]*\bDEF\s*=\s*["']([^"']+)["'][^>]*>/g)].map(m=>m[1]);
+        await page.evaluate(async ({chapter,index,total,url,viewpoint,timerNames,interpolators,lightNames,shadowMapSize,disableShadows,xml}) => {
+          const b = X3D.getBrowser(document.getElementById('scene'));
+          b.setBrowserOption('StraightenHorizon', false);
+          await Promise.race([b.loadURL(new X3D.MFString(url)), new Promise((_,reject)=>setTimeout(()=>reject(Error('X3D load exceeded 90 seconds')),90000))]);
+          const vp = b.currentScene.getNamedNode(viewpoint);
+          vp.set_bind = true;
+          for (const name of timerNames) b.currentScene.getNamedNode(name).enabled = false;
+          for (const name of lightNames) {
+            const light=b.currentScene.getNamedNode(name);light.shadowMapSize=shadowMapSize;
+            if(disableShadows)light.shadows=false;
+          }
