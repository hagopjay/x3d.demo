+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Build NEXUS synthetic scenes and measure real Blender ↔ X3D 4.0 exchanges.
+
+blender -b --factory-startup --python build_showcase.py -- --repo REPO --out WEB/assets \
+    [--bim /path/bim_geometry.json] [--render-posters] [--chapters foundry,materials]
+
+No LLM, service key, downloaded model, or network access is needed by the builder.
+The browser runtime is vendored separately. Results are evidence, not universal
+format-equivalence claims. Every scene remains editable as a .blend file.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import importlib
+import json
+import math
+from pathlib import Path
+import shutil
+import sys
+import tempfile
+import time
+import traceback
+import xml.etree.ElementTree as ET
+
+import bpy
+from mathutils import Vector
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+import scene_generators as scenes
+
+CHAPTERS = [
+    ('foundry', 'The Asterion engine', '01 / BLENDER → X3D',
+     'A kinetic jewel built in Blender becomes native X3D geometry, PBR materials and timed ROUTEs.', 'Blender'),
+    ('materials', 'The material spectrum', '02 / LOOK DEVELOPMENT',
+     'Thirty measured metallic–roughness combinations and a generated UV calibration texture cross the hub.', 'Blender'),
+    ('instances', 'One mesh. A metropolis.', '03 / IDENTITY & REUSE',
+     'A deterministic city of 144 linked modules proves geometry reuse instead of merely showing repeated objects.', 'Blender'),
+    ('x3d_ingress', 'The return journey', '04 / X3D → BLENDER → X3D',
+     'An independently authored X3D source brings hierarchy, shared definitions and ROUTE animation into editable Blender data.', 'X3D'),
+    ('federation', 'A scene of references', '05 / GLB → INLINE → BLENDER',
+     'One generated glTF binary is referenced three times by X3D Inline, then reconstructed by the Blender hub.', 'glTF / GLB'),
+    ('bim', 'Open design pavilion', '06 / IFC → BLENDER → X3D',
+     'Synthetic IFC4 building elements become actual Blender meshes; GlobalId and class accompany their web geometry.', 'IFC4'),
+    ('usd', 'The studio interchange', '07 / USD → BLENDER → X3D',
+     'A real USD export is reopened through Blender and published as X3D, making the DCC handoff inspectable.', 'OpenUSD'),
+    ('hanim', 'The articulated study', '08 / H-ANIM & SKINNING',
+     'A partial three-joint mechanical limb carries real skin weights and joint animation into H-Anim 2.0, then returns as an editable armature.', 'Blender armature'),
+]
+
+
+def operator_finished(result, label):
+    if result != {'FINISHED'}:
+        raise RuntimeError(f'{label}: {result}')
+
+
+def register(repo):
+    package = Path(tempfile.mkdtemp(prefix='nexus-addon-')) / 'io_scene_x3d'
+    try:
+        package.symlink_to(repo / 'source', target_is_directory=True)
+    except OSError:  # Windows without developer-mode symlink permission
+        shutil.copytree(repo / 'source', package)
+    sys.path.insert(0, str(package.parent))
+    importlib.import_module('io_scene_x3d').register()
+    sys.path.insert(0, str(repo / 'source'))
+    sys.path.insert(0, str(repo / 'tools' / 'io_sync'))
+
+
+def export_x3d(path, title, animation=True):
+    bpy.context.scene.frame_set(bpy.context.scene.frame_start)
+    bpy.context.view_layer.update()
+    operator_finished(bpy.ops.export_scene.x3d(
+        filepath=str(path), x3d_version='X3D40', use_selection=False, use_hierarchy=True,
+        use_animation=animation, use_normals=True, path_mode='COPY',
+        meta_title=title, meta_creator='NEXUS synthetic dataset',
+        meta_description='Measured Blender/X3D hub demonstration; original synthetic geometry.'), 'X3D export')
+
+
+def snapshot():
+    scene = bpy.context.scene
+    scene.frame_set(scene.frame_start)
+    bpy.context.view_layer.update()
+    obs = list(scene.objects)
+    meshes = [o for o in obs if o.type == 'MESH']
+    bounds = [o.matrix_world @ Vector(c) for o in meshes for c in o.bound_box]
+    mins = [min(v[i] for v in bounds) for i in range(3)] if bounds else [0, 0, 0]
+    maxs = [max(v[i] for v in bounds) for i in range(3)] if bounds else [0, 0, 0]
+    evaluated = bpy.context.evaluated_depsgraph_get()
+    vertices = triangles = 0
+    for o in meshes:
+        evaluated_ob = o.evaluated_get(evaluated)
+        mesh = evaluated_ob.to_mesh()
+        try:
+            mesh.calc_loop_triangles()
+            vertices += len(mesh.vertices)
+            triangles += len(mesh.loop_triangles)
+        finally:
+            evaluated_ob.to_mesh_clear()
+    users = Counter(o.data.as_pointer() for o in meshes)
+    ifc_guids = []
+    for ob in obs:
+        if ob.get('ifc_guid'):
+            ifc_guids.append(ob['ifc_guid'])
+            continue
+        metadata = ob.get('x3d_metadata')
+        if hasattr(metadata, 'get'):
+            for member in metadata.get('value', []):
+                if hasattr(member, 'get') and member.get('name') == 'GlobalId':
+                    ifc_guids.append(member.get('value', '').strip('"'))
+    return {'objects': len(obs), 'meshes': len(meshes), 'unique_meshes': len(users),
+            'vertices': vertices, 'triangles': triangles,
+            'materials': len({m.as_pointer() for o in meshes for m in o.data.materials if m}),
+            'shared_mesh_users': sum(n for n in users.values() if n > 1),
+            'bounds_min': [round(v, 6) for v in mins], 'bounds_max': [round(v, 6) for v in maxs],
+            'animated_objects': sum(bool(o.animation_data and o.animation_data.action) for o in obs),
+            'ifc_guids': sorted(ifc_guids),
+            'camera_labels': [o.get('x3d_viewpoint_description', o.name) for o in obs if o.type == 'CAMERA']}
+
+
+def portable_blend(path):
+    bpy.context.preferences.filepaths.save_version = 0
+    operator_finished(bpy.ops.wm.save_as_mainfile(filepath=str(path), compress=True), 'Blender save')
+    bpy.ops.file.pack_all()
+    bpy.ops.file.make_paths_relative()
+    operator_finished(bpy.ops.wm.save_as_mainfile(filepath=str(path), compress=True), 'Portable Blender save')
+
+
+def independent_animation_check():
+    """The hand-authored source's lift is known independently of its re-export."""
+    scene = bpy.context.scene
+    frame = scene.frame_start + (scene.frame_end - scene.frame_start) / 2
+    scene.frame_set(int(frame), subframe=frame % 1)
+    bpy.context.view_layer.update()
+    found = []
+    for ob in scene.objects:
+        if ob.type == 'MESH' and ob.parent and ob.parent.get('x3d_def') in {'LeftParent', 'RightParent'}:
+            found.append(tuple(ob.matrix_world.translation))
+    # Source X3D Y-up lift from y=1.4 to y=2.4 becomes Blender Z=2.4.
+    expected = [(-3.7, 0, 2.4), (3.7, 0, 2.4)]
+    error = max((min((Vector(got) - Vector(want)).length for got in found) for want in expected), default=math.inf)
+    scene.frame_set(scene.frame_start)
+    return {'label': 'Independent animation endpoints', 'status': 'pass' if error < .002 else 'warn',
+            'detail': f'Both reused modules reach expected midpoint height 2.4 m; maximum sampled error {error:.6g} m.',
+            'expected_world_midpoint': expected, 'observed_world_midpoint': found}
+
+
+def sample_world_transforms(imported=False, source_timing=None):
+    """Sample the fixture's collision-free rigid-object identities, not allocation order.
+
+    The source side predicts the modern writer's documented OB_ name allocation;
+    the imported side uses preserved source DEF identity. This is deliberately a
+    fixture oracle, not a proposed general scene-equivalence implementation.
+    """
+    from emit_x3d40 import _safe_name
+    scene = bpy.context.scene
+    samples, unique = {}, True
+    duration = ((source_timing['frame_end'] - source_timing['frame_start']) / source_timing['fps']
+                if source_timing else (scene.frame_end - scene.frame_start) / scene.render.fps)
+    for fraction in (0.0, .25, .5, .75, 1.0):
+        frame = scene.frame_start + fraction * duration * scene.render.fps
+        scene.frame_set(int(frame), subframe=frame % 1)
+        bpy.context.view_layer.update()
+        samples[fraction] = {}
+        for obj in scene.objects:
+            if obj.type not in {'MESH', 'EMPTY'}:
+                continue
+            if obj.type == 'MESH' and any(m.type == 'ARMATURE' for m in obj.modifiers):
+                continue  # deformed skin is measured separately; it has no standalone exported Transform
+            key = 'OB_' + _safe_name(obj.name)
+            if imported:
+                key = obj.get('x3d_def', key)
+            if key in samples[fraction]:
+                unique = False
+            samples[fraction][key] = [float(v) for row in obj.matrix_world for v in row]
+    scene.frame_set(scene.frame_start)
+    return {'samples': samples, 'identities_unique': unique,
+            'frame_start': scene.frame_start, 'frame_end': scene.frame_end, 'fps': scene.render.fps,
+            'sampled_duration_seconds': duration}
+
+
+def motion_evidence(folder, source, imported):
+    a, b = source['samples'], imported['samples']
+    source_ids, imported_ids = set(a[0.0]), set(b[0.0])
+    common = source_ids & imported_ids
+    worst, translation = 0.0, 0.0
+    worst_identity = None
+    for phase in a:
+        for name in common:
+            left, right = a[phase][name], b[phase][name]
+            error = max(abs(x - y) for x, y in zip(left, right))
+            translation = max(translation, math.sqrt(sum((left[i] - right[i]) ** 2 for i in (3, 7, 11))))
+            if error > worst:
+                worst, worst_identity = error, {'name': name, 'phase': phase}
+    complete = bool(source_ids) and common == source_ids and source['identities_unique'] and imported['identities_unique']
+    record = {'schema': 'nexus/world-motion/1', 'fractions': list(a), 'source_transform_count': len(source_ids),
+              'imported_transform_count': len(imported_ids), 'matched_transform_count': len(common),
+              'missing_source_identities': sorted(source_ids - imported_ids),
+              'additional_imported_identities': sorted(imported_ids - source_ids),
+              'complete_source_coverage': complete, 'max_matrix_component_error': worst,
+              'max_translation_error_m': translation, 'worst_identity': worst_identity,
+              'source': source, 'imported': imported}
+    (folder / 'motion-evidence.json').write_text(json.dumps(record, indent=2))
+    return {'label': 'Sampled world transforms',
+            'status': 'pass' if complete and worst < .002 and translation < .002 else 'warn',
+            'detail': f'{len(common)}/{len(source_ids)} rigid identities at five source-interval phases, equal elapsed seconds; '
+                      f'max matrix-component error {worst:.6g}, translation {translation:.6g} m.'}
+
+
+def flatten_ifc_metadata():
+    """Showcase adapter: promote X3D metadata to scalar properties for USD extras.
+
+    Blender's USD writer supports scalar custom properties, whereas a nested
+    X3D MetadataSet is not automatically serialized as equivalent USD metadata.
+    The original nested X3D record is retained alongside these explicit copies.
+    """
+    count = 0
+    for obj in bpy.context.scene.objects:
+        metadata = obj.get('x3d_metadata')
+        if not hasattr(metadata, 'get'):
+            continue
+        members = metadata.get('value', [])
+        if not any(hasattr(m, 'get') and m.get('name') == 'GlobalId' for m in members):
+            continue
+        for member in members:
+            if not hasattr(member, 'get') or not member.get('name'):
+                continue
+            value = member.get('value', '')
+            if member.get('node') == 'MetadataDouble':
+                try:
+                    value = float(value)
+                except (TypeError, ValueError):
+                    continue
+            else:
+                try:
+                    value = json.loads(value)
+                except (ValueError, TypeError):
+                    value = str(value).strip('"')
+            name = member['name']
+            prop = {'GlobalId': 'ifc_guid', 'IfcClass': 'ifc_class'}.get(name, 'ifc_' + name)
+            obj[prop] = value
+        obj['nexus_metadata_adapter'] = 'X3D MetadataSet → scalar IFC custom properties'
+        count += 1
+    return count
+
+
+def sample_skin_motion(source_timing=None):
+    scene = bpy.context.scene
+    rigs = [obj for obj in scene.objects if obj.type == 'ARMATURE']
+    skins = [obj for obj in scene.objects if obj.type == 'MESH' and any(m.type == 'ARMATURE' for m in obj.modifiers)]
+    duration = ((source_timing['frame_end'] - source_timing['frame_start']) / source_timing['fps']
+                if source_timing else (scene.frame_end - scene.frame_start) / scene.render.fps)
+    result = {'armatures': len(rigs), 'skin_objects': len(skins), 'samples': {},
+              'frame_start': scene.frame_start, 'frame_end': scene.frame_end, 'fps': scene.render.fps,
+              'sampled_duration_seconds': duration}
+    for phase in (0.0, .25, .5, .75, 1.0):
+        frame = scene.frame_start + phase * duration * scene.render.fps
+        scene.frame_set(int(frame), subframe=frame % 1)
+        bpy.context.view_layer.update()
+        bones = {bone.name: list(rig.matrix_world @ bone.head) for rig in rigs for bone in rig.pose.bones}
+        points = []
+        for skin in skins:
+            evaluated = skin.evaluated_get(bpy.context.evaluated_depsgraph_get())
+            mesh = evaluated.to_mesh()
+            try:
+                points.extend(skin.matrix_world @ v.co for v in mesh.vertices)
+            finally:
+                evaluated.to_mesh_clear()
+        bounds = [[min(v[i] for v in points) for i in range(3)],
+                  [max(v[i] for v in points) for i in range(3)]] if points else []
+        result['samples'][phase] = {'joint_centres': bones, 'deformed_skin_bounds': bounds}
+    scene.frame_set(scene.frame_start)
+    return result
+
+
+def skin_evidence(folder, source, imported):
+    complete = bool(source['skin_objects']) and bool(imported['skin_objects'])
+    max_joint, max_bounds = 0.0, 0.0
+    for phase, a in source['samples'].items():
+        b = imported['samples'][phase]
+        complete = complete and set(a['joint_centres']) == set(b['joint_centres'])
+        for name in set(a['joint_centres']) & set(b['joint_centres']):
+            max_joint = max(max_joint, (Vector(a['joint_centres'][name]) - Vector(b['joint_centres'][name])).length)
+        if not a['deformed_skin_bounds'] or not b['deformed_skin_bounds']:
+            complete = False
+        else:
+            max_bounds = max(max_bounds, max(abs(x - y) for av, bv in
+                zip(a['deformed_skin_bounds'], b['deformed_skin_bounds']) for x, y in zip(av, bv)))
+    record = {'schema': 'nexus/skin-motion/1', 'source': source, 'imported': imported,
+              'joint_identity_coverage_complete': complete, 'max_joint_centre_error_m': max_joint,
+              'max_deformed_skin_bounds_error_m': max_bounds,
+              'scope': 'Three-joint partial rig; five sampled joint centres and deformed skin bounds; not full vertex equality or humanoid LOA conformance.'}
+    (folder / 'skin-motion-evidence.json').write_text(json.dumps(record, indent=2))
+    return {'label': 'Sampled H-Anim skin motion',
+            'status': 'pass' if complete and max_joint < .002 and max_bounds < .002 else 'warn',
+            'detail': f'{source["armatures"]} partial rig, five times; joint-centre error {max_joint:.6g} m; '
+                      f'deformed-skin bound error {max_bounds:.6g} m. No LOA claim.'}
+
+
+def render_poster(path):
+    scene = bpy.context.scene
+    if scene.camera is None:
+        cams = [o for o in scene.objects if o.type == 'CAMERA']
+        scene.camera = cams[0] if cams else scenes.camera('01 — Hero', (14, -20, 13), (0, 0, 2))
+    scene.render.engine = 'CYCLES'
+    scene.cycles.device, scene.cycles.samples = 'CPU', 12
+    scene.cycles.use_denoising = True
+    scene.render.resolution_x, scene.render.resolution_y = 1100, 700
+    scene.render.resolution_percentage = 100
+    scene.render.image_settings.file_format = 'PNG'
+    scene.render.filepath = str(path)
+    bpy.ops.render.render(write_still=True)
+
+
+def configure_import_render():
+    scene = bpy.context.scene
+    scene.render.resolution_x, scene.render.resolution_y = 1100, 700
+    scene.render.resolution_percentage = 100
+    scene.render.fps = 24
+    scene.render.engine = 'CYCLES'
+    scene.cycles.samples = 12
+    if scene.world:
+        scene.world.use_nodes = True
+        world = scene.world.node_tree.nodes.get('Background')
+        if world:
+            world.inputs['Strength'].default_value = .4
+    cams = [o for o in scene.objects if o.type == 'CAMERA']
+    if cams:
+        scene.camera = cams[0]
+
+
+def native_outputs(folder, title, checks, prefix='scene'):
+    downloads = {'blend': str(folder / 'scene.blend')}
+    # glTF and USD are Blender's own interchange implementations, not claims of
+    # native add-on support for those formats.
+    try:
+        operator_finished(bpy.ops.export_scene.gltf(filepath=str(folder / (prefix + '.glb')), export_format='GLB',
+                                                   export_extras=True, export_animations=True), 'GLB export')
+        downloads['glb'] = str(folder / (prefix + '.glb'))
+        checks.append({'label': ('X3D ingress → GLB' if prefix == 'hub' else 'Native glTF / GLB written'), 'status': 'pass',
+                       'detail': 'Blender glTF exporter completed; Khronos validation is a separate check.'})
+    except Exception as error:
+        checks.append({'label': 'GLB export', 'status': 'warn', 'detail': str(error)})
+    try:
+        operator_finished(bpy.ops.wm.usd_export(filepath=str(folder / (prefix + '.usda')),
+                                               export_materials=True, export_animation=True,
+                                               export_custom_properties=True), 'USD export')
+        downloads['usd'] = str(folder / (prefix + '.usda'))
+        checks.append({'label': ('X3D ingress → OpenUSD' if prefix == 'hub' else 'Native OpenUSD written'), 'status': 'pass',
+                       'detail': 'Blender USD exporter completed. Full USD composition is not implied.'})
+    except Exception as error:
+        checks.append({'label': 'USD export', 'status': 'warn', 'detail': str(error)})
+    return downloads
+
+
+def build_scene(chapter, folder, args):
+    if chapter == 'foundry':
+        return scenes.hero(folder)
+    if chapter == 'materials':
+        return scenes.materials(folder)
+    if chapter == 'instances':
+        return scenes.instances(folder)
+    if chapter == 'hanim':
+        return scenes.hanim(folder)
+    if chapter == 'bim':
+        if not args.bim:
+            raise RuntimeError('IFC chapter requires --bim geometry JSON from adapters/bim.py')
+        return scenes.bim_geometry(args.bim, folder)
+    if chapter == 'x3d_ingress':
+        source = folder / 'source.x3d'
+        source.write_text(scenes.authored_document(), encoding='utf-8')
+        bpy.ops.wm.read_factory_settings(use_empty=True)
+        operator_finished(bpy.ops.import_scene.x3d(filepath=str(source), keep_hierarchy=True), 'Independent X3D import')
+        configure_import_render()
+        return {'features': ['Independent X3D source', 'DEF / USE across parents', 'ROUTE animation ingress',
+                             'Hierarchy reconstruction', 'PBR materials', 'Editable Blender scene'], 'duration_seconds': 15,
+                'source_file': str(source)}
+    if chapter == 'federation':
+        scenes.turbine(folder)
+        operator_finished(bpy.ops.export_scene.gltf(filepath=str(folder / 'turbine.glb'), export_format='GLB',
+                                                   export_extras=True), 'Referenced GLB export')
+        source = folder / 'source.x3d'
+        source.write_text(scenes.authored_document(inline=True), encoding='utf-8')
+        bpy.ops.wm.read_factory_settings(use_empty=True)
+        operator_finished(bpy.ops.import_scene.x3d(filepath=str(source), keep_hierarchy=True), 'Inline X3D import')
+        configure_import_render()
+        return {'features': ['glTF binary asset', 'Three Inline occurrences', 'Reference-aware re-export',
+                             'Blender GLB import adapter', 'Native X3D composition'], 'duration_seconds': 14,
+                'source_file': str(source)}
+    if chapter == 'usd':
+        scenes.hero(folder)
+        operator_finished(bpy.ops.wm.usd_export(filepath=str(folder / 'source.usda'),
+                                               export_materials=True, export_animation=True), 'USD ingress fixture export')
+        bpy.ops.wm.read_factory_settings(use_empty=True)
+        operator_finished(bpy.ops.wm.usd_import(filepath=str(folder / 'source.usda')), 'USD import')
+        configure_import_render()
+        return {'features': ['Real USD source file', 'USD → Blender import', 'Blender → X3D publication',
+                             'Materials and geometry', 'Native USD re-export'], 'duration_seconds': 14,
+                'source_file': str(folder / 'source.usda')}
+    raise ValueError(chapter)
+
+
+def build_chapter(spec, args):
+    import validate
+    import x3d_diff
+    chapter, title, kicker, description, source_kind = spec
+    folder = args.out / chapter
+    folder.mkdir(parents=True, exist_ok=True)
+    started = time.monotonic()
+    info = build_scene(chapter, folder, args)
+    bpy.context.scene.frame_set(bpy.context.scene.frame_start)
+    before = snapshot()
+    before_motion = sample_world_transforms()
+    before_skin = sample_skin_motion() if chapter == 'hanim' else None
+    checks = [{'label': 'Synthetic data', 'status': 'pass',
+               'detail': 'Deterministic original geometry; no LLM API or downloaded asset.'}]
+    if chapter == 'x3d_ingress':
+        checks.append(independent_animation_check())
+    operator_finished(bpy.ops.wm.save_as_mainfile(filepath=str(folder / 'scene.blend'), compress=True), 'Blender save')
+    export_x3d(folder / 'scene.x3d', title)
+    result = validate.validate_xml_file(str(folder / 'scene.x3d'))
+    checks.append({'label': 'X3D 4.0 validation', 'status': 'pass' if result.valid else 'warn',
+                   'detail': 'XML plus repository field checks.' if result.valid else '; '.join(result.errors[:5])})
+    tree = ET.parse(folder / 'scene.x3d')
+    types = Counter(el.tag for el in tree.getroot().iter())
+    before['x3d_bytes'] = (folder / 'scene.x3d').stat().st_size
+    before['x3d_nodes'] = sum(types.values())
+    before['geometry_use_count'] = sum(bool(el.get('USE')) for el in tree.getroot().iter()
+                                      if el.tag in {'IndexedFaceSet', 'Coordinate', 'Group'})
+    downloads = native_outputs(folder, title, checks)
+    if args.render_posters:
+        render_poster(folder / 'poster.png')
+    # Preserve the native source file and all of its actual authoring state.
+    portable_blend(folder / 'scene.blend')
+    bpy.ops.wm.read_factory_settings(use_empty=True)
+    operator_finished(bpy.ops.import_scene.x3d(filepath=str(folder / 'scene.x3d'), keep_hierarchy=True), 'Round-trip X3D import')
+    after = snapshot()
+    after_motion = sample_world_transforms(imported=True, source_timing=before_motion)
+    checks.append(motion_evidence(folder, before_motion, after_motion))
+    if before_skin is not None:
+        checks.append(skin_evidence(folder, before_skin, sample_skin_motion(source_timing=before_skin)))
+    if chapter == 'bim':
+        promoted = flatten_ifc_metadata()
+        checks.append({'label': 'IFC → USD metadata adapter', 'status': 'pass' if promoted else 'warn',
+                       'detail': f'{promoted} X3D MetadataSets explicitly promoted to scalar IFC properties for USD export.'})
+    portable_blend(folder / 'imported.blend')
+    export_x3d(folder / 'roundtrip.x3d', title + ' / round-trip')
+    downstream = native_outputs(folder, title, checks, prefix='hub')
+    for key in ('glb', 'usd'):
+        if key in downloads:
+            downloads['native_' + key] = downloads[key]
+        if key in downstream:
+            downloads[key] = downstream[key]
+    rt_valid = validate.validate_xml_file(str(folder / 'roundtrip.x3d'))
+    checks.append({'label': 'X3D → Blender → X3D', 'status': 'pass' if rt_valid.valid else 'warn',
+                   'detail': f'Imported into a fresh scene and re-exported; {after["meshes"]} mesh objects reconstructed.'})
+    differences = [d for d in x3d_diff.diff_files(str(folder / 'scene.x3d'), str(folder / 'roundtrip.x3d'),
+                                                1e-4, 1e-4) if d.get('tag') != 'meta']
+    (folder / 'roundtrip-diff.json').write_text(json.dumps(differences, indent=2))
+    checks.append({'label': 'First-trip structure', 'status': 'pass' if not differences else 'info',
+                   'detail': f'{len(differences)} structural differences reported; exact equivalence is not assumed.'})
+    bound_error = max((abs(a - b) for key in ('bounds_min', 'bounds_max')
+                       for a, b in zip(before[key], after[key])), default=0)
+    checks.append({'label': 'World bounds preservation', 'status': 'pass' if bound_error < .002 else 'warn',
+                   'detail': f'Maximum bound difference {bound_error:.6g} m at the start frame.'})
+    if chapter == 'bim':
+        same_guids = bool(before['ifc_guids']) and before['ifc_guids'] == after['ifc_guids']
+        checks.append({'label': 'IFC identity preservation', 'status': 'pass' if same_guids else 'warn',
+                       'detail': f'{len(after["ifc_guids"])} GlobalId values recovered from imported X3D metadata.'})
+    checks.append({'label': 'Unreal / Bonsai editor', 'status': 'not_run',
+                   'detail': 'Interchange assets and adapter supplied; these editors were not executed here.'})
+    evidence = {'chapter': chapter, 'before': before, 'after': after, 'bound_error_m': bound_error,
+                'structural_difference_count': len(differences), 'x3d_node_types': dict(types),
+                'checks': checks, 'build_seconds': round(time.monotonic() - started, 3),
+                'blender': bpy.app.version_string, 'python': sys.version.split()[0],
+                'source_kind': source_kind, 'source_file': info.get('source_file')}
+    for key, value in (('source_snapshot', before), ('imported_snapshot', after)):
+        evidence[key] = dict(value, object_count=value['objects'], mesh_count=value['meshes'],
+                             world_bounds=[value['bounds_min'], value['bounds_max']],
+                             total_triangles=value['triangles'], material_count=value['materials'])
+    (folder / 'evidence.json').write_text(json.dumps(evidence, indent=2))
+    def rel(path):
+        return 'assets/' + Path(path).relative_to(args.out).as_posix()
+    result = {'id': chapter, 'title': title, 'kicker': kicker, 'description': description,
+              'source_kind': source_kind, 'features': info['features'],
+              'duration_seconds': info['duration_seconds'], 'x3d': rel(folder / 'scene.x3d'),
+              'roundtrip_x3d': rel(folder / 'roundtrip.x3d'), 'poster': rel(folder / 'poster.png'),
+              'downloads': {key: rel(value) for key, value in downloads.items()},
+              'metrics': before, 'checks': checks, 'camera_labels': before['camera_labels'],
+              'evidence': rel(folder / 'evidence.json')}
+    result['downloads']['imported_blend'] = rel(folder / 'imported.blend')
+    if info.get('source_file'):
+        result['downloads']['source'] = rel(info['source_file'])
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--repo', type=Path, required=True)
+    parser.add_argument('--out', type=Path, required=True)
+    parser.add_argument('--bim', type=Path)
+    parser.add_argument('--render-posters', action='store_true')
+    parser.add_argument('--chapters', default='')
+    parser.add_argument('--audit-saved', action='store_true',
+                        help='Only resample existing source/imported .blend files; do not rebuild exports.')
+    args = parser.parse_args(sys.argv[sys.argv.index('--') + 1:])
+    args.repo, args.out = args.repo.resolve(), args.out.resolve()
+    args.out.mkdir(parents=True, exist_ok=True)
+    register(args.repo)
+    chosen = set(args.chapters.split(',')) if args.chapters else {s[0] for s in CHAPTERS}
+    report_path = args.out / 'builder_report.json'
+    report = json.loads(report_path.read_text()) if report_path.exists() else {'chapters': [], 'errors': []}
+    report['runtime'] = {'blender': bpy.app.version_string, 'python': sys.version.split()[0]}
+    for spec in CHAPTERS:
+        if spec[0] not in chosen:
+            continue
+        try:
+            if args.audit_saved:
+                folder = args.out / spec[0]
+                bpy.ops.wm.open_mainfile(filepath=str(folder / 'scene.blend'))
+                source_motion = sample_world_transforms()
+                source_skin = sample_skin_motion() if spec[0] == 'hanim' else None
+                bpy.ops.wm.open_mainfile(filepath=str(folder / 'imported.blend'))
+                imported_motion = sample_world_transforms(imported=True, source_timing=source_motion)
+                check = motion_evidence(folder, source_motion, imported_motion)
+                result = next(c for c in report['chapters'] if c['id'] == spec[0])
+                result['checks'] = [c for c in result['checks'] if c['label'] != check['label']] + [check]
+                if source_skin is not None:
+                    skin_check = skin_evidence(folder, source_skin, sample_skin_motion(source_timing=source_skin))
+                    result['checks'] = [c for c in result['checks'] if c['label'] != skin_check['label']] + [skin_check]
+                evidence_file = folder / 'evidence.json'
+                evidence = json.loads(evidence_file.read_text())
+                evidence['checks'] = result['checks']
+                evidence['motion_evidence'] = 'motion-evidence.json'
+                evidence_file.write_text(json.dumps(evidence, indent=2))
+            else:
+                result = build_chapter(spec, args)
+            report['chapters'] = [c for c in report['chapters'] if c['id'] != spec[0]] + [result]
+            report['errors'] = [e for e in report['errors'] if e['id'] != spec[0]]
+            print('NEXUS_CHAPTER_OK', spec[0], flush=True)
+        except Exception as error:
+            report['errors'] = [e for e in report['errors'] if e['id'] != spec[0]]
+            report['errors'].append({'id': spec[0], 'error': str(error), 'traceback': traceback.format_exc()})
+            print('NEXUS_CHAPTER_FAILED', spec[0], traceback.format_exc(), flush=True)
+        report['chapters'].sort(key=lambda c: next(i for i, s in enumerate(CHAPTERS) if s[0] == c['id']))
+        report_path.write_text(json.dumps(report, indent=2))
+    if report['errors']:
+        raise SystemExit(1)
+
+
+if __name__ == '__main__':
+    main()
