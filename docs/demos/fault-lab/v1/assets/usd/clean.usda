#usda 1.0
(
    customLayerData = {
        string "x3d:converter" = "fault-lab x3d_usd 0.1"
        dictionary "x3d:head" = {
            dictionary "0" = {
                string content = "Osiris Shaft as a living record"
                string name = "title"
            }
            dictionary "1" = {
                string content = "https://example.org/scen/heritage/scene.x3d"
                string name = "identifier"
            }
            dictionary "2" = {
                string content = "Schematic Giza study; every element is tagged documented, theorized or speculative in its CIDOC-CRM record."
                string name = "description"
            }
            dictionary "3" = {
                string content = "HagopJay and Claude"
                string name = "creator"
            }
            dictionary "4" = {
                string content = "CC0 geometry"
                string name = "license"
            }
        }
        string "x3d:source_sha256" = "a01d1c0434e3e2d07bd39e8aaf11d62c38033d38bb90ba3f1ce6443b7873414c"
    }
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

