{
  "iri" : "http://purl.obolibrary.org/obo/UBERON_0001072",
  "lang" : "en",
  "description" : [ "A vein that carries deoxygenated blood from the lower half of the body into the right atrium of the heart." ],
  "synonyms" : [ "postcava", "caudal vena cava", "inferior caval vein", "posterior vena cava", "vena cava inferior" ],
  "annotation" : {
    "database_cross_reference" : [ "AAO:0011083", "BTO:0002682", "EHDAA2:0000611", "EMAPA:18416", "FMA:10951", "GAID:548", "MA:0000480", "MESH:D014682", "NCIT:C12815", "SCTID:181369003", "VHOG:0001194", "Wikipedia:Inferior_vena_cava", "XAO:0000388", "galen:InferiorVenaCava", "UMLS:C0042458" ],
    "depiction" : [ "http://upload.wikimedia.org/wikipedia/commons/4/4d/Gray577.png" ],
    "external_definition" : [ "Trunk of systemic vein which is formed by the union of the right common iliac vein and the left common iliac vein and terminates in the right atrium[FMA]." ],
    "homology_notes" : [ "Phylogenetic modifications within this basic pattern of arteries and veins are largely correlated with functional changes. In the transition from water to land, gills gave way to lungs, accompanied by the establishment of a pulmonary circulation. In some fishes and certainly in tetrapods, the cardinal veins become less involved in blood return. Instead, the composite, prominent postcava (posterior vena cava) arose to drain the posterior part of the body and the precava (anterior vena cava) developed to drain the anterior part of the body.[well established][VHOG]" ],
    "id" : [ "UBERON:0001072" ]
  },
