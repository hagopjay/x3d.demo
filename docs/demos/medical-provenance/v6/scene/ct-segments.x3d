<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Full" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="http://www.web3d.org/specifications/x3d-4.0.xsd">
<head><meta name="title" content="medical-provenance v6: CT volume, HU-band segments"/><meta name="description" content="Open TCIA Pancreas-CT series as volume rendering; educational proof of concept, not medical advice."/></head>
<Scene>
<NavigationInfo type='"EXAMINE" "ANY"' headlight="true"/>
<Viewpoint DEF="VP_FRONT" description="Front (anterior)" position="0 0 0.9" orientation="0 0 1 0" centerOfRotation="0 0 0"/>
<Transform DEF="VOL_T">
<MetadataSet containerField='metadata' name="provenance" reference="x3d-demo:medprov"><MetadataSet name="source" reference="x3d-demo:medprov"><MetadataString name="collection" value='"Pancreas-CT"'/><MetadataString name="patient-id-coded" value='"PANCREAS_0051"'/><MetadataString name="series-instance-uid" value='"1.2.826.0.1.3680043.2.1125.1.77419915248783746629465382576486048"'/><MetadataString name="doi" value='"https://doi.org/10.7937/K9/TCIA.2016.tNB1kqBU"'/><MetadataString name="license" value='"Creative Commons Attribution 3.0 Unported License"'/><MetadataString name="license-uri" value='"http://creativecommons.org/licenses/by/3.0/"'/><MetadataString name="images" value='"185"'/><MetadataString name="pixel-data-sha256" value='"4b79731c455b610d8c0f9a67bffff049c2fcb8ff5c494bbc0b4a2e09e8d5f49a"'/><MetadataString name="not-medical-advice" value='"educational proof of concept"'/></MetadataSet><MetadataSet name="processing" reference="x3d-demo:medprov"><MetadataString name="block-mean-factors-xyz" value='"4 2 4"'/><MetadataString name="window-hu" value='"-200..500"'/><MetadataString name="axes" value='"x patient left, y superior, z anterior (right-handed; from DICOM LPS)"'/><MetadataString name="intensity-sha256" value='"c951bea093fbce8af37d74423a4008e78c8d1cf6959aba0c2294fa7d01dcdbc4"'/><MetadataString name="labels-sha256" value='"7301cfef5a8bc474bdb07471caf67250189420407bc62efd440eaf5a10386794"'/></MetadataSet><MetadataSet name="segments" reference="x3d-demo:medprov"><MetadataString name="segment-0" value='"outside / background | term none, no single anatomical term fits | grade S (HU band, not an anatomical segmentation)"'/><MetadataString name="segment-1" value='"low density inside body (gas or lung) | term FMA:7195 Lung | grade S (HU band, not an anatomical segmentation)"'/><MetadataString name="segment-2" value='"fat band | term FMA:20110 Adipose tissue | grade S (HU band, not an anatomical segmentation)"'/><MetadataString name="segment-3" value='"soft-tissue band | term none, no single anatomical term fits | grade S (HU band, not an anatomical segmentation)"'/><MetadataString name="segment-4" value='"dense band (bone, calcification, contrast) | term FMA:224804 Bone tissue | grade S (HU band, not an anatomical segmentation)"'/></MetadataSet></MetadataSet>
<SegmentedVolumeData DEF="VOL" dimensions="0.36000 0.18400 0.36000" segmentEnabled="false true true true true">
 <ImageTexture3D containerField="voxels" url='"ct-intensity.nrrd"'/>
 <ImageTexture3D containerField="segmentIdentifiers" url='"ct-labels.nrrd"'/>
 <ShadedVolumeStyle DEF="STY_1" containerField="renderStyle" lighting="true"><Material diffuseColor="0.55 0.75 1.0" specularColor="0.3 0.3 0.3"/></ShadedVolumeStyle>
<ShadedVolumeStyle DEF="STY_2" containerField="renderStyle" lighting="true"><Material diffuseColor="1.0 0.85 0.3" specularColor="0.3 0.3 0.3"/></ShadedVolumeStyle>
<ShadedVolumeStyle DEF="STY_3" containerField="renderStyle" lighting="true"><Material diffuseColor="0.85 0.45 0.4" specularColor="0.3 0.3 0.3"/></ShadedVolumeStyle>
<ShadedVolumeStyle DEF="STY_4" containerField="renderStyle" lighting="true"><Material diffuseColor="0.95 0.95 0.9" specularColor="0.3 0.3 0.3"/></ShadedVolumeStyle>
</SegmentedVolumeData>
</Transform>
</Scene></X3D>