@prefix dance: <https://x3d.dance/ontology#> .
@prefix hanim: <https://x3d.dance/hanim#> .
@prefix x3d:   <https://www.web3d.org/specifications/X3dOntology4.0#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<https://x3d.dance/ontology> a owl:Ontology ;
  rdfs:label "x3d.dance movement ontology" ;
  rdfs:comment "Moves, Laban Effort qualities and HAnim joints. Builds on El Raheb & Ioannidis' Labanotation-based Dance Ontology (2011); links each move to the X3D HAnimMotion that performs it." .

dance:Move a owl:Class .
dance:MoveFamily a owl:Class .
dance:Genre a owl:Class .
dance:EffortFactor a owl:Class ; rdfs:comment "Laban Effort: Weight, Time, Space, Flow" .
dance:BodyPart a owl:Class .
dance:Dancer a owl:Class .
dance:Genome a owl:Class ; rdfs:comment "Evolved style parameters and move-transition weights of one dancer" .
dance:Rating a owl:Class ; rdfs:comment "A human-in-the-loop judgement of one phrase" .
dance:Phrase a owl:Class ; rdfs:comment "An 8-count (or other) span of a performance" .
hanim:Joint a owl:Class ; rdfs:seeAlso x3d:HAnimJoint .

dance:family a owl:ObjectProperty ; rdfs:domain dance:Move ; rdfs:range dance:MoveFamily .
dance:genre a owl:ObjectProperty ; rdfs:domain dance:Move ; rdfs:range dance:Genre .
dance:drives a owl:ObjectProperty ; rdfs:domain dance:Move ; rdfs:range hanim:Joint .
dance:canFollow a owl:ObjectProperty ; rdfs:domain dance:Move ; rdfs:range dance:Move .
dance:mirrorOf a owl:ObjectProperty, owl:SymmetricProperty .
dance:performedAs a owl:ObjectProperty ; rdfs:range x3d:HAnimMotion .
dance:beats a owl:DatatypeProperty ; rdfs:range xsd:decimal .
dance:energy a owl:DatatypeProperty ; rdfs:range xsd:decimal .
dance:syncopation a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:comment "0 = on the beat, 1 = lives on the off-beats" .
dance:accentAt a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:comment "beat offset of an accent inside the move" .
dance:effortWeight a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:comment "-1 light .. +1 strong" .
dance:effortTime a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:comment "-1 sustained .. +1 sudden" .
dance:effortSpace a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:comment "-1 indirect .. +1 direct" .
dance:effortFlow a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:comment "-1 free .. +1 bound" .
dance:checkIn a owl:DatatypeProperty ; rdfs:range xsd:boolean ; rdfs:comment "a social move aimed at the partner" .


dance:groove a dance:MoveFamily .

dance:step a dance:MoveFamily .

dance:footwork a dance:MoveFamily .

dance:arms a dance:MoveFamily .

dance:isolation a dance:MoveFamily .

dance:travel a dance:MoveFamily .

dance:turn a dance:MoveFamily .

dance:hit a dance:MoveFamily .

dance:social a dance:MoveFamily .

dance:hiphop a dance:Genre .

dance:house a dance:Genre .

dance:funk a dance:Genre .

dance:bounce a dance:Move ;
  rdfs:label "Down bounce" ;
  dance:family dance:groove ;
  dance:genre dance:hiphop ;
  dance:beats "1"^^xsd:decimal ;
  dance:energy "0.35"^^xsd:decimal ;
  dance:syncopation "0.0"^^xsd:decimal ;
  dance:effortWeight "0.4"^^xsd:decimal ;
  dance:effortTime "0.2"^^xsd:decimal ;
  dance:effortSpace "0.0"^^xsd:decimal ;
  dance:effortFlow "-0.3"^^xsd:decimal ;
  dance:checkIn "false"^^xsd:boolean ;
  dance:accentAt "0"^^xsd:decimal ;
  dance:drives hanim:l_hip ;
  dance:drives hanim:l_knee ;
  dance:drives hanim:l_talocrural ;
  dance:drives hanim:r_hip ;
  dance:drives hanim:r_knee ;
  dance:drives hanim:r_talocrural ;
  dance:drives hanim:skullbase ;
  dance:drives hanim:vc4 ;
  dance:drives hanim:vl1 ;
  dance:drives hanim:vl5 ;
  dance:drives hanim:vt6 ;
  dance:performedAs <motions.x3d#Motion_bounce> ;
  rdfs:comment "Weight drops into the floor on the beat; the classic hip-hop pocket." .

dance:rock a dance:Move ;
  rdfs:label "Funk rock" ;
  dance:family dance:groove ;
  dance:genre dance:funk ;
  dance:genre dance:hiphop ;
  dance:beats "1"^^xsd:decimal ;
  dance:energy "0.35"^^xsd:decimal ;
  dance:syncopation "0.0"^^xsd:decimal ;
  dance:effortWeight "0.1"^^xsd:decimal ;
  dance:effortTime "-0.2"^^xsd:decimal ;
  dance:effortSpace "-0.3"^^xsd:decimal ;
  dance:effortFlow "-0.6"^^xsd:decimal ;
  dance:checkIn "false"^^xsd:boolean ;
  dance:accentAt "0"^^xsd:decimal ;
  dance:drives hanim:l_hip ;
  dance:drives hanim:l_knee ;
  dance:drives hanim:l_talocrural ;
  dance:drives hanim:r_hip ;
  dance:drives hanim:r_knee ;
  dance:drives hanim:r_talocrural ;
  dance:drives hanim:skullbase ;
  dance:drives hanim:vc4 ;
  dance:drives hanim:vl1 ;
  dance:drives hanim:vl5 ;
  dance:drives hanim:vt6 ;
  dance:performedAs <motions.x3d#Motion_rock> ;
  rdfs:comment "Torso rocks back on the beat and forward on the 'and'." .

dance:jack a dance:Move ;
  rdfs:label "House jack" ;
  dance:family dance:groove ;
  dance:genre dance:house ;
  dance:beats "1"^^xsd:decimal ;
  dance:energy "0.5"^^xsd:decimal ;
  dance:syncopation "0.4"^^xsd:decimal ;
  dance:effortWeight "0.3"^^xsd:decimal ;
  dance:effortTime "0.3"^^xsd:decimal ;
  dance:effortSpace "0.2"^^xsd:decimal ;
  dance:effortFlow "-0.4"^^xsd:decimal ;
  dance:checkIn "false"^^xsd:boolean ;
  dance:accentAt "0.35"^^xsd:decimal ;
  dance:drives hanim:l_hip ;
  dance:drives hanim:l_knee ;
  dance:drives hanim:l_talocrural ;
  dance:drives hanim:r_hip ;
  dance:drives hanim:r_knee ;
  dance:drives hanim:r_talocrural ;
  dance:drives hanim:skullbase ;
  dance:drives hanim:vc4 ;
  dance:drives hanim:vl1 ;
  dance:drives hanim:vl5 ;
  dance:drives hanim:vt6 ;
  dance:performedAs <motions.x3d#Motion_jack> ;
  rdfs:comment "Chest pumps in a wave through the body, slightly ahead of the upbeat." .

dance:sway a dance:Move ;
  rdfs:label "Two-sided sway" ;
  dance:family dance:groove ;
  dance:genre dance:funk ;
  dance:genre dance:house ;
  dance:genre dance:hiphop ;
  dance:beats "2"^^xsd:decimal ;
  dance:energy "0.2"^^xsd:decimal ;
  dance:syncopation "0.0"^^xsd:decimal ;
  dance:effortWeight "-0.4"^^xsd:decimal ;
  dance:effortTime "-0.6"^^xsd:decimal ;
