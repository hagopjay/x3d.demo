  for (int j = 0; j < 3; j++) {
    int i = k - j;
    if (i < 0) break;
    Ev e = evAt(tex, r, i);
    float a = clamp((t - e.on) / attack, 0.0, 1.0);
    a = a * a * (3.0 - 2.0 * a);
