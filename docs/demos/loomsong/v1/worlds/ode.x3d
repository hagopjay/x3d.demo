          <ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
precision highp int;
precision highp sampler2D;
uniform float u_time;
uniform float u_dur;
uniform float u_idpass;
uniform float u_calm;
#define TAU 6.28318530718
#define PI 3.14159265359
float hash11(float p) { p = fract(p * 0.1031); p *= p + 33.33; p *= p + p; return fract(p); }
float hash21(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }
vec2 hash22(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973)); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.xx + p3.yz) * p3.zy); }
float vnoise(vec2 p) {
  vec2 i = floor(p), f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  return mix(mix(hash21(i), hash21(i + vec2(1.0, 0.0)), f.x), mix(hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0, 1.0)), f.x), f.y);
}
float fbm(vec2 p) {
  float a = 0.5, s = 0.0;
  for (int i = 0; i < 4; i++) { s += a * vnoise(p); p = p * 2.03 + 17.1; a *= 0.5; }
  return s;
}
vec3 S(float r, float g, float b) { return pow(vec3(r, g, b) * (1.0 / 255.0), vec3(2.2)); }
vec3 finish(vec3 lin) {
  lin *= 0.9;
  vec3 m = clamp((lin * (2.51 * lin + 0.03)) / (lin * (2.43 * lin + 0.59) + 0.14), 0.0, 1.0);
  return pow(m, vec3(1.0 / 2.2));
}
vec3 idColor(float id) { float v = id + 1.0; return vec3(mod(v, 256.0), mod(floor(v / 256.0), 256.0), floor(v / 65536.0)) / 255.0; }
float byte1(float c) { return floor(c * 255.0 + 0.5); }
ivec2 tx(int i) { return ivec2(i & 1023, i >> 10); }
int rd24(sampler2D tex, int i) { vec4 e = texelFetch(tex, tx(i), 0); return int(byte1(e.r)) * 65536 + int(byte1(e.g)) * 256 + int(byte1(e.b)); }
float time24(vec4 e) { return (byte1(e.r) * 65536.0 + byte1(e.g) * 256.0 + byte1(e.b)) * (u_dur / 16777215.0); }
struct Row { int base; int n; };
struct Ev { float on; float off; float vel; float aux; float kind; float id; };
Row rowOf(sampler2D tex, int row) {
  Row r;
  r.base = rd24(tex, 0) + 4 * rd24(tex, 1 + 2 * row);
  r.n = rd24(tex, 2 + 2 * row);
  return r;
}
float evOn(sampler2D tex, Row r, int i) { return time24(texelFetch(tex, tx(r.base + 4 * i), 0)); }
Ev evAt(sampler2D tex, Row r, int i) {
  Ev e;
  int k = r.base + 4 * i;
  e.on = time24(texelFetch(tex, tx(k), 0));
  e.off = time24(texelFetch(tex, tx(k + 1), 0));
  vec4 c = texelFetch(tex, tx(k + 2), 0);
  e.vel = c.r; e.aux = byte1(c.g); e.kind = byte1(c.b);
  e.id = float(rd24(tex, k + 3));
  return e;
}
int lastOn(sampler2D tex, Row r, float t) {
  int lo = 0, hi = r.n;
  for (int s = 0; s < 16; s++) {
    if (lo >= hi) break;
    int mid = (lo + hi) / 2;
    if (evOn(tex, r, mid) <= t) lo = mid + 1; else hi = mid;
  }
  return lo - 1;
}
vec4 glowAt(sampler2D tex, int row, float t, float attack, float tau) {
  vec4 best = vec4(0.0);
  Row r = rowOf(tex, row);
  if (r.n == 0) return best;
  int k = lastOn(tex, r, t);
  for (int j = 0; j < 3; j++) {
    int i = k - j;
    if (i < 0) break;
    Ev e = evAt(tex, r, i);
    float a = clamp((t - e.on) / attack, 0.0, 1.0);
    a = a * a * (3.0 - 2.0 * a);
    float env = a * (t <= e.off ? 1.0 : exp(-(t - e.off) / tau));
    if (env > best.x) best = vec4(env, e.vel, t - e.on, e.kind);
  }
  return best;
}
vec2 litStrict(sampler2D tex, int row, float t) {
  Row r = rowOf(tex, row);
  if (r.n == 0) return vec2(0.0, 0.0);
  int k = lastOn(tex, r, t);
  for (int j = 0; j < 3; j++) {
    int i = k - j;
    if (i < 0) break;
    Ev e = evAt(tex, r, i);
    if (t >= e.on && t <= e.off) return vec2(1.0, e.id);
  }
  return vec2(0.0, 0.0);
}

uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
in vec4 x3d_Vertex;
in vec2 a_uv;
out vec2 v_uv;
void main() {
  v_uv = a_uv;
  gl_Position = x3d_ProjectionMatrix * x3d_ModelViewMatrix * x3d_Vertex;
}
]]></ShaderPart>
          <ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
precision highp int;
precision highp sampler2D;
uniform float u_time;
uniform float u_dur;
uniform float u_idpass;
uniform float u_calm;
#define TAU 6.28318530718
#define PI 3.14159265359
float hash11(float p) { p = fract(p * 0.1031); p *= p + 33.33; p *= p + p; return fract(p); }
float hash21(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }
vec2 hash22(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973)); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.xx + p3.yz) * p3.zy); }
float vnoise(vec2 p) {
  vec2 i = floor(p), f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  return mix(mix(hash21(i), hash21(i + vec2(1.0, 0.0)), f.x), mix(hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0, 1.0)), f.x), f.y);
}
float fbm(vec2 p) {
  float a = 0.5, s = 0.0;
  for (int i = 0; i < 4; i++) { s += a * vnoise(p); p = p * 2.03 + 17.1; a *= 0.5; }
  return s;
}
vec3 S(float r, float g, float b) { return pow(vec3(r, g, b) * (1.0 / 255.0), vec3(2.2)); }
vec3 finish(vec3 lin) {
  lin *= 0.9;
  vec3 m = clamp((lin * (2.51 * lin + 0.03)) / (lin * (2.43 * lin + 0.59) + 0.14), 0.0, 1.0);
  return pow(m, vec3(1.0 / 2.2));
}
vec3 idColor(float id) { float v = id + 1.0; return vec3(mod(v, 256.0), mod(floor(v / 256.0), 256.0), floor(v / 65536.0)) / 255.0; }
float byte1(float c) { return floor(c * 255.0 + 0.5); }
ivec2 tx(int i) { return ivec2(i & 1023, i >> 10); }
int rd24(sampler2D tex, int i) { vec4 e = texelFetch(tex, tx(i), 0); return int(byte1(e.r)) * 65536 + int(byte1(e.g)) * 256 + int(byte1(e.b)); }
float time24(vec4 e) { return (byte1(e.r) * 65536.0 + byte1(e.g) * 256.0 + byte1(e.b)) * (u_dur / 16777215.0); }
struct Row { int base; int n; };
struct Ev { float on; float off; float vel; float aux; float kind; float id; };
Row rowOf(sampler2D tex, int row) {
  Row r;
  r.base = rd24(tex, 0) + 4 * rd24(tex, 1 + 2 * row);
  r.n = rd24(tex, 2 + 2 * row);
  return r;
}
float evOn(sampler2D tex, Row r, int i) { return time24(texelFetch(tex, tx(r.base + 4 * i), 0)); }
Ev evAt(sampler2D tex, Row r, int i) {
  Ev e;
  int k = r.base + 4 * i;
  e.on = time24(texelFetch(tex, tx(k), 0));
  e.off = time24(texelFetch(tex, tx(k + 1), 0));
  vec4 c = texelFetch(tex, tx(k + 2), 0);
  e.vel = c.r; e.aux = byte1(c.g); e.kind = byte1(c.b);
  e.id = float(rd24(tex, k + 3));
  return e;
}
int lastOn(sampler2D tex, Row r, float t) {
  int lo = 0, hi = r.n;
  for (int s = 0; s < 16; s++) {
    if (lo >= hi) break;
    int mid = (lo + hi) / 2;
    if (evOn(tex, r, mid) <= t) lo = mid + 1; else hi = mid;
  }
  return lo - 1;
}
vec4 glowAt(sampler2D tex, int row, float t, float attack, float tau) {
  vec4 best = vec4(0.0);
  Row r = rowOf(tex, row);
  if (r.n == 0) return best;
  int k = lastOn(tex, r, t);
  for (int j = 0; j < 3; j++) {
    int i = k - j;
    if (i < 0) break;
    Ev e = evAt(tex, r, i);
    float a = clamp((t - e.on) / attack, 0.0, 1.0);
    a = a * a * (3.0 - 2.0 * a);
    float env = a * (t <= e.off ? 1.0 : exp(-(t - e.off) / tau));
    if (env > best.x) best = vec4(env, e.vel, t - e.on, e.kind);
  }
  return best;
}
vec2 litStrict(sampler2D tex, int row, float t) {
  Row r = rowOf(tex, row);
  if (r.n == 0) return vec2(0.0, 0.0);
  int k = lastOn(tex, r, t);
  for (int j = 0; j < 3; j++) {
    int i = k - j;
    if (i < 0) break;
    Ev e = evAt(tex, r, i);
    if (t >= e.on && t <= e.off) return vec2(1.0, e.id);
  }
  return vec2(0.0, 0.0);
}

uniform float u_act;
uniform float u_tens;
vec3 ink(float i) {
  if (i < 0.5) return S(62.0, 74.0, 178.0);
  if (i < 1.5) return S(204.0, 212.0, 228.0);
  if (i < 2.5) return S(246.0, 192.0, 82.0);
  if (i < 3.5) return S(250.0, 244.0, 226.0);
  return S(224.0, 42.0, 62.0);
}
vec3 naveLight(vec3 P, vec3 N) {
  vec3 c = vec3(0.018, 0.030, 0.068) * (0.6 + 0.4 * N.y);
  vec3 d = vec3(0.0, 6.5, -22.0) - P;
  float d2 = dot(d, d);
  float att = 1.0 / (1.0 + d2 * 0.0075);
  float lam = max(dot(N, d * inversesqrt(d2)), 0.0);
  c += vec3(1.0, 0.80, 0.52) * (0.35 + 1.3 * u_act) * att * lam * 1.7;
  vec3 e = vec3(0.0, 12.5, -16.0) - P;
  float e2 = dot(e, e);
  c += vec3(1.0, 0.78, 0.50) * 1.1 / (1.0 + e2 * 0.025) * max(dot(N, e * inversesqrt(e2)), 0.0);
  vec3 w = normalize(vec3(-sign(P.x) * 0.45, 0.85, 0.1));
  float win = max(dot(N, w), 0.0) * smoothstep(2.0, 16.0, P.y);
  c += vec3(0.30, 0.44, 0.80) * win * (0.34 + 0.5 * u_tens);
  return c;
}

uniform sampler2D u_chords;
in vec2 v_uv;
out vec4 x3d_FragColor;
vec3 glass(int s) {
  int m = s - 5 * (s / 5);
  return m == 0 ? S(30.0, 74.0, 190.0) : (m == 1 ? S(190.0, 36.0, 56.0) : (m == 2 ? S(24.0, 150.0, 112.0) : (m == 3 ? S(232.0, 172.0, 52.0) : S(130.0, 56.0, 170.0))));
}
float cuts(float d, float w) { return smoothstep(w, w * 0.45, d); }
void main() {
  vec2 p = v_uv;
  float r = length(p);
  float ang = atan(p.x, p.y);
  float sec = mod(floor(ang / (TAU / 12.0) + 0.5) + 12.0, 12.0);
  int s = int(sec + 0.5);
  float within = fract(ang / (TAU / 12.0) + 0.5) - 0.5;
  vec4 gl = glowAt(u_chords, s, u_time, 0.12, 0.8);
  if (u_idpass > 0.5) { x3d_FragColor = vec4(0.0, 0.0, 0.0, 1.0); return; }
  vec2 axis = vec2(sin(sec * TAU / 12.0), cos(sec * TAU / 12.0));
  float lead = 0.0;
  lead = max(lead, cuts(abs(r - 0.17), 0.030));
  lead = max(lead, cuts(abs(r - 0.48), 0.030));
  lead = max(lead, cuts(abs(r - 0.78), 0.030));
  lead = max(lead, cuts(abs(r - 0.935), 0.045));
  float arc = (0.5 - abs(within)) * r * (TAU / 12.0);
  lead = max(lead, cuts(arc, 0.030) * step(0.17, r) * step(r, 0.935));
  float pd = length(p - axis * 0.325);
  lead = max(lead, cuts(abs(pd - 0.125), 0.024) * step(0.17, r) * step(r, 0.48));
  float a24 = floor(ang / (TAU / 24.0)) * (TAU / 24.0) + TAU / 48.0;
  vec2 c24 = vec2(sin(a24), cos(a24)) * 0.855;
  float cd = length(p - c24);
  lead = max(lead, cuts(abs(cd - 0.055), 0.020) * step(0.78, r) * step(r, 0.935));
  vec3 base = glass(int(mod(sec * 7.0, 12.0)));
  vec3 petal = glass(int(mod(sec * 7.0 + 2.0, 12.0)));
  vec3 gl2 = r < 0.48 ? mix(base, petal, smoothstep(0.125, 0.10, pd)) : (r > 0.78 ? mix(base, glass(int(mod(sec * 7.0 + 4.0, 12.0))), smoothstep(0.055, 0.04, cd)) : base);
  float n = 0.55 + 0.9 * fbm(p * 9.0 + sec);
  float back = 0.55 + 0.7 * smoothstep(1.0, 0.0, r);
  vec3 col = gl2 * n * back * 1.25;
  col = mix(col, vec3(0.012, 0.012, 0.02), lead);
  float g = gl.x * (1.0 - 0.8 * u_calm);
  col += gl2 * g * 3.4 * (1.0 - lead) + S(255.0, 240.0, 210.0) * g * g * 0.9 * (1.0 - lead);
  float hub = smoothstep(0.17, 0.15, r);
  vec3 key = mix(S(240.0, 196.0, 104.0), S(255.0, 250.0, 232.0), u_tens);
  col = mix(col, key * (1.1 + 1.4 * u_tens + 0.4 * sin(u_time * 2.0)), hub);
  float frame = smoothstep(0.945, 0.965, r);
  col = mix(col, S(34.0, 36.0, 48.0), frame);
  x3d_FragColor = vec4(finish(col), 1.0);
}
]]></ShaderPart>
