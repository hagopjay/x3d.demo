uniform float u_act;
uniform float u_tens;
vec3 ink(float i) {
  if (i < 0.5) return S(62.0, 74.0, 178.0);
  if (i < 1.5) return S(204.0, 212.0, 228.0);
  if (i < 2.5) return S(246.0, 192.0, 82.0);
