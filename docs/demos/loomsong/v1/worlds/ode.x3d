vec2 litStrict(sampler2D tex, int row, float t) {
  Row r = rowOf(tex, row);
  if (r.n == 0) return vec2(0.0, 0.0);
  int k = lastOn(tex, r, t);
  for (int j = 0; j < 3; j++) {
    int i = k - j;
    if (i < 0) break;
    Ev e = evAt(tex, r, i);
    if (t >= e.on && t <= e.off) return vec2(1.0, e.id);
