vec3 tileArt(vec2 uv, float seed, float petals, vec3 c1, vec3 c2, vec3 c3, vec3 c4) {
  vec2 p = uv * 2.0 - 1.0;
  float d = min(min(uv.x, 1.0 - uv.x), min(uv.y, 1.0 - uv.y));
  float r = length(p);
  float a = atan(p.y, p.x) + seed * 0.9;
  vec3 col = c2;
  vec2 q = abs(p) - vec2(0.80);
  float cr = length(q);
  col = mix(col, c1, smoothstep(0.30, 0.27, cr));
  col = mix(col, c4, smoothstep(0.17, 0.14, cr));
  float petal = 0.33 + 0.42 * pow(0.5 + 0.5 * cos(petals * a), 1.6);
  col = mix(col, c4, smoothstep(petal + 0.02, petal - 0.02, r));
  col = mix(col, c3, smoothstep(0.30, 0.27, r));
  col = mix(col, c1, smoothstep(0.020, 0.008, abs(r - 0.23)));
  col = mix(col, c2, smoothstep(0.12, 0.10, r));
  col = mix(col, c1, smoothstep(0.075, 0.068, d));
  col = mix(col, c3, smoothstep(0.014, 0.008, abs(d - 0.092)));
  float g = fbm(uv * 7.0 + seed * 3.1);
  col *= 0.88 + 0.22 * g;
  col *= 1.0 - 0.25 * smoothstep(0.78, 0.9, vnoise(uv * 23.0 + seed));
  return col;
}
void palette(float k, out vec3 c1, out vec3 c2, out vec3 c3, out vec3 c4) {
  vec3 a1 = S(14.0, 52.0, 140.0), a2 = S(24.0, 156.0, 156.0), a4 = S(190.0, 52.0, 36.0);
  vec3 b1 = S(196.0, 58.0, 40.0), b2 = S(226.0, 172.0, 64.0), b4 = S(20.0, 60.0, 150.0);
  vec3 g1 = S(22.0, 112.0, 78.0), g2 = S(24.0, 156.0, 156.0), g4 = S(20.0, 60.0, 150.0);
  float k1 = clamp(k, 0.0, 1.0), k2 = clamp(k - 1.0, 0.0, 1.0);
  c1 = mix(mix(a1, b1, k1), g1, k2);
  c2 = mix(mix(a2, b2, k1), g2, k2);
  c4 = mix(mix(a4, b4, k1), g4, k2);
  c3 = S(232.0, 226.0, 208.0);
}
const vec3 WHEEL[12] = vec3[12](vec3(214.0, 62.0, 40.0), vec3(236.0, 118.0, 42.0), vec3(240.0, 176.0, 56.0), vec3(246.0, 214.0, 110.0), vec3(248.0, 240.0, 214.0), vec3(150.0, 226.0, 214.0),
                                vec3(40.0, 190.0, 184.0), vec3(30.0, 140.0, 210.0), vec3(50.0, 90.0, 220.0), vec3(110.0, 80.0, 205.0), vec3(214.0, 90.0, 150.0), vec3(190.0, 40.0, 70.0));
vec3 wheel(int i) { vec3 c = WHEEL[i]; return S(c.x, c.y, c.z); }

uniform sampler2D u_motifs;
vec4 motif(float t, vec2 f) {
  vec2 m = 1.0 - abs(1.0 - mod(f, 2.0));
  vec2 at = vec2(mod(t, 4.0), floor(t / 4.0));
  vec4 c = texture(u_motifs, (at + 0.03125 + m * 0.9375) / vec2(4.0, 3.0));
  return vec4(pow(c.rgb, vec3(2.2)), c.a);
}

uniform float u_key;
uniform float u_sec;
uniform float u_open;
uniform float u_qpm;
in vec3 v_dir;
out vec4 x3d_FragColor;
void main() {
  if (u_idpass > 0.5) { x3d_FragColor = vec4(0.0, 0.0, 0.0, 1.0); return; }
  vec3 d = normalize(v_dir);
  float el = acos(clamp(d.y, -1.0, 1.0));
  float az = atan(d.z, d.x);
  float q = u_time * u_qpm / 60.0;
  float turn = (floor(q) + smoothstep(0.0, 0.35, fract(q))) / 12.0 * TAU;
  float seg = TAU / 12.0;
  float a = abs(mod(az + turn, seg) - 0.5 * seg);
  vec2 p = vec2(cos(a), sin(a)) * el;
  vec2 g = p * (2.6 + 0.3 * mod(u_sec, 4.0));
  vec2 cell = floor(g);
  vec3 c1, c2, c3, c4;
  palette(u_key, c1, c2, c3, c4);
  float seed = hash21(cell + u_sec * 7.0);
  vec3 col = tileArt(fract(g), seed * 6.0, 8.0 + 2.0 * floor(seed * 3.0), c1, c2, c3, c4);
  float sec = floor(u_sec + 0.5);
  float tSec = sec <= 8.5 ? sec : (sec < 10.5 ? 8.0 : 9.0);
  vec4 pic = motif(tSec, g);
  if (pic.a > 0.5) {
    col = pic.rgb;
    float hush = (1.0 - smoothstep(3.0, 7.6, u_time)) * step(sec, 0.5);
    if (hush > 0.002) col = mix(col, motif(10.0, g).rgb, hush);
    float fin = smoothstep(0.0, 0.7, u_open);
    if (fin > 0.002) col = mix(col, motif(11.0, g).rgb, fin);
    col *= 0.90 + 0.20 * seed;
  }
  float warm = smoothstep(0.55, 1.5, el);
  float pulse = 1.0 + 0.18 * exp(-fract(q) * 5.0) * (1.0 - 0.8 * u_calm);
  col *= (vec3(1.0, 0.74, 0.5) * warm * 0.75 + vec3(0.30, 0.42, 0.95) * 0.22) * pulse;
  col *= 1.0 - 0.7 * smoothstep(1.40, 1.57, el);
  float rad = u_open * 0.62;
  float star = step(0.992, hash21(floor(d.xz / max(d.y, 0.2) * 70.0)));
  vec3 sky = mix(S(6.0, 12.0, 40.0), S(14.0, 28.0, 70.0), el) + star * vec3(1.0, 0.95, 0.85) * 1.2;
  float hole = smoothstep(rad, rad - 0.04, el) * step(0.001, u_open);
  col = mix(col, sky, hole);
  x3d_FragColor = vec4(finish(col), 1.0);
}
