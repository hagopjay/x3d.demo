    float env = a * (t <= e.off ? 1.0 : exp(-(t - e.off) / tau));
    if (env > best.x) best = vec4(env, e.vel, t - e.on, e.kind);
  }
  return best;
}
vec2 litStrict(sampler2D tex, int row, float t) {
  Row r = rowOf(tex, row);
  if (r.n == 0) return vec2(0.0, 0.0);
  int k = lastOn(tex, r, t);
  for (int j = 0; j < 3; j++) {
    int i = k - j;
    if (i < 0) break;
    Ev e = evAt(tex, r, i);
    if (t >= e.on && t <= e.off) return vec2(1.0, e.id);
  }
  return vec2(0.0, 0.0);
}

in vec2 v_c;
flat in vec4 v_glow;
out vec4 x3d_FragColor;
void main() {
  if (u_idpass > 0.5) discard;
  float r2 = dot(v_c, v_c);
  float core = exp(-max(v_glow.z, 0.0) * 6.0) * v_glow.x * (1.0 - 0.8 * u_calm);
  float a = exp(-r2 * 5.0) * v_glow.x * (0.55 + 0.45 * v_glow.y) * (1.0 - smoothstep(0.7, 1.0, r2));
  vec3 col = mix(vec3(1.0, 0.52, 0.18), vec3(1.0, 0.9, 0.62), clamp(core + exp(-r2 * 24.0) * 0.6, 0.0, 1.0));
  x3d_FragColor = vec4(finish(col * 1.6), clamp(a * 0.85, 0.0, 1.0));
}
