          <ShaderPart type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
precision highp int;
precision highp sampler2D;
uniform float u_time;
uniform float u_dur;
uniform float u_idpass;
uniform float u_calm;
#define TAU 6.28318530718
#define PI 3.14159265359
float hash11(float p) { p = fract(p * 0.1031); p *= p + 33.33; p *= p + p; return fract(p); }
float hash21(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }
vec2 hash22(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973)); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.xx + p3.yz) * p3.zy); }
float vnoise(vec2 p) {
  vec2 i = floor(p), f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  return mix(mix(hash21(i), hash21(i + vec2(1.0, 0.0)), f.x), mix(hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0, 1.0)), f.x), f.y);
}
float fbm(vec2 p) {
  float a = 0.5, s = 0.0;
  for (int i = 0; i < 4; i++) { s += a * vnoise(p); p = p * 2.03 + 17.1; a *= 0.5; }
  return s;
}
vec3 S(float r, float g, float b) { return pow(vec3(r, g, b) * (1.0 / 255.0), vec3(2.2)); }
vec3 finish(vec3 lin) {
  lin *= 0.9;
  vec3 m = clamp((lin * (2.51 * lin + 0.03)) / (lin * (2.43 * lin + 0.59) + 0.14), 0.0, 1.0);
  return pow(m, vec3(1.0 / 2.2));
}
vec3 idColor(float id) { float v = id + 1.0; return vec3(mod(v, 256.0), mod(floor(v / 256.0), 256.0), floor(v / 65536.0)) / 255.0; }
float byte1(float c) { return floor(c * 255.0 + 0.5); }
ivec2 tx(int i) { return ivec2(i & 1023, i >> 10); }
int rd24(sampler2D tex, int i) { vec4 e = texelFetch(tex, tx(i), 0); return int(byte1(e.r)) * 65536 + int(byte1(e.g)) * 256 + int(byte1(e.b)); }
float time24(vec4 e) { return (byte1(e.r) * 65536.0 + byte1(e.g) * 256.0 + byte1(e.b)) * (u_dur / 16777215.0); }
struct Row { int base; int n; };
struct Ev { float on; float off; float vel; float aux; float kind; float id; };
Row rowOf(sampler2D tex, int row) {
  Row r;
  r.base = rd24(tex, 0) + 4 * rd24(tex, 1 + 2 * row);
  r.n = rd24(tex, 2 + 2 * row);
  return r;
}
float evOn(sampler2D tex, Row r, int i) { return time24(texelFetch(tex, tx(r.base + 4 * i), 0)); }
Ev evAt(sampler2D tex, Row r, int i) {
  Ev e;
  int k = r.base + 4 * i;
  e.on = time24(texelFetch(tex, tx(k), 0));
  e.off = time24(texelFetch(tex, tx(k + 1), 0));
  vec4 c = texelFetch(tex, tx(k + 2), 0);
  e.vel = c.r; e.aux = byte1(c.g); e.kind = byte1(c.b);
  e.id = float(rd24(tex, k + 3));
  return e;
}
int lastOn(sampler2D tex, Row r, float t) {
  int lo = 0, hi = r.n;
  for (int s = 0; s < 16; s++) {
    if (lo >= hi) break;
    int mid = (lo + hi) / 2;
    if (evOn(tex, r, mid) <= t) lo = mid + 1; else hi = mid;
  }
  return lo - 1;
}
vec4 glowAt(sampler2D tex, int row, float t, float attack, float tau) {
  vec4 best = vec4(0.0);
  Row r = rowOf(tex, row);
  if (r.n == 0) return best;
  int k = lastOn(tex, r, t);
  for (int j = 0; j < 3; j++) {
    int i = k - j;
    if (i < 0) break;
    Ev e = evAt(tex, r, i);
    float a = clamp((t - e.on) / attack, 0.0, 1.0);
    a = a * a * (3.0 - 2.0 * a);
    float env = a * (t <= e.off ? 1.0 : exp(-(t - e.off) / tau));
    if (env > best.x) best = vec4(env, e.vel, t - e.on, e.kind);
  }
  return best;
}
vec2 litStrict(sampler2D tex, int row, float t) {
  Row r = rowOf(tex, row);
  if (r.n == 0) return vec2(0.0, 0.0);
  int k = lastOn(tex, r, t);
  for (int j = 0; j < 3; j++) {
    int i = k - j;
    if (i < 0) break;
    Ev e = evAt(tex, r, i);
    if (t >= e.on && t <= e.off) return vec2(1.0, e.id);
  }
  return vec2(0.0, 0.0);
}

uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
uniform mat3 x3d_NormalMatrix;
uniform sampler2D u_teeth;
in vec4 x3d_Vertex;
in vec3 x3d_Normal;
in vec4 x3d_Color;
in float a_tooth;
in float a_along;
out vec3 v_nrm;
out vec3 v_pos;
out vec4 v_col;
out vec3 v_obj;
flat out vec4 v_glow;
flat out vec2 v_lit;
out float v_along;
void main() {
  int row = int(a_tooth + 0.5);
  vec4 g = glowAt(u_teeth, row, u_time, 0.08, 0.35);
  v_glow = g;
  v_lit = litStrict(u_teeth, row, u_time);
  float age = max(g.z, 0.0);
  float amp = (0.25 + 0.75 * g.y) * 0.035 * exp(-age * 5.0) * step(0.003, g.x);
  vec4 pos = x3d_Vertex + vec4(0.0, amp * cos(age * 95.0) * a_along * a_along, 0.0, 0.0);
  vec4 p = x3d_ModelViewMatrix * pos;
  v_pos = p.xyz;
  v_nrm = x3d_NormalMatrix * x3d_Normal;
  v_col = x3d_Color;
  v_obj = x3d_Vertex.xyz;
  v_along = a_along;
  gl_Position = x3d_ProjectionMatrix * p;
}
]]></ShaderPart>
          <ShaderPart type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
precision highp int;
precision highp sampler2D;
uniform float u_time;
uniform float u_dur;
uniform float u_idpass;
uniform float u_calm;
#define TAU 6.28318530718
#define PI 3.14159265359
float hash11(float p) { p = fract(p * 0.1031); p *= p + 33.33; p *= p + p; return fract(p); }
float hash21(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }
vec2 hash22(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973)); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.xx + p3.yz) * p3.zy); }
float vnoise(vec2 p) {
  vec2 i = floor(p), f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  return mix(mix(hash21(i), hash21(i + vec2(1.0, 0.0)), f.x), mix(hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0, 1.0)), f.x), f.y);
}
float fbm(vec2 p) {
  float a = 0.5, s = 0.0;
  for (int i = 0; i < 4; i++) { s += a * vnoise(p); p = p * 2.03 + 17.1; a *= 0.5; }
  return s;
}
vec3 S(float r, float g, float b) { return pow(vec3(r, g, b) * (1.0 / 255.0), vec3(2.2)); }
vec3 finish(vec3 lin) {
  lin *= 0.9;
  vec3 m = clamp((lin * (2.51 * lin + 0.03)) / (lin * (2.43 * lin + 0.59) + 0.14), 0.0, 1.0);
  return pow(m, vec3(1.0 / 2.2));
}
vec3 idColor(float id) { float v = id + 1.0; return vec3(mod(v, 256.0), mod(floor(v / 256.0), 256.0), floor(v / 65536.0)) / 255.0; }
float byte1(float c) { return floor(c * 255.0 + 0.5); }
ivec2 tx(int i) { return ivec2(i & 1023, i >> 10); }
int rd24(sampler2D tex, int i) { vec4 e = texelFetch(tex, tx(i), 0); return int(byte1(e.r)) * 65536 + int(byte1(e.g)) * 256 + int(byte1(e.b)); }
float time24(vec4 e) { return (byte1(e.r) * 65536.0 + byte1(e.g) * 256.0 + byte1(e.b)) * (u_dur / 16777215.0); }
struct Row { int base; int n; };
struct Ev { float on; float off; float vel; float aux; float kind; float id; };
Row rowOf(sampler2D tex, int row) {
  Row r;
  r.base = rd24(tex, 0) + 4 * rd24(tex, 1 + 2 * row);
  r.n = rd24(tex, 2 + 2 * row);
  return r;
}
float evOn(sampler2D tex, Row r, int i) { return time24(texelFetch(tex, tx(r.base + 4 * i), 0)); }
Ev evAt(sampler2D tex, Row r, int i) {
  Ev e;
  int k = r.base + 4 * i;
  e.on = time24(texelFetch(tex, tx(k), 0));
  e.off = time24(texelFetch(tex, tx(k + 1), 0));
  vec4 c = texelFetch(tex, tx(k + 2), 0);
  e.vel = c.r; e.aux = byte1(c.g); e.kind = byte1(c.b);
  e.id = float(rd24(tex, k + 3));
  return e;
}
int lastOn(sampler2D tex, Row r, float t) {
  int lo = 0, hi = r.n;
  for (int s = 0; s < 16; s++) {
    if (lo >= hi) break;
    int mid = (lo + hi) / 2;
    if (evOn(tex, r, mid) <= t) lo = mid + 1; else hi = mid;
  }
  return lo - 1;
}
vec4 glowAt(sampler2D tex, int row, float t, float attack, float tau) {
  vec4 best = vec4(0.0);
  Row r = rowOf(tex, row);
  if (r.n == 0) return best;
  int k = lastOn(tex, r, t);
  for (int j = 0; j < 3; j++) {
    int i = k - j;
    if (i < 0) break;
    Ev e = evAt(tex, r, i);
    float a = clamp((t - e.on) / attack, 0.0, 1.0);
    a = a * a * (3.0 - 2.0 * a);
    float env = a * (t <= e.off ? 1.0 : exp(-(t - e.off) / tau));
    if (env > best.x) best = vec4(env, e.vel, t - e.on, e.kind);
  }
  return best;
}
vec2 litStrict(sampler2D tex, int row, float t) {
  Row r = rowOf(tex, row);
  if (r.n == 0) return vec2(0.0, 0.0);
  int k = lastOn(tex, r, t);
  for (int j = 0; j < 3; j++) {
    int i = k - j;
    if (i < 0) break;
    Ev e = evAt(tex, r, i);
    if (t >= e.on && t <= e.off) return vec2(1.0, e.id);
  }
  return vec2(0.0, 0.0);
}

uniform float u_lampI;
vec3 lamps(vec3 P, vec3 N) {
  const float SEG = TAU / 24.0;
  float a = atan(P.x, -P.z);
  if (a < 0.0) a += TAU;
  float k0 = floor(a / SEG - 0.5);
  float sum = 0.0;
  for (int j = -1; j <= 2; j++) {
    float k = mod(k0 + float(j) + 24.0, 24.0);
    float ang = (k + 0.5) * SEG;
    vec3 L = vec3(12.55 * sin(ang), 4.1, -12.55 * cos(ang)) - P;
    float d2 = dot(L, L);
    float lam = max(dot(N, L) * inversesqrt(d2), 0.0);
    float q = 1.0 + d2 / 13.0;
    sum += lam / (q * q);
  }
  return vec3(1.0, 0.64, 0.32) * sum * 2.5 * u_lampI;
}

uniform mat4 x3d_CameraSpaceMatrix;
uniform vec3 u_envTop;
uniform vec3 u_envHor;
uniform vec3 u_envLow;
uniform vec3 u_tint;
uniform vec3 u_albedo;
uniform float u_ring;
uniform float u_gloss;
uniform float u_brushed;
uniform float u_vcol;
uniform float u_flat;
in vec3 v_nrm;
in vec3 v_pos;
in vec4 v_col;
in vec3 v_obj;
vec3 envOf(vec3 d) {
  float h = d.y;
  vec3 c = mix(u_envHor, u_envTop, smoothstep(0.0, 0.9, h));
  c = mix(c, u_envLow, smoothstep(0.0, -0.4, h));
  float az = atan(d.z, d.x);
  float ring = pow(0.5 + 0.5 * cos(az * 24.0), 10.0) * smoothstep(-0.1, 0.25, h) * smoothstep(0.75, 0.25, h);
  return c + vec3(1.0, 0.62, 0.28) * ring * u_ring;
}
vec3 shadeMetal() {
  vec3 V = normalize(-v_pos);
  vec3 N = u_flat > 0.5 ? normalize(cross(dFdx(v_pos), dFdy(v_pos))) : normalize(v_nrm);
  if (dot(N, V) < 0.0) N = -N;
  vec3 Nw = normalize((x3d_CameraSpaceMatrix * vec4(N, 0.0)).xyz);
  vec3 Pw = (x3d_CameraSpaceMatrix * vec4(v_pos, 1.0)).xyz;
  float ndv = max(dot(N, V), 0.0);
  vec3 Rw = normalize((x3d_CameraSpaceMatrix * vec4(reflect(-V, N), 0.0)).xyz);
  float fres = 0.08 + 0.92 * pow(1.0 - ndv, 5.0);
  float streak = 1.0;
  if (u_brushed > 0.0) streak = 0.8 + 0.4 * vnoise(vec2(v_obj.x * 70.0, atan(v_obj.y, v_obj.z) * 45.0));
  vec3 albedo = u_vcol > 0.5 ? v_col.rgb * 2.0 : u_albedo;
  vec3 amb = vec3(0.035, 0.05, 0.10) * (0.6 + 0.4 * Nw.y) + vec3(0.05, 0.035, 0.02);
  vec3 key = vec3(1.0, 0.7, 0.42) * 0.22 * max(dot(Nw, normalize(vec3(-0.35, 0.55, 0.75))), 0.0);
  vec3 diff = albedo * (amb + key + lamps(Pw, Nw));
  vec3 spec = envOf(Rw) * u_tint * (u_gloss * (0.3 + 0.7 * fres)) * streak;
  return diff * (1.0 - 0.25 * u_gloss) + spec;
}

flat in vec4 v_glow;
flat in vec2 v_lit;
in float v_along;
out vec4 x3d_FragColor;
void main() {
  if (u_idpass > 0.5) { x3d_FragColor = vec4(v_lit.x > 0.5 ? idColor(v_lit.y) : vec3(0.0), 1.0); return; }
  float core = exp(-max(v_glow.z, 0.0) * 6.0) * v_glow.x * (1.0 - 0.8 * u_calm);
  vec3 hot = mix(vec3(1.0, 0.55, 0.2), vec3(1.0, 0.95, 0.8), clamp(core * 1.2, 0.0, 1.0));
  float tip = smoothstep(0.35, 1.0, v_along);
  vec3 col = shadeMetal() + hot * v_glow.x * (0.5 + 1.6 * tip) + hot * core * 1.2 * tip;
  x3d_FragColor = vec4(finish(col), 1.0);
}
]]></ShaderPart>
