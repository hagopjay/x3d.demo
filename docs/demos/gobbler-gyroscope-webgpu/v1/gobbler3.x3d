    <TimeSensor DEF="Sway" cycleInterval="32" loop="true" />
    <OrientationInterpolator DEF="SwayTurn" key="0 0.062 0.125 0.188 0.25 0.312 0.375 0.438 0.5 0.562 0.625 0.688 0.75 0.812 0.875 0.938 1" keyValue="0 1 0 0, 0.359 0.933 -0.014 0.086, 0.282 0.959 -0.021 0.154, 0.157 0.987 -0.015 0.196, 0 1 0 0.209, -0.157 0.987 0.015 0.196, -0.282 0.959 0.021 0.154, -0.359 0.933 0.014 0.086, 0 1 0 0, 0.359 -0.933 0.014 0.086, 0.282 -0.959 0.021 0.154, 0.157 -0.987 0.015 0.196, 0 -1 0 0.209, -0.157 -0.987 -0.015 0.196, -0.282 -0.959 -0.021 0.154, -0.359 -0.933 -0.014 0.086, 0 1 0 0" />
    <ROUTE fromNode="Sway" fromField="fraction_changed" toNode="SwayTurn" toField="set_fraction" />
    <ROUTE fromNode="SwayTurn" fromField="value_changed" toNode="Bird" toField="set_rotation" />

    
    <TimeSensor DEF="Blink" cycleInterval="7.3" loop="true" />
    <PositionInterpolator DEF="LidScale" key="0 0.955 0.97 0.985 1" keyValue="1 1 1, 1 1 1, 1 0.08 1, 1 1 1, 1 1 1" />
    <ROUTE fromNode="Blink" fromField="fraction_changed" toNode="LidScale" toField="set_fraction" />
    <ROUTE fromNode="LidScale" fromField="value_changed" toNode="Lid" toField="set_scale" />

    
    <TimeSensor DEF="Twinkle" cycleInterval="7" loop="true" />
    <ROUTE fromNode="Twinkle" fromField="elapsedTime" toNode="FacetShader" toField="time" />
    <ROUTE fromNode="Twinkle" fromField="elapsedTime" toNode="LineShader" toField="time" />
    <ROUTE fromNode="Twinkle" fromField="elapsedTime" toNode="PointShader" toField="time" />
    <ROUTE fromNode="Twinkle" fromField="elapsedTime" toNode="EyeShader" toField="time" />

    
    <TimeSensor DEF="Scan" cycleInterval="10" loop="true" />
    <ScalarInterpolator DEF="ScanSweep" key="0 0.5 1" keyValue="-4 -4 4.2" />
    <ROUTE fromNode="Scan" fromField="fraction_changed" toNode="ScanSweep" toField="set_fraction" />
    <ROUTE fromNode="ScanSweep" fromField="value_changed" toNode="FacetShader" toField="scan" />
    <ROUTE fromNode="ScanSweep" fromField="value_changed" toNode="LineShader" toField="scan" />

    
    <ScalarInterpolator DEF="Glow" key="0 1" keyValue="0 1" />
    <ROUTE fromNode="Glow" fromField="value_changed" toNode="FacetShader" toField="glow" />
    <ROUTE fromNode="Glow" fromField="value_changed" toNode="LineShader" toField="glow" />
    <ROUTE fromNode="Glow" fromField="value_changed" toNode="PointShader" toField="glow" />

    

    
    <TimeSensor DEF="Dissolve" cycleInterval="6.5" />
    <TimeSensor DEF="Intro" cycleInterval="4.4" />
    <ScalarInterpolator DEF="IntroPhase" key="0 0.3 1" keyValue="0.5 0.5 1" />
    <ScalarInterpolator DEF="Phase" key="0 1" keyValue="0 1" />
    <BooleanFilter DEF="WhileAssembling" />
    <ROUTE fromNode="Touch" fromField="touchTime" toNode="Dissolve" toField="set_startTime" />
    <ROUTE fromNode="Wide" fromField="bindTime" toNode="Intro" toField="set_startTime" />
    <ROUTE fromNode="Colossus" fromField="bindTime" toNode="Intro" toField="set_startTime" />
    <ROUTE fromNode="EyeToEye" fromField="bindTime" toNode="Intro" toField="set_startTime" />
    <ROUTE fromNode="Inside" fromField="bindTime" toNode="Intro" toField="set_startTime" />
    <ROUTE fromNode="Flywheel" fromField="bindTime" toNode="Intro" toField="set_startTime" />
    <ROUTE fromNode="Crown" fromField="bindTime" toNode="Intro" toField="set_startTime" />
    <ROUTE fromNode="Intro" fromField="isActive" toNode="WhileAssembling" toField="set_boolean" />
    <ROUTE fromNode="WhileAssembling" fromField="inputNegate" toNode="Touch" toField="set_enabled" />
    <ROUTE fromNode="Dissolve" fromField="fraction_changed" toNode="Phase" toField="set_fraction" />
    <ROUTE fromNode="Intro" fromField="fraction_changed" toNode="IntroPhase" toField="set_fraction" />
    <ROUTE fromNode="IntroPhase" fromField="value_changed" toNode="Phase" toField="set_fraction" />

    
    <ROUTE fromNode="Phase" fromField="value_changed" toNode="FacetShader" toField="phase" />
    <ROUTE fromNode="Phase" fromField="value_changed" toNode="LineShader" toField="phase" />
    <ROUTE fromNode="Phase" fromField="value_changed" toNode="PointShader" toField="phase" />
    <ROUTE fromNode="Phase" fromField="value_changed" toNode="EyeShader" toField="phase" />
    
    <BooleanSequencer DEF="EmberWindow" key="0 0.09 0.42" keyValue="false true false" />
    <ROUTE fromNode="Phase" fromField="value_changed" toNode="EmberWindow" toField="set_fraction" />
    <ROUTE fromNode="EmberWindow" fromField="value_changed" toNode="Embers" toField="set_createParticles" />
    <ROUTE fromNode="Dissolve" fromField="isActive" toNode="Embers" toField="set_enabled" />
    
    <ScalarInterpolator DEF="FacetFade" key="0 0.08 0.18 0.84 0.95 1" keyValue="0.75 0.75 1 1 0.75 0.75" />
    <ROUTE fromNode="Phase" fromField="value_changed" toNode="FacetFade" toField="set_fraction" />
